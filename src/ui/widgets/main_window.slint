// bundled monospace font: compiling this file embeds the font and registers
// the "JetBrains Mono" family globally, so the netlist editor and the output
// panel resolve identical glyph metrics on every platform (the netlist editor
// overlays its token layer on a TextInput's own text layout and depends on
// both engines agreeing on the same font)
import "./fonts/JetBrainsMono-Regular.ttf";
import { Palette } from "std-widgets.slint";
import { AddPlotPanel } from "../components/add_plot_panel.slint";
import { ChartsPanel, PlotTabItem, ChartFrameData } from "../components/charts_panel.slint";
import {
    BreadcrumbItem,
    ExpressionItem,
} from "../components/expression_selector.slint";
import { FftPanel } from "../components/fft_panel.slint";
import { PluginConfigPanel } from "../components/plugin_config_panel.slint";
import {
    NetlistEditor,
    HighlightedLine,
} from "../components/netlist_editor.slint";
import { StepItem, StepToolPanel } from "../components/step_tool_panel.slint";
import {
    SimulationOutputPanel,
} from "../components/simulation_output_panel.slint";
import {
    SimulationParametersPanel,
} from "../components/simulation_parameters_panel.slint";
import { DcSweepRow } from "../components/dc_parameters_panel.slint";
export {
    ChartsPanelActions,
    PlotTabItem,
}from "../components/charts_panel.slint";

export global MainWindowActions {
    callback open-xyce-file();
    callback save-netlist();
    callback show-netlist();
    callback show-charts();
    callback show-simulation-output();
    callback close-simulation-output();
    callback copy-simulation-output(start: int, end: int);
    callback run-simulation();
    callback stop-simulation();
    callback configure-simulation();
    callback configure-plugin();
    callback netlist-edited();
    callback exit();
}

// Hairline group separator — 8 px gap + 1 px line + 8 px gap
component ToolbarSeparator inherits Rectangle {
    width: 17px;
    height: 20px;

    Rectangle {
        x: (parent.width - 1px) / 2;
        width: 1px;
        height: 100%;
        background: Palette.foreground.transparentize(0.82);
    }
}

// Icon-only square button; `text` is reserved for a future tooltip
component ToolbarButton inherits Rectangle {
    in property <image> icon;
    in property <string> text;           // tooltip label (future use)
    in property <length> icon-size: 20px;
    in property <bool> enabled: true;
    in property <bool> accent: false;    // true on the primary action (Run)
    in property <color> accent-color: #3dd6b5;
    callback clicked;

    // min-width == max-width gives a fixed 40 px square without locking the
    // HorizontalLayout's own max-width (unlike an explicit `width:` binding,
    // which propagates a hard constraint all the way up to the Window).
    min-width: 40px;
    max-width: 40px;
    height: 40px;
    border-radius: 6px;

    background: !root.enabled
        ? transparent
        : ta.pressed
        ? (root.accent
        ? root.accent-color.transparentize(0.55)
        : Palette.foreground.transparentize(0.82))
        : ta.has-hover
        ? (root.accent
        ? root.accent-color.transparentize(0.72)
        : Palette.foreground.transparentize(0.92))
        : transparent;
    animate background {
        duration: 100ms;
        easing: ease-out;
    }

    Image {
        x: (parent.width - root.icon-size) / 2;
        y: (parent.height - root.icon-size) / 2;
        width: root.icon-size;
        height: root.icon-size;
        source: root.icon;
        image-fit: contain;
        // KiCad icons are full-colour opaque PNGs; `colorize` would paint them
        // as a solid block. Use opacity instead: full opacity when enabled,
        // dimmed when disabled. The accent tint comes from the background only.
        opacity: root.enabled ? 1.0 : 0.4;
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// bottom simulation log. the panel lives in
// ../components/simulation_output_panel.slint: a header row with a title and
// a close button over a monospaced, virtualized list of log lines. a ListView
// (instead of a single TextEdit) keeps scrolling fast for long logs and
// appending a line cheap: only the visible rows are rendered


export component MainWindow inherits Window {
    title: root.window-title;
    preferred-width: 900px;
    preferred-height: 360px;

    // enforce a minimum window size that accommodates the largest inline
    // overlay panel (SimulationParametersPanel card is 820x600,
    // AddPlotPanel card is 600x560) plus window chrome (toolbar ~56px,
    // statusbar ~24px = ~80px) so the dialog appears on top of the window
    // rather than filling it edge-to-edge. the other inline overlays
    // (PluginConfigPanel 540x216) are smaller and thus always fit within
    // this minimum
    min-width: 820px;
    min-height: 680px;

    // runtime window title, driven from the view adapter (dirty marker prefix,
    // netlist/raw file names); the default shows until a file is opened
    in property <string> window-title: "Xyce Studio";

    // status bar text, driven from the view adapter
    in property <string> status-text: "";

    // theme detection
    in property <bool> is-dark: Palette.color-scheme == ColorScheme.dark;
    // theme foreground colour, read by the view so netlist token colours for
    // nodes and plain text follow the active palette
    out property <color> editor-foreground: Palette.foreground;
    callback theme-changed(bool);

    init => { root.theme-changed(root.is-dark); }
    changed is-dark => { root.theme-changed(root.is-dark); }

    // fires when the charts panel geometry changes, so the host renderer
    // can resize its offscreen surface and recompute limits; forwarded
    // from the ChartsPanel viewport-changed callback
    callback charts-viewport-changed(width: float, height: float);

    // the rendered chart frame published by the host renderer
    in property <image> charts-image;

    // slint native chart frames, forwarded to the ChartsPanel component
    in property <[ChartFrameData]> native-charts;

    // charts panel action availability, forwarded to the ChartsPanel component
    in property <bool> enable-fft: false;
    in property <bool> enable-step-tool: false;

    // plot tabs, forwarded to the ChartsPanel component
    in property <[PlotTabItem]> plot-tabs: [];
    in-out property <int> active-plot-tab: 0;
    callback plot-tab-selected(int);
    callback plot-tab-closed(int);

    // simulation actions are enabled only when a netlist is loaded (or the app
    // is connected to KiCad); driven from apply_action_enablement
    in property <bool> enable-run-simulation: false;
    in property <bool> enable-configure-simulation: false;

    // a simulation is running: the Run toolbar action is replaced by Stop
    in property <bool> simulation-running: false;

    // content-view switching actions; also driven from apply_action_enablement
    in property <bool> enable-show-netlist: false;
    in property <bool> enable-show-charts: false;
    in property <bool> enable-show-sim-output: false;

    // file actions; driven from apply_action_enablement
    in property <bool> enable-open: false;
    in property <bool> enable-save: false;

    // the charts panel is hidden by default and appears when the charts view
    // is shown (controlled from the view adapter)
    in property <bool> charts-visible: false;

    // netlist editor state, driven from the view adapter; the netlist text is
    // read back from the widget, so the property is also the source of truth
    // for the presenter when tracking user edits
    in-out property <string> netlist-text: "";
    in property <bool> netlist-read-only: false;
    // syntax-highlighted lines model; populated by the C++ adapter after each netlist load
    in-out property <[HighlightedLine]> netlist-highlighted-lines: [];

    // bottom simulation output panel; shown while a simulation runs (or its log
    // holds content), the log is a list of lines model-driven from the view
    in property <bool> simulation-output-visible: false;
    in property <[string]> simulation-output-log;

    // a modal dialog is open, the window dims and must not accept input; the
    // slint dialog is a separate native window, so the OS window input block
    // (per-platform helper) is what actually enforces modality
    in property <bool> modal-active: false;

    // plugin configuration panel rendered inline as a modal overlay (no
    // separate OS window); driven from the view adapter
    in property <bool> plugin-config-visible: false;
    in-out property <string> plugin-config-xyce-path: "";
    in property <bool> plugin-config-show-error: false;
    in property <string> plugin-config-error-message: "";
    in property <bool> plugin-config-browse-enabled: true;

    // forwarded from the inline plugin config panel to the view adapter
    callback plugin-config-accepted();
    callback plugin-config-dismissed();
    callback plugin-config-browse-clicked();
    callback plugin-config-path-edited(string);

    // add plot expression panel rendered inline as a modal overlay (no separate
    // OS window); driven from the view adapter
    in property <bool> add-plot-visible: false;
    in property <[ExpressionItem]> add-plot-expressions: [];
    in property <[BreadcrumbItem]> add-plot-breadcrumb: [];
    in property <bool> add-plot-show-selected: false;
    in-out property <string> add-plot-filter-text: "";
    in-out property <string> add-plot-custom-text: "";
    in property <bool> add-plot-allow-custom-expressions: true;
    in property <bool> add-plot-show-error: false;

    // forwarded from the inline add plot panel to the view adapter
    callback add-plot-accepted();
    callback add-plot-dismissed();
    callback add-plot-expression-clicked(int);
    callback add-plot-expression-right-clicked(int);
    callback add-plot-breadcrumb-clicked(int);
    callback add-plot-selected-link-clicked();
    callback add-plot-filter-changed(string);
    callback add-plot-custom-add();

    // simulation parameters panel rendered inline as a modal overlay (no
    // separate OS window); driven from the view adapter
    in property <bool> simulation-parameters-visible: false;

    // forwarded from the inline simulation parameters panel to the view adapter
    callback simulation-parameters-accepted();
    callback simulation-parameters-dismissed();

    // analysis tab selected in the tabbed parameter panel
    in-out property <int> simulation-parameters-selected-tab: 0;
    in property <bool> simulation-parameters-show-error: false;
    in property <string> simulation-parameters-error-message: "";

    // FFT setup panel rendered inline as a modal overlay (no separate OS
    // window); driven from the view adapter
    in property <bool> fft-panel-visible: false;
    in-out property <int> fft-range-mode: 0;
    in-out property <string> fft-custom-from: "";
    in-out property <string> fft-custom-to: "";
    in-out property <int> fft-window-index: 2;
    in-out property <int> fft-format-index: 0;
    in-out property <int> fft-output-index: 0;
    in-out property <bool> fft-keep-dc: true;
    in-out property <int> fft-np-index: 2;
    in-out property <string> fft-custom-np: "";
    in property <[ExpressionItem]> fft-expressions: [];
    in property <[BreadcrumbItem]> fft-breadcrumb: [];
    in property <bool> fft-show-selected: false;
    in-out property <string> fft-filter-text: "";
    in property <bool> fft-show-error: false;
    in property <string> fft-error-message: "";

    // forwarded from the inline FFT panel to the view adapter
    callback fft-accepted();
    callback fft-dismissed();
    callback fft-expression-clicked(int);
    callback fft-breadcrumb-clicked(int);
    callback fft-selected-link-clicked();
    callback fft-filter-changed(string);

    // step tool panel rendered inline as a modal overlay (no separate OS
    // window); driven from the view adapter
    in property <bool> step-tool-panel-visible: false;
    in property <[StepItem]> step-tool-steps: [];
    in property <[string]> step-tool-keys: [];
    in property <string> step-tool-selection-count: "";

    // forwarded from the inline step tool panel to the view adapter
    callback step-tool-accepted();
    callback step-tool-dismissed();
    callback step-tool-select-all();
    callback step-tool-clear-all();
    callback step-tool-invert-selection();
    callback step-tool-step-toggled(int);

    in-out property <bool> op-print-enabled: false;
    in-out property <bool> op-print-all-nodes: false;
    in-out property <bool> op-print-all-currents: false;
    in-out property <bool> op-print-power: false;
    in-out property <bool> op-print-bjt-leads: false;
    in-out property <bool> op-print-fet-leads: false;
    in-out property <string> op-print-specific-variables: "";
    in-out property <int> op-print-format-index: 0;
    in-out property <string> op-print-output-file: "";
    in-out property <string> op-print-extra-options: "";
    in-out property <bool> op-save-enabled: false;
    in-out property <int> op-save-type-index: 0;
    in-out property <string> op-save-file: "";
    in-out property <int> op-save-level-index: 0;
    in-out property <string> op-nodeset: "";
    in-out property <string> op-initial-conditions: "";
    in-out property <bool> op-replace-ground: true;

    in-out property <int> ac-sweep-mode-index: 0;
    in-out property <string> ac-points: "";
    in-out property <string> ac-start: "";
    in-out property <string> ac-end: "";
    in-out property <string> ac-data-table: "";
    in-out property <string> ac-measure: "";
    in-out property <bool> ac-print-enabled: false;
    in-out property <int> ac-print-type-index: 0;
    in-out property <bool> ac-print-all-nodes: false;
    in-out property <bool> ac-print-all-currents: false;
    in-out property <bool> ac-print-bjt-leads: false;
    in-out property <bool> ac-print-fet-leads: false;
    in-out property <string> ac-print-specific-variables: "";
    in-out property <int> ac-print-format-index: 0;
    in-out property <string> ac-print-output-file: "";
    in-out property <string> ac-print-extra-options: "";
    in-out property <bool> ac-replace-ground: true;

    in-out property <string> tran-initial-step: "";
    in-out property <string> tran-final-time: "";
    in-out property <string> tran-start-time: "";
    in-out property <string> tran-step-ceiling: "";
    in-out property <int> tran-op-keyword-index: 0;
    in-out property <string> tran-schedule: "";
    in-out property <string> tran-fft: "";
    in-out property <string> tran-four: "";
    in-out property <string> tran-measure: "";
    in-out property <bool> tran-print-enabled: false;
    in-out property <int> tran-print-type-index: 0;
    in-out property <bool> tran-print-all-nodes: false;
    in-out property <bool> tran-print-all-currents: false;
    in-out property <bool> tran-print-power: false;
    in-out property <bool> tran-print-bjt-leads: false;
    in-out property <bool> tran-print-fet-leads: false;
    in-out property <string> tran-print-specific-variables: "";
    in-out property <int> tran-print-format-index: 0;
    in-out property <string> tran-print-output-file: "";
    in-out property <string> tran-print-extra-options: "";
    in-out property <bool> tran-replace-ground: true;

    in-out property <int> dc-sweep-mode-index: 0;
    // nested sweep rows — projected from DCSimulationParameters::sweeps by C++
    in-out property <[DcSweepRow]> dc-sweeps: [];
    // forwarded DcParametersPanel sweep table actions
    callback dc-add-sweep();
    callback dc-remove-sweep(int);
    callback dc-sweep-row-updated(int, DcSweepRow);
    in-out property <string> dc-data-table: "";
    in-out property <string> dc-measure: "";
    in-out property <bool> dc-print-enabled: false;
    in-out property <int> dc-print-type-index: 0;
    in-out property <bool> dc-print-all-nodes: false;
    in-out property <bool> dc-print-all-currents: false;
    in-out property <bool> dc-print-power: false;
    in-out property <bool> dc-print-bjt-leads: false;
    in-out property <bool> dc-print-fet-leads: false;
    in-out property <string> dc-print-specific-variables: "";
    in-out property <int> dc-print-format-index: 0;
    in-out property <string> dc-print-output-file: "";
    in-out property <string> dc-print-extra-options: "";
    in-out property <bool> dc-replace-ground: true;

    in-out property <string> noise-output-node: "";
    in-out property <string> noise-ref-node: "";
    in-out property <string> noise-source-name: "";
    in-out property <string> noise-start-freq: "";
    in-out property <string> noise-end-freq: "";
    in-out property <string> noise-num-points: "";
    in-out property <int> noise-sweep-type-index: 0;
    in-out property <string> noise-data-table: "";
    in-out property <string> noise-device-noise: "";
    in-out property <bool> noise-print-enabled: false;
    in-out property <int> noise-print-type-index: 0;
    in-out property <bool> noise-print-all-nodes: false;
    in-out property <bool> noise-print-all-currents: false;
    in-out property <bool> noise-print-bjt-leads: false;
    in-out property <bool> noise-print-fet-leads: false;
    in-out property <string> noise-print-specific-variables: "";
    in-out property <int> noise-print-format-index: 0;
    in-out property <string> noise-print-output-file: "";
    in-out property <string> noise-print-extra-options: "";
    in-out property <bool> noise-replace-ground: true;

    in-out property <string> hb-frequencies: "";
    in-out property <string> hb-harmonics: "";
    in-out property <string> hb-tahb: "";
    in-out property <string> hb-selectharms: "";
    in-out property <string> hb-startup-periods: "";
    in-out property <string> hb-nonlin-options: "";
    in-out property <string> hb-linsol-options: "";
    in-out property <bool> hb-print-enabled: false;
    in-out property <int> hb-print-type-index: 0;
    in-out property <bool> hb-print-all-nodes: false;
    in-out property <bool> hb-print-all-currents: false;
    in-out property <string> hb-print-specific-variables: "";
    in-out property <int> hb-print-format-index: 0;
    in-out property <string> hb-print-output-file: "";
    in-out property <string> hb-print-extra-options: "";
    in-out property <bool> hb-replace-ground: true;

    in-out property <bool> lin-sparcalc: false;
    in-out property <int> lin-format-index: 0;
    in-out property <int> lin-lintype-index: 0;
    in-out property <int> lin-dataformat-index: 0;
    in-out property <string> lin-file: "";
    in-out property <string> lin-output-width: "";
    in-out property <string> lin-precision: "";
    in-out property <int> lin-sweep-mode-index: 0;
    in-out property <string> lin-points: "";
    in-out property <string> lin-start: "";
    in-out property <string> lin-end: "";
    in-out property <string> lin-data-table: "";
    in-out property <bool> lin-print-enabled: false;
    in-out property <int> lin-print-type-index: 0;
    in-out property <bool> lin-print-all-nodes: false;
    in-out property <bool> lin-print-all-currents: false;
    in-out property <bool> lin-print-power: false;
    in-out property <bool> lin-print-bjt-leads: false;
    in-out property <bool> lin-print-fet-leads: false;
    in-out property <string> lin-print-specific-variables: "";
    in-out property <int> lin-print-format-index: 0;
    in-out property <string> lin-print-output-file: "";
    in-out property <string> lin-print-extra-options: "";
    in-out property <bool> lin-replace-ground: true;

    background: root.modal-active ? Palette.background.transparentize(0.35) : Palette.background;

    // a plain Rectangle wraps the layout and the overlay so the panel can be
    // absolutely positioned on top of the main content without the layout
    // manager fighting over the overlay's coordinates (a Window whose first
    // child is a layout would otherwise try to manage every child)
    Rectangle {
        VerticalLayout {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            toolbar := Rectangle {
                background: Palette.background;

                VerticalLayout {
                    HorizontalLayout {
                        cross-axis-alignment: center;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 2px;

                        // group 1: file (standalone mode only)
                    ToolbarButton {
                            text: "Open";
                            icon: @image-url("../kicad-icons/directory_open_48.png");
                            enabled: root.enable-open;
                            clicked => { MainWindowActions.open-xyce-file(); }
                        }

                        ToolbarButton {
                            text: "Save";
                            icon: @image-url("../kicad-icons/save_48.png");
                            enabled: root.enable-save;
                            clicked => { MainWindowActions.save-netlist(); }
                        }

                        ToolbarSeparator { }

                        // group 2: content views
                    ToolbarButton {
                            text: "Netlist";
                            icon: @image-url("../kicad-icons/netlist_48.png");
                            enabled: root.enable-show-netlist;
                            clicked => { MainWindowActions.show-netlist(); }
                        }

                        ToolbarButton {
                            text: "Charts";
                            icon: @image-url("../kicad-icons/simulator_48.png");
                            enabled: root.enable-show-charts;
                            clicked => { MainWindowActions.show-charts(); }
                        }

                        ToolbarButton {
                            text: "Sim Output";
                            icon: @image-url("../kicad-icons/sim_command_48.png");
                            enabled: root.enable-show-sim-output;
                            clicked => { MainWindowActions.show-simulation-output(); }
                        }

                        ToolbarSeparator { }

                        // group 3: simulation; while a simulation runs the Run
                    // action is replaced by Stop so the process can be canceled
                    if !root.simulation-running: ToolbarButton {
                            text: "Run Simulation";
                            icon: @image-url("../kicad-icons/sim_run_48.png");
                            enabled: root.enable-run-simulation;
                            accent: true;
                            clicked => { MainWindowActions.run-simulation(); }
                        }
                        if root.simulation-running: ToolbarButton {
                            text: "Stop Simulation";
                            icon: @image-url("../kicad-icons/cancel_48.png");
                            enabled: true;
                            accent: true;
                            accent-color: #e05b4b;
                            clicked => { MainWindowActions.stop-simulation(); }
                        }
                        ToolbarButton {
                            text: "Configure";
                            icon: @image-url("../kicad-icons/sim_tune_48.png");
                            enabled: root.enable-configure-simulation;
                            clicked => { MainWindowActions.configure-simulation(); }
                        }

                        ToolbarSeparator { }

                        // group 4: plugin configuration
                    ToolbarButton {
                            text: "Plugin Settings";
                            icon: @image-url("../kicad-icons/preference_48.png");
                            clicked => { MainWindowActions.configure-plugin(); }
                        }

                        ToolbarSeparator { }

                        // group 5: exit
                    ToolbarButton {
                            text: "Exit";
                            icon: @image-url("../kicad-icons/exit_48.png");
                            clicked => { MainWindowActions.exit(); }
                        }

                        // absorbs remaining space so the HorizontalLayout can grow
                    // with the window and doesn't impose a hard max-width
                    Rectangle {
                            horizontal-stretch: 1;
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Palette.border;
                    }
                }
            }

            // body: the body container owns the exclusive content views, the
        // schematic panel is shown by default and the charts panel replaces
        // it once the charts view is shown
        body := Rectangle {
                vertical-stretch: 1;
                background: Palette.alternate-background;

                VerticalLayout {
                    if !root.charts-visible: schematic := NetlistEditor {
                        vertical-stretch: 1;
                        text <=> root.netlist-text;
                        read-only: root.netlist-read-only;
                        lines-model <=> root.netlist-highlighted-lines;
                        edited => { MainWindowActions.netlist-edited(); }
                    }
                    if root.charts-visible: charts := ChartsPanel {
                        vertical-stretch: 1;
                        plot-tabs: root.plot-tabs;
                        active-plot-tab <=> root.active-plot-tab;
                        plot-tab-selected(index) => { root.plot-tab-selected(index); }
                        plot-tab-closed(index) => { root.plot-tab-closed(index); }
                        enable-fft: root.enable-fft;
                        enable-step-tool: root.enable-step-tool;
                        // forward the rendered chart image from the host renderer
                        charts-image: root.charts-image;
                        // forward the slint native chart frames from the host
                        native-charts: root.native-charts;
                        // report layout changes to the renderer
                        viewport-changed(width, height) => { root.charts-viewport-changed(width, height); }
                    }
                    if root.simulation-output-visible: output := SimulationOutputPanel {
                        height: 200px;
                        log-lines: root.simulation-output-log;
                        close => { MainWindowActions.close-simulation-output(); }
                        copy-requested(start, end) => {
                            MainWindowActions.copy-simulation-output(start, end);
                        }
                    }
                }
            }

            // status bar at the bottom of the window
        statusbar := Rectangle {
                height: 24px;
                background: Palette.background;

                VerticalLayout {
                    Rectangle {
                        height: 1px;
                        background: Palette.border;
                    }

                    HorizontalLayout {
                        cross-axis-alignment: center;

                        Rectangle {
                            width: 12px;
                        }

                        Text {
                            text: root.status-text;
                            font-size: 12px;
                            color: Palette.foreground;
                            horizontal-alignment: left;
                        }
                    }
                }
            }
        }

        // plugin configuration panel rendered as an inline modal overlay: a
    // dimmed backdrop covers the whole window and a centered card holds the
    // form. because it is a child of the Window (not a separate Dialog) there
    // is no second OS window and no modal_manager input blocking is needed;
    // the guard_modal gate and the backdrop's pointer absorption enforce
    // modality within the single window.
    if root.plugin-config-visible: plugin-config := PluginConfigPanel {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            xyce-path <=> root.plugin-config-xyce-path;
            show-error: root.plugin-config-show-error;
            error-message: root.plugin-config-error-message;
            browse-enabled: root.plugin-config-browse-enabled;
            accepted => { root.plugin-config-accepted(); }
            dismissed => { root.plugin-config-dismissed(); }
            browse-clicked => { root.plugin-config-browse-clicked(); }
            path-edited(text) => { root.plugin-config-path-edited(text); }
        }

        // add plot expression panel rendered as an inline modal overlay: a dimmed
    // backdrop covers the whole window and a centered card holds the expression
    // selector. because it is a child of the Window (not a separate Dialog) there
    // is no second OS window and no modal_manager input blocking is needed;
    // the guard_modal gate and the backdrop's pointer absorption enforce
    // modality within the single window.
    if root.add-plot-visible: AddPlotPanel {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            expressions: root.add-plot-expressions;
            breadcrumb: root.add-plot-breadcrumb;
            show-selected: root.add-plot-show-selected;
            filter-text <=> root.add-plot-filter-text;
            custom-text <=> root.add-plot-custom-text;
            allow-custom-expressions: root.add-plot-allow-custom-expressions;
            show-error: root.add-plot-show-error;
            error-message: "Invalid expression";
            accepted => { root.add-plot-accepted(); }
            dismissed => { root.add-plot-dismissed(); }
            expression-clicked(index) => { root.add-plot-expression-clicked(index); }
            expression-right-clicked(index) => { root.add-plot-expression-right-clicked(index); }
            breadcrumb-clicked(level) => { root.add-plot-breadcrumb-clicked(level); }
            selected-link-clicked => { root.add-plot-selected-link-clicked(); }
            filter-changed(query) => { root.add-plot-filter-changed(query); }
            custom-add => { root.add-plot-custom-add(); }
        }

        if root.simulation-parameters-visible: SimulationParametersPanel {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            selected-tab <=> root.simulation-parameters-selected-tab;
            show-error: root.simulation-parameters-show-error;
            error-message: root.simulation-parameters-error-message;
            accepted => { root.simulation-parameters-accepted(); }
            dismissed => { root.simulation-parameters-dismissed(); }
            op-print-enabled <=> root.op-print-enabled;
            op-print-all-nodes <=> root.op-print-all-nodes;
            op-print-all-currents <=> root.op-print-all-currents;
            op-print-power <=> root.op-print-power;
            op-print-bjt-leads <=> root.op-print-bjt-leads;
            op-print-fet-leads <=> root.op-print-fet-leads;
            op-print-specific-variables <=> root.op-print-specific-variables;
            op-print-format-index <=> root.op-print-format-index;
            op-print-output-file <=> root.op-print-output-file;
            op-print-extra-options <=> root.op-print-extra-options;
            op-save-enabled <=> root.op-save-enabled;
            op-save-type-index <=> root.op-save-type-index;
            op-save-file <=> root.op-save-file;
            op-save-level-index <=> root.op-save-level-index;
            op-nodeset <=> root.op-nodeset;
            op-initial-conditions <=> root.op-initial-conditions;
            op-replace-ground <=> root.op-replace-ground;
            ac-sweep-mode-index <=> root.ac-sweep-mode-index;
            ac-points <=> root.ac-points;
            ac-start <=> root.ac-start;
            ac-end <=> root.ac-end;
            ac-data-table <=> root.ac-data-table;
            ac-measure <=> root.ac-measure;
            ac-print-enabled <=> root.ac-print-enabled;
            ac-print-type-index <=> root.ac-print-type-index;
            ac-print-all-nodes <=> root.ac-print-all-nodes;
            ac-print-all-currents <=> root.ac-print-all-currents;
            ac-print-bjt-leads <=> root.ac-print-bjt-leads;
            ac-print-fet-leads <=> root.ac-print-fet-leads;
            ac-print-specific-variables <=> root.ac-print-specific-variables;
            ac-print-format-index <=> root.ac-print-format-index;
            ac-print-output-file <=> root.ac-print-output-file;
            ac-print-extra-options <=> root.ac-print-extra-options;
            ac-replace-ground <=> root.ac-replace-ground;
            tran-initial-step <=> root.tran-initial-step;
            tran-final-time <=> root.tran-final-time;
            tran-start-time <=> root.tran-start-time;
            tran-step-ceiling <=> root.tran-step-ceiling;
            tran-op-keyword-index <=> root.tran-op-keyword-index;
            tran-schedule <=> root.tran-schedule;
            tran-fft <=> root.tran-fft;
            tran-four <=> root.tran-four;
            tran-measure <=> root.tran-measure;
            tran-print-enabled <=> root.tran-print-enabled;
            tran-print-type-index <=> root.tran-print-type-index;
            tran-print-all-nodes <=> root.tran-print-all-nodes;
            tran-print-all-currents <=> root.tran-print-all-currents;
            tran-print-power <=> root.tran-print-power;
            tran-print-bjt-leads <=> root.tran-print-bjt-leads;
            tran-print-fet-leads <=> root.tran-print-fet-leads;
            tran-print-specific-variables <=> root.tran-print-specific-variables;
            tran-print-format-index <=> root.tran-print-format-index;
            tran-print-output-file <=> root.tran-print-output-file;
            tran-print-extra-options <=> root.tran-print-extra-options;
            tran-replace-ground <=> root.tran-replace-ground;
            dc-sweep-mode-index <=> root.dc-sweep-mode-index;
            dc-sweeps <=> root.dc-sweeps;
            dc-data-table <=> root.dc-data-table;
            dc-add-sweep => { root.dc-add-sweep(); }
            dc-remove-sweep(index) => { root.dc-remove-sweep(index); }
            dc-sweep-row-updated(index, row) => { root.dc-sweep-row-updated(index, row); }
            dc-measure <=> root.dc-measure;
            dc-print-enabled <=> root.dc-print-enabled;
            dc-print-type-index <=> root.dc-print-type-index;
            dc-print-all-nodes <=> root.dc-print-all-nodes;
            dc-print-all-currents <=> root.dc-print-all-currents;
            dc-print-power <=> root.dc-print-power;
            dc-print-bjt-leads <=> root.dc-print-bjt-leads;
