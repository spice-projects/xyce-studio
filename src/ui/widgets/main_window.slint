// bundled monospace font: compiling this file embeds the font and registers
// the "JetBrains Mono" family globally, so the netlist editor and the output
// panel resolve identical glyph metrics on every platform (the netlist editor
// overlays its token layer on a TextInput's own text layout and depends on
// both engines agreeing on the same font)
import "./fonts/JetBrainsMono-Regular.ttf";
import { Palette } from "std-widgets.slint";
import { AddPlotPanel } from "../components/add_plot_panel.slint";
import {
    ChartsPanel,
    PlotTabItem,
    ChartFrameData,
} from "../components/charts_panel.slint";
import {
    BreadcrumbItem,
    ExpressionItem,
    LegendItem,
} from "../components/expression_selector.slint";
import { FftPanel } from "../components/fft_panel.slint";
import { PluginConfigPanel } from "../components/plugin_config_panel.slint";
import { OptionRow } from "../components/option_package_card.slint";
import { OptionsPanel } from "../components/options_panel.slint";
import {
    NetlistEditor,
    HighlightedLine,
} from "../components/netlist_editor.slint";
import { StepItem, StepToolPanel } from "../components/step_tool_panel.slint";
import {
    LogLine,
    SimulationOutputPanel,
} from "../components/simulation_output_panel.slint";
import {
    SimulationParametersPanel,
} from "../components/simulation_parameters_panel.slint";
import { DcSweepRow } from "../components/dc_parameters_panel.slint";
import { PceParamRow } from "../components/pce_parameters_panel.slint";
export {
    ChartsPanelActions,
    PlotTabItem,
} from "../components/charts_panel.slint";

export global MainWindowActions {
    callback open-xyce-file();
    callback save-netlist();
    callback prime-save-as-path(path: string);
    callback show-netlist();
    callback show-charts();
    callback show-simulation-output();
    callback close-simulation-output();
    callback copy-simulation-output(start: int, end: int);
    callback open-simulation-output-from-status();
    callback run-simulation();
    callback stop-simulation();
    callback configure-simulation();
    callback edit-options();
    callback configure-plugin();
    callback netlist-edited();
    callback exit();
}

// Hairline group separator — 8 px gap + 1 px line + 8 px gap
component ToolbarSeparator inherits Rectangle {
    width: 17px;
    height: 20px;

    Rectangle {
        x: (parent.width - 1px) / 2;
        width: 1px;
        height: 100%;
        background: Palette.foreground.transparentize(0.82);
    }
}

// Icon-only square button; `text` is reserved for a future tooltip
component ToolbarButton inherits Rectangle {
    in property <image> icon;
    in property <string> text;           // tooltip label (future use)
    in property <length> icon-size: 20px;
    in property <bool> enabled: true;
    in property <bool> accent: false;    // true on the primary action (Run)
    in property <color> accent-color: #3dd6b5;
    callback clicked;

    // min-width == max-width gives a fixed 40 px square without locking the
    // HorizontalLayout's own max-width (unlike an explicit `width:` binding,
    // which propagates a hard constraint all the way up to the Window).
    min-width: 40px;
    max-width: 40px;
    height: 40px;
    border-radius: 6px;

    background: !root.enabled
        ? transparent
        : ta.pressed
        ? (root.accent
        ? root.accent-color.transparentize(0.55)
        : Palette.foreground.transparentize(0.82))
        : ta.has-hover
        ? (root.accent
        ? root.accent-color.transparentize(0.72)
        : Palette.foreground.transparentize(0.92))
        : transparent;
    animate background {
        duration: 100ms;
        easing: ease-out;
    }

    Image {
        x: (parent.width - root.icon-size) / 2;
        y: (parent.height - root.icon-size) / 2;
        width: root.icon-size;
        height: root.icon-size;
        source: root.icon;
        image-fit: contain;
        // KiCad icons are full-colour opaque PNGs; `colorize` would paint them
        // as a solid block. Use opacity instead: full opacity when enabled,
        // dimmed when disabled. The accent tint comes from the background only.
        opacity: root.enabled ? 1.0 : 0.4;
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// bottom simulation log. the panel lives in
// ../components/simulation_output_panel.slint: a header row with a title and
// a close button over a monospaced, virtualized list of log lines. a ListView
// (instead of a single TextEdit) keeps scrolling fast for long logs and
// appending a line cheap: only the visible rows are rendered


// live run progress shown in the statusbar while a simulation is running: a
// determinate bar once Xyce reported a completion percentage, an indeterminate
// sweep for the analyses it reports no progress for, followed by the phase,
// the warning and error counts.  a click anywhere on the statusbar opens the
// simulation output panel, so the whole strip stays a shortcut to the log
component RunProgress inherits Rectangle {
    // completion percentage in the 0..100 range, negative for a run Xyce reports no progress for
    in property <float> percentage: -1;
    // estimated time to completion exactly as Xyce spelled it, empty until it reported one
    in property <string> eta: "";
    // analysis phase Xyce announced last, empty until it announced one
    in property <string> phase: "";
    in property <int> warning-count: 0;
    in property <int> error-count: 0;

    // width of the bar; the strip is the last item of the statusbar layout, so it takes only what it needs.
    // the indicator is sized by its content and centered by the statusbar row, which keeps the row from
    // collapsing onto the height of this strip
    horizontal-stretch: 0;

    // seconds elapsed since the indeterminate run started; a determinate run reports the percentage and the estimate Xyce computed instead
    private property <int> elapsed-seconds: 0;
    // position of the indeterminate sweep, advanced by the timer below
    private property <int> sweep-phase: 0;

    // the sweep travels across the bar in 40 steps and restarts, which reads as a moving highlight without a spinner glyph
    private property <float> bar-width: 120;
    private property <float> sweep-position: root.sweep-phase * root.bar-width / 40;

    // advance the sweep four times a second while a run is in flight but Xyce reports no
    // percentage, so it reads as a moving highlight
    Timer {
        interval: 250ms;
        running: root.percentage < 0;
        triggered => {
            root.sweep-phase = Math.mod(root.sweep-phase + 1, 40);
        }
    }

    // count the elapsed seconds once a second, on their own timer so the sweep cadence
    // cannot stretch the reported time
    Timer {
        interval: 1s;
        running: root.percentage < 0;
        triggered => {
            root.elapsed-seconds = root.elapsed-seconds + 1;
        }
    }

    // drop the counters as soon as the run reports a percentage, they are not shown then
    changed percentage => {
        if (root.percentage >= 0) {
            root.elapsed-seconds = 0;
            root.sweep-phase = 0;
        }
    }

    HorizontalLayout {
        cross-axis-alignment: center;
        spacing: 8px;

        Rectangle {
            width: root.bar-width * 1px;
            height: 3px;
            border-radius: 2px;
            background: Palette.foreground.with-alpha(0.14);
            // the sweep travels a full track width, so the part that runs past the right edge must be
            // cut off instead of painted over the spacing and the progress text
            clip: true;

            // the filled part spans the reported percentage, or a third of the bar travelling across it while the percentage is unknown
            run-progress-fill := Rectangle {
                x: (root.percentage >= 0 ? 0 : root.sweep-position) * 1px;
                width: (root.percentage >= 0 ? root.bar-width * root.percentage / 100 : root.bar-width / 3) * 1px;
                height: 100%;
                border-radius: 2px;
                background: Palette.accent-background;
                animate x {
                    duration: 250ms;
                    easing: ease-out;
                }
                animate width {
                    duration: 250ms;
                    easing: ease-out;
                }
            }
        }

        // carries an element id so the automation can read the reported progress as text
        run-progress-percentage := Text {
            text: root.percentage >= 0
                ? (root.eta != "" ? Math.round(root.percentage) + "% · ETA " + root.eta : Math.round(root.percentage) + "%")
                : (root.phase != "" ? root.elapsed-seconds + "s · " + root.phase : root.elapsed-seconds + "s elapsed");
            font-size: 12px;
            color: Palette.foreground;
            horizontal-alignment: left;
            vertical-alignment: center;
        }

        run-progress-warnings := Text {
            text: root.warning-count > 0 ? root.warning-count + " warnings" : "";
            font-size: 12px;
            color: #d9a441;
            horizontal-alignment: left;
            vertical-alignment: center;
        }

        run-progress-errors := Text {
            text: root.error-count > 0 ? root.error-count + " errors" : "";
            font-size: 12px;
            color: #e05b4b;
            horizontal-alignment: left;
            vertical-alignment: center;
        }
    }
}

export component MainWindow inherits Window {
    title: root.window-title;
    preferred-width: 900px;
    preferred-height: 360px;

    // enforce a minimum window size that accommodates the largest inline
    // overlay panel (SimulationParametersPanel card is 820x600,
    // AddPlotPanel card is 600x560) plus window chrome (toolbar ~56px,
    // statusbar ~24px = ~80px) so the dialog appears on top of the window
    // rather than filling it edge-to-edge. the other inline overlays
    // (PluginConfigPanel 540x216) are smaller and thus always fit within
    // this minimum
    min-width: 820px;
    min-height: 680px;

    // runtime window title, driven from the view adapter (dirty marker prefix,
    // netlist/raw file names); the default shows until a file is opened
    in property <string> window-title: "Xyce Studio";

    // status bar text, driven from the view adapter
    in property <string> status-text: "";

    // theme detection
    in property <bool> is-dark: Palette.color-scheme == ColorScheme.dark;
    // theme foreground colour, read by the view so netlist token colours for
    // nodes and plain text follow the active palette
    out property <color> editor-foreground: Palette.foreground;
    callback theme-changed(bool);

    init => { root.theme-changed(root.is-dark); }
    changed is-dark => { root.theme-changed(root.is-dark); }

    // fires when the charts panel geometry changes, so the host renderer
    // can recompute the chart frames; forwarded from the ChartsPanel
    // viewport-changed callback
    callback charts-viewport-changed(width: float, height: float);

    // slint native chart frames, forwarded to the ChartsPanel component
    in property <[ChartFrameData]> charts;

    // surrounding canvas color of the charts panel, pushed from the host
    // renderer's chart palette
    in property <color> charts-background;

    // charts panel action availability, forwarded to the ChartsPanel component
    in property <bool> enable-fft: false;
    in property <bool> enable-step-tool: false;
    // smith chart tabs hide the cartesian-only tools
    in property <bool> smith-charts: false;

    // plot tabs, forwarded to the ChartsPanel component
    in property <[PlotTabItem]> plot-tabs: [];
    in-out property <int> active-plot-tab: 0;
    callback plot-tab-selected(int);
    callback plot-tab-closed(int);

    // simulation actions are enabled only when a netlist is loaded (or the app
    // is connected to KiCad); driven from apply_action_enablement
    in property <bool> enable-run-simulation: false;
    in property <bool> enable-configure-simulation: false;

    // a simulation is running: the Run toolbar action is replaced by Stop
    in property <bool> simulation-running: false;

    // live progress of a running simulation, distilled from the Xyce console
    // log by the presenter; the completion percentage is negative for the
    // analyses Xyce reports no progress for, which render as an
    // indeterminate bar
    in property <bool> simulation-progress-running: false;
    in property <float> simulation-progress-percentage: -1;
    in property <string> simulation-progress-eta: "";
    in property <string> simulation-progress-phase: "";
    // warnings and errors Xyce reported so far, with the log row of the first
    // one so the output panel can scroll to it; a row below zero means none
    in property <int> simulation-warning-count: 0;
    in property <int> simulation-error-count: 0;
    in property <int> simulation-warning-line: -1;
    in property <int> simulation-error-line: -1;

    // content-view switching actions; also driven from apply_action_enablement
    in property <bool> enable-show-netlist: false;
    in property <bool> enable-show-charts: false;
    in property <bool> enable-show-sim-output: false;

    // file actions; driven from apply_action_enablement
    in property <bool> enable-open: false;
    in property <bool> enable-save: false;

    // the charts panel is hidden by default and appears when the charts view
    // is shown (controlled from the view adapter)
    in property <bool> charts-visible: false;

    // debug builds expose the hidden automation triggers to the test mcp
    // server; release builds keep them out of the element tree entirely
    in property <bool> debug-tools-enabled: false;

    // netlist editor state, driven from the view adapter; the netlist text is
    // read back from the widget, so the property is also the source of truth
    // for the presenter when tracking user edits
    in-out property <string> netlist-text: "";
    in property <bool> netlist-read-only: false;
    // syntax-highlighted lines model; populated by the C++ adapter after each netlist load
    in-out property <[HighlightedLine]> netlist-highlighted-lines: [];

    // bottom simulation output panel; shown while a simulation runs (or its log
    // holds content), the log is a list of lines model-driven from the view
    in property <bool> simulation-output-visible: false;
    in property <[LogLine]> simulation-output-log;

    // a modal dialog is open, the window dims and must not accept input; the
    // slint dialog is a separate native window, so the OS window input block
    // (per-platform helper) is what actually enforces modality
    in property <bool> modal-active: false;

    // plugin configuration panel rendered inline as a modal overlay (no
    // separate OS window); driven from the view adapter
    in property <bool> plugin-config-visible: false;
    in-out property <string> plugin-config-xyce-path: "";
    in property <bool> plugin-config-show-error: false;
    in property <string> plugin-config-error-message: "";
    in property <bool> plugin-config-browse-enabled: true;

    // forwarded from the inline plugin config panel to the view adapter
    callback plugin-config-accepted();
    callback plugin-config-dismissed();
    callback plugin-config-browse-clicked();
    callback plugin-config-path-edited(string);

    // add plot expression panel rendered inline as a modal overlay (no separate
    // OS window); driven from the view adapter
    in property <bool> add-plot-visible: false;
    in property <[ExpressionItem]> add-plot-expressions: [];
    in property <[BreadcrumbItem]> add-plot-breadcrumb: [];
    in property <[LegendItem]> add-plot-legend-items: [];
    in property <bool> add-plot-show-selected: false;
    in-out property <string> add-plot-filter-text: "";
    in-out property <string> add-plot-custom-text: "";
    in property <bool> add-plot-allow-custom-expressions: true;
    in property <bool> add-plot-show-error: false;

    // forwarded from the inline add plot panel to the view adapter
    callback add-plot-accepted();
    callback add-plot-dismissed();
    callback add-plot-expression-clicked(int);
    callback add-plot-expression-right-clicked(int);
    callback add-plot-breadcrumb-clicked(int);
    callback add-plot-selected-link-clicked();
    callback add-plot-filter-changed(string);
    callback add-plot-custom-add();

    // simulation parameters panel rendered inline as a modal overlay (no
    // separate OS window); driven from the view adapter
    in property <bool> simulation-parameters-visible: false;

    // forwarded from the inline simulation parameters panel to the view adapter
    callback simulation-parameters-accepted();
    callback simulation-parameters-dismissed();

    // analysis tab selected in the tabbed parameter panel
    in-out property <int> simulation-parameters-selected-tab: 0;
    in property <bool> simulation-parameters-show-error: false;
    in property <string> simulation-parameters-error-message: "";

    // one row model per analysis-specific .OPTIONS package edited inside the dialog tabs
    in-out property <[OptionRow]> timeint-rows: [];
    in-out property <[OptionRow]> nonlin-rows: [];
    in-out property <[OptionRow]> nonlin-tran-rows: [];
    in-out property <[OptionRow]> linsol-ac-rows: [];
    in-out property <[OptionRow]> loca-rows: [];
    in-out property <[OptionRow]> fft-rows: [];
    in-out property <[OptionRow]> output-rows: [];

    // forwarded from the inline simulation parameters panel to the view adapter
    callback sim-options-row-edited(int, int, OptionRow);

    // options panel rendered inline as a modal overlay (no separate OS window); driven from the view adapter
    in property <bool> options-visible: false;

    // one row model per simulation-agnostic .OPTIONS package shown in the panel
    in-out property <[OptionRow]> options-device-rows: [];
    in-out property <[OptionRow]> options-linsol-rows: [];
    in-out property <[OptionRow]> options-parser-rows: [];
    in-out property <[OptionRow]> options-diagnostic-rows: [];
    in-out property <[OptionRow]> options-dist-rows: [];
    in-out property <[OptionRow]> options-measure-rows: [];
    in-out property <[OptionRow]> options-restart-rows: [];

    // forwarded from the inline options panel to the view adapter
    callback options-accepted();
    callback options-dismissed();
    callback options-row-edited(int, int, OptionRow);

    // FFT setup panel rendered inline as a modal overlay (no separate OS
    // window); driven from the view adapter
    in property <bool> fft-panel-visible: false;
    in-out property <int> fft-range-mode: 0;
    in-out property <string> fft-custom-from: "";
    in-out property <string> fft-custom-to: "";
    in-out property <int> fft-window-index: 2;
    in-out property <int> fft-format-index: 0;
    in-out property <int> fft-output-index: 0;
    in-out property <bool> fft-keep-dc: true;
    in-out property <int> fft-np-index: 2;
    in-out property <string> fft-custom-np: "";
    in property <[ExpressionItem]> fft-expressions: [];
    in property <[BreadcrumbItem]> fft-breadcrumb: [];
    in property <[LegendItem]> fft-legend-items: [];
    in property <bool> fft-show-selected: false;
    in-out property <string> fft-filter-text: "";
    in property <bool> fft-show-error: false;
    in property <string> fft-error-message: "";

    // forwarded from the inline FFT panel to the view adapter
    callback fft-accepted();
    callback fft-dismissed();
    callback fft-expression-clicked(int);
    callback fft-breadcrumb-clicked(int);
    callback fft-selected-link-clicked();
    callback fft-filter-changed(string);

    // step tool panel rendered inline as a modal overlay (no separate OS
    // window); driven from the view adapter
    in property <bool> step-tool-panel-visible: false;
    in property <[StepItem]> step-tool-steps: [];
    in property <[string]> step-tool-keys: [];
    in property <string> step-tool-selection-count: "";

    // forwarded from the inline step tool panel to the view adapter
    callback step-tool-accepted();
    callback step-tool-dismissed();
    callback step-tool-select-all();
    callback step-tool-clear-all();
    callback step-tool-invert-selection();
    callback step-tool-step-toggled(int);

    in-out property <bool> op-print-enabled: false;
    in-out property <bool> op-print-all-nodes: false;
    in-out property <bool> op-print-all-currents: false;
    in-out property <bool> op-print-power: false;
    in-out property <bool> op-print-bjt-leads: false;
    in-out property <bool> op-print-fet-leads: false;
    in-out property <string> op-print-specific-variables: "";
    in-out property <int> op-print-format-index: 0;
    in-out property <string> op-print-output-file: "";
    in-out property <string> op-print-extra-options: "";
    in-out property <bool> op-save-enabled: false;
    in-out property <int> op-save-type-index: 0;
    in-out property <string> op-save-file: "";
    in-out property <int> op-save-level-index: 0;
    in-out property <string> op-nodeset: "";
    in-out property <string> op-initial-conditions: "";
    in-out property <bool> op-replace-ground: true;

    in-out property <int> ac-sweep-mode-index: 0;
    in-out property <string> ac-points: "";
    in-out property <string> ac-start: "";
    in-out property <string> ac-end: "";
    in-out property <string> ac-data-table: "";
    in-out property <string> ac-measure: "";
    in-out property <bool> ac-print-enabled: false;
    in-out property <int> ac-print-type-index: 0;
    in-out property <bool> ac-print-all-nodes: false;
    in-out property <bool> ac-print-all-currents: false;
    in-out property <string> ac-print-specific-variables: "";
    in-out property <int> ac-print-format-index: 0;
    in-out property <string> ac-print-output-file: "";
    in-out property <string> ac-print-extra-options: "";
    in-out property <bool> ac-replace-ground: true;

    in-out property <string> tran-initial-step: "";
    in-out property <string> tran-final-time: "";
    in-out property <string> tran-start-time: "";
    in-out property <string> tran-step-ceiling: "";
    in-out property <int> tran-op-keyword-index: 0;
    in-out property <string> tran-schedule: "";
    in-out property <string> tran-fft: "";
    in-out property <string> tran-four: "";
    in-out property <string> tran-measure: "";
    in-out property <string> tran-initial-conditions: "";
    in-out property <bool> tran-print-enabled: false;
    in-out property <int> tran-print-type-index: 0;
    in-out property <bool> tran-print-all-nodes: false;
    in-out property <bool> tran-print-all-currents: false;
    in-out property <bool> tran-print-power: false;
    in-out property <bool> tran-print-bjt-leads: false;
    in-out property <bool> tran-print-fet-leads: false;
    in-out property <string> tran-print-specific-variables: "";
    in-out property <int> tran-print-format-index: 0;
    in-out property <string> tran-print-output-file: "";
    in-out property <string> tran-print-extra-options: "";
    in-out property <bool> tran-replace-ground: true;

    in-out property <int> dc-sweep-mode-index: 0;
    // nested sweep rows — projected from DCSimulationParameters::sweeps by C++
    in-out property <[DcSweepRow]> dc-sweeps: [];
    // forwarded DcParametersPanel sweep table actions
    callback dc-add-sweep();
    callback dc-remove-sweep(int);
