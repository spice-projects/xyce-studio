    in-out property <bool> lin-sparcalc: false;
    in-out property <int> lin-format-index: 0;
    in-out property <int> lin-lintype-index: 0;
    in-out property <int> lin-dataformat-index: 0;
    in-out property <string> lin-file: "";
    in-out property <string> lin-output-width: "";
    in-out property <string> lin-precision: "";
    in-out property <int> lin-sweep-mode-index: 0;
    in-out property <string> lin-points: "";
    in-out property <string> lin-start: "";
    in-out property <string> lin-end: "";
    in-out property <string> lin-data-table: "";
    in-out property <bool> lin-print-enabled: false;
    in-out property <int> lin-print-type-index: 0;
    in-out property <bool> lin-print-all-nodes: false;
    in-out property <bool> lin-print-all-currents: false;
    in-out property <string> lin-print-specific-variables: "";
    in-out property <int> lin-print-format-index: 0;
    in-out property <string> lin-print-output-file: "";
    in-out property <string> lin-print-extra-options: "";
    in-out property <bool> lin-replace-ground: true;

    in-out property <bool> pce-enabled: false;
    in-out property <bool> pce-use-expression: false;
    // uncertain parameter rows — projected from PceParameters by C++
    in-out property <[PceParamRow]> pce-parameters: [];
    // forwarded PceParametersPanel parameter table actions
    callback pce-add-parameter();
    callback pce-remove-parameter(int);
    callback pce-parameter-row-updated(int, PceParamRow);
    in-out property <string> pces-options: "";
    in-out property <bool> pce-print-enabled: false;
    in-out property <bool> pce-print-all-nodes: false;
    in-out property <bool> pce-print-all-currents: false;
    in-out property <string> pce-print-specific-variables: "";
    in-out property <int> pce-print-format-index: 0;
    in-out property <string> pce-print-output-file: "";
    in-out property <string> pce-print-extra-options: "";

    background: root.modal-active ? Palette.background.transparentize(0.35) : Palette.background;

    // a plain Rectangle wraps the layout and the overlay so the panel can be
    // absolutely positioned on top of the main content without the layout
    // manager fighting over the overlay's coordinates (a Window whose first
    // child is a layout would otherwise try to manage every child)
    Rectangle {
        VerticalLayout {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            toolbar := Rectangle {
                background: Palette.background;

                VerticalLayout {
                    HorizontalLayout {
                        cross-axis-alignment: center;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 2px;

                        // group 1: file (standalone mode only)
                    ToolbarButton {
                            text: "Open";
                            icon: @image-url("../kicad-icons/directory_open_48.png");
                            enabled: root.enable-open;
                            clicked => { MainWindowActions.open-xyce-file(); }
                        }

                        ToolbarButton {
                            text: "Save";
                            icon: @image-url("../kicad-icons/save_48.png");
                            enabled: root.enable-save;
                            clicked => { MainWindowActions.save-netlist(); }
                        }

                        ToolbarSeparator { }

                        // group 2: content views
                    ToolbarButton {
                            text: "Netlist";
                            icon: @image-url("../kicad-icons/netlist_48.png");
                            enabled: root.enable-show-netlist;
                            clicked => { MainWindowActions.show-netlist(); }
                        }

                        ToolbarButton {
                            text: "Charts";
                            icon: @image-url("../kicad-icons/simulator_48.png");
                            enabled: root.enable-show-charts;
                            clicked => { MainWindowActions.show-charts(); }
                        }

                        ToolbarButton {
                            text: "Sim Output";
                            icon: @image-url("../kicad-icons/sim_command_48.png");
                            enabled: root.enable-show-sim-output;
                            clicked => { MainWindowActions.show-simulation-output(); }
                        }

                        ToolbarSeparator { }

                        // group 3: simulation; while a simulation runs the Run
                    // action is replaced by Stop so the process can be canceled
                    if !root.simulation-running: ToolbarButton {
                            text: "Run Simulation";
                            icon: @image-url("../kicad-icons/sim_run_48.png");
                            enabled: root.enable-run-simulation;
                            accent: true;
                            clicked => { MainWindowActions.run-simulation(); }
                        }
                        if root.simulation-running: ToolbarButton {
                            text: "Stop Simulation";
                            icon: @image-url("../kicad-icons/cancel_48.png");
                            enabled: true;
                            accent: true;
                            accent-color: #e05b4b;
                            clicked => { MainWindowActions.stop-simulation(); }
                        }
                        ToolbarButton {
                            text: "Configure";
                            icon: @image-url("../kicad-icons/sim_tune_48.png");
                            enabled: root.enable-configure-simulation;
                            clicked => { MainWindowActions.configure-simulation(); }
                        }

                        ToolbarButton {
                            text: "Options";
                            icon: @image-url("../kicad-icons/options_generic_48.png");
                            enabled: root.enable-configure-simulation;
                            clicked => { MainWindowActions.edit-options(); }
                        }

                        ToolbarSeparator { }

                        // group 4: plugin configuration
                    ToolbarButton {
                            text: "Plugin Settings";
                            icon: @image-url("../kicad-icons/preference_48.png");
                            clicked => { MainWindowActions.configure-plugin(); }
                        }

                        ToolbarSeparator { }

                        // group 5: exit
                    ToolbarButton {
                            text: "Exit";
                            icon: @image-url("../kicad-icons/exit_48.png");
                            clicked => { MainWindowActions.exit(); }
                        }

                        // absorbs remaining space so the HorizontalLayout can grow
                    // with the window and doesn't impose a hard max-width
                    Rectangle {
                            horizontal-stretch: 1;
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Palette.border;
                    }
                }
            }

            // body: the body container owns the exclusive content views, the
        // schematic panel is shown by default and the charts panel replaces
        // it once the charts view is shown
        body := Rectangle {
                vertical-stretch: 1;
                background: Palette.alternate-background;

                VerticalLayout {
                    if !root.charts-visible: schematic := NetlistEditor {
                        vertical-stretch: 1;
                        text <=> root.netlist-text;
                        read-only: root.netlist-read-only;
                        lines-model <=> root.netlist-highlighted-lines;
                        edited => { MainWindowActions.netlist-edited(); }
                    }
                    if root.charts-visible: charts := ChartsPanel {
                        vertical-stretch: 1;
                        plot-tabs: root.plot-tabs;
                        active-plot-tab <=> root.active-plot-tab;
                        plot-tab-selected(index) => { root.plot-tab-selected(index); }
                        plot-tab-closed(index) => { root.plot-tab-closed(index); }
                        enable-fft: root.enable-fft;
                        enable-step-tool: root.enable-step-tool;
                        smith-charts: root.smith-charts;
                        // forward the debug automation trigger flag
                        debug-tools: root.debug-tools-enabled;
                        // forward the slint native chart frames from the host
                        charts: root.charts;
                        // match the canvas background of the charts panel
                        chart-background: root.charts-background;
                        // report layout changes to the renderer
                        viewport-changed(width, height) => { root.charts-viewport-changed(width, height); }
                    }
                    if root.simulation-output-visible: output := SimulationOutputPanel {
                        height: 200px;
                        log-lines: root.simulation-output-log;
                        warning-count: root.simulation-warning-count;
                        error-count: root.simulation-error-count;
                        warning-line: root.simulation-warning-line;
                        error-line: root.simulation-error-line;
                        close => { MainWindowActions.close-simulation-output(); }
                        copy-requested(start, end) => {
                            MainWindowActions.copy-simulation-output(start, end);
                        }
                    }
                }
            }

            // status bar at the bottom of the window
        statusbar := Rectangle {
                height: 24px;
                background: Palette.background;

                // hairline along the top edge; drawn as an overlay instead of a row of a layout so the
                // content row below is the only layout item and therefore owns the whole bar, which keeps
                // cross-axis-alignment centering the message and the progress indicator vertically
                separator := Rectangle {
                    x: 0;
                    y: 0;
                    width: 100%;
                    height: 1px;
                    background: Palette.border;
                }

                HorizontalLayout {
                    cross-axis-alignment: center;
                    // the padding clears the hairline drawn over the top edge and keeps the content
                    // centered in the bar rather than in the area below the hairline
                    padding-top: 1px;
                    padding-bottom: 1px;
                    padding-left: 12px;
                    padding-right: 12px;

                    // the status message carries its own element id because the progress indicator
                    // adds further Text elements to the same row, which makes a
                    // type-based lookup inside the status bar ambiguous
                    status-message := Text {
                        text: root.status-text;
                        font-size: 12px;
                        color: Palette.foreground;
                        horizontal-alignment: left;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    if root.simulation-progress-running: run-progress := RunProgress {
                        percentage: root.simulation-progress-percentage;
                        eta: root.simulation-progress-eta;
                        phase: root.simulation-progress-phase;
                        warning-count: root.simulation-warning-count;
                        error-count: root.simulation-error-count;
                    }
                }

                // empty overlay turning the whole strip into a shortcut to the simulation output
                // panel while a run is in flight, so a user without the panel open can still reach
                // the live log
                status-touch := TouchArea {
                    mouse-cursor: root.simulation-progress-running ? pointer : default;

                    clicked => {
                        if (root.simulation-progress-running) {
                            MainWindowActions.open-simulation-output-from-status();
                        }
                    }
                }
            }
        }

        // plugin configuration panel rendered as an inline modal overlay: a
    // dimmed backdrop covers the whole window and a centered card holds the
    // form. because it is a child of the Window (not a separate Dialog) there
    // is no second OS window and no modal_manager input blocking is needed;
    // the guard_modal gate and the backdrop's pointer absorption enforce
    // modality within the single window.
    if root.plugin-config-visible: plugin-config := PluginConfigPanel {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            xyce-path <=> root.plugin-config-xyce-path;
            show-error: root.plugin-config-show-error;
            error-message: root.plugin-config-error-message;
            browse-enabled: root.plugin-config-browse-enabled;
            accepted => { root.plugin-config-accepted(); }
            dismissed => { root.plugin-config-dismissed(); }
            browse-clicked => { root.plugin-config-browse-clicked(); }
            path-edited(text) => { root.plugin-config-path-edited(text); }
        }

        // add plot expression panel rendered as an inline modal overlay: a dimmed
    // backdrop covers the whole window and a centered card holds the expression
    // selector. because it is a child of the Window (not a separate Dialog) there
    // is no second OS window and no modal_manager input blocking is needed;
    // the guard_modal gate and the backdrop's pointer absorption enforce
    // modality within the single window.
    if root.add-plot-visible: AddPlotPanel {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            expressions: root.add-plot-expressions;
            breadcrumb: root.add-plot-breadcrumb;
            legend-items: root.add-plot-legend-items;
            show-selected: root.add-plot-show-selected;
            filter-text <=> root.add-plot-filter-text;
            custom-text <=> root.add-plot-custom-text;
            allow-custom-expressions: root.add-plot-allow-custom-expressions;
            show-error: root.add-plot-show-error;
            error-message: "Invalid expression";
            accepted => { root.add-plot-accepted(); }
            dismissed => { root.add-plot-dismissed(); }
            expression-clicked(index) => { root.add-plot-expression-clicked(index); }
            expression-right-clicked(index) => { root.add-plot-expression-right-clicked(index); }
            breadcrumb-clicked(level) => { root.add-plot-breadcrumb-clicked(level); }
            selected-link-clicked => { root.add-plot-selected-link-clicked(); }
            filter-changed(query) => { root.add-plot-filter-changed(query); }
            custom-add => { root.add-plot-custom-add(); }
        }

        if root.simulation-parameters-visible: SimulationParametersPanel {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            selected-tab <=> root.simulation-parameters-selected-tab;
            show-error: root.simulation-parameters-show-error;
            error-message: root.simulation-parameters-error-message;
            accepted => { root.simulation-parameters-accepted(); }
            dismissed => { root.simulation-parameters-dismissed(); }
            op-print-enabled <=> root.op-print-enabled;
            op-print-all-nodes <=> root.op-print-all-nodes;
            op-print-all-currents <=> root.op-print-all-currents;
            op-print-power <=> root.op-print-power;
            op-print-bjt-leads <=> root.op-print-bjt-leads;
            op-print-fet-leads <=> root.op-print-fet-leads;
            op-print-specific-variables <=> root.op-print-specific-variables;
            op-print-format-index <=> root.op-print-format-index;
            op-print-output-file <=> root.op-print-output-file;
            op-print-extra-options <=> root.op-print-extra-options;
            op-save-enabled <=> root.op-save-enabled;
            op-save-type-index <=> root.op-save-type-index;
            op-save-file <=> root.op-save-file;
            op-save-level-index <=> root.op-save-level-index;
            op-nodeset <=> root.op-nodeset;
            op-initial-conditions <=> root.op-initial-conditions;
            op-replace-ground <=> root.op-replace-ground;
            ac-sweep-mode-index <=> root.ac-sweep-mode-index;
            ac-points <=> root.ac-points;
            ac-start <=> root.ac-start;
            ac-end <=> root.ac-end;
            ac-data-table <=> root.ac-data-table;
            ac-measure <=> root.ac-measure;
            ac-print-enabled <=> root.ac-print-enabled;
            ac-print-type-index <=> root.ac-print-type-index;
            ac-print-all-nodes <=> root.ac-print-all-nodes;
            ac-print-all-currents <=> root.ac-print-all-currents;
            ac-print-specific-variables <=> root.ac-print-specific-variables;
            ac-print-format-index <=> root.ac-print-format-index;
            ac-print-output-file <=> root.ac-print-output-file;
            ac-print-extra-options <=> root.ac-print-extra-options;
            ac-replace-ground <=> root.ac-replace-ground;
            tran-initial-step <=> root.tran-initial-step;
            tran-final-time <=> root.tran-final-time;
            tran-start-time <=> root.tran-start-time;
            tran-step-ceiling <=> root.tran-step-ceiling;
            tran-op-keyword-index <=> root.tran-op-keyword-index;
            tran-schedule <=> root.tran-schedule;
            tran-fft <=> root.tran-fft;
            tran-four <=> root.tran-four;
            tran-measure <=> root.tran-measure;
            tran-initial-conditions <=> root.tran-initial-conditions;
            tran-print-enabled <=> root.tran-print-enabled;
            tran-print-type-index <=> root.tran-print-type-index;
            tran-print-all-nodes <=> root.tran-print-all-nodes;
            tran-print-all-currents <=> root.tran-print-all-currents;
            tran-print-power <=> root.tran-print-power;
            tran-print-bjt-leads <=> root.tran-print-bjt-leads;
            tran-print-fet-leads <=> root.tran-print-fet-leads;
            tran-print-specific-variables <=> root.tran-print-specific-variables;
            tran-print-format-index <=> root.tran-print-format-index;
            tran-print-output-file <=> root.tran-print-output-file;
            tran-print-extra-options <=> root.tran-print-extra-options;
            tran-replace-ground <=> root.tran-replace-ground;
            dc-sweep-mode-index <=> root.dc-sweep-mode-index;
            dc-sweeps <=> root.dc-sweeps;
            dc-data-table <=> root.dc-data-table;
            dc-add-sweep => { root.dc-add-sweep(); }
            dc-remove-sweep(index) => { root.dc-remove-sweep(index); }
            dc-sweep-row-updated(index, row) => { root.dc-sweep-row-updated(index, row); }
            dc-measure <=> root.dc-measure;
            dc-initial-conditions <=> root.dc-initial-conditions;
            dc-print-enabled <=> root.dc-print-enabled;
            dc-print-type-index <=> root.dc-print-type-index;
            dc-print-all-nodes <=> root.dc-print-all-nodes;
            dc-print-all-currents <=> root.dc-print-all-currents;
            dc-print-power <=> root.dc-print-power;
            dc-print-bjt-leads <=> root.dc-print-bjt-leads;
            dc-print-fet-leads <=> root.dc-print-fet-leads;
            dc-print-specific-variables <=> root.dc-print-specific-variables;
            dc-print-format-index <=> root.dc-print-format-index;
            dc-print-output-file <=> root.dc-print-output-file;
            dc-print-extra-options <=> root.dc-print-extra-options;
            dc-replace-ground <=> root.dc-replace-ground;
            noise-output-node <=> root.noise-output-node;
            noise-ref-node <=> root.noise-ref-node;
            noise-source-name <=> root.noise-source-name;
            noise-start-freq <=> root.noise-start-freq;
            noise-end-freq <=> root.noise-end-freq;
            noise-num-points <=> root.noise-num-points;
            noise-sweep-type-index <=> root.noise-sweep-type-index;
            noise-data-table <=> root.noise-data-table;
            noise-device-noise <=> root.noise-device-noise;
            noise-print-enabled <=> root.noise-print-enabled;
            noise-print-type-index <=> root.noise-print-type-index;
            noise-print-all-nodes <=> root.noise-print-all-nodes;
            noise-print-all-currents <=> root.noise-print-all-currents;
            noise-print-specific-variables <=> root.noise-print-specific-variables;
            noise-print-format-index <=> root.noise-print-format-index;
            noise-print-output-file <=> root.noise-print-output-file;
            noise-print-extra-options <=> root.noise-print-extra-options;
            noise-replace-ground <=> root.noise-replace-ground;
            hb-frequencies <=> root.hb-frequencies;
            hb-harmonics <=> root.hb-harmonics;
            hb-tahb <=> root.hb-tahb;
            hb-selectharms <=> root.hb-selectharms;
            hb-startup-periods <=> root.hb-startup-periods;
            hb-nonlin-options <=> root.hb-nonlin-options;
            hb-linsol-options <=> root.hb-linsol-options;
            hb-print-enabled <=> root.hb-print-enabled;
            hb-print-type-index <=> root.hb-print-type-index;
            hb-print-all-nodes <=> root.hb-print-all-nodes;
            hb-print-all-currents <=> root.hb-print-all-currents;
            hb-print-specific-variables <=> root.hb-print-specific-variables;
            hb-print-format-index <=> root.hb-print-format-index;
            hb-print-output-file <=> root.hb-print-output-file;
            hb-print-extra-options <=> root.hb-print-extra-options;
            hb-replace-ground <=> root.hb-replace-ground;
            lin-sparcalc <=> root.lin-sparcalc;
            lin-format-index <=> root.lin-format-index;
            lin-lintype-index <=> root.lin-lintype-index;
            lin-dataformat-index <=> root.lin-dataformat-index;
            lin-file <=> root.lin-file;
            lin-output-width <=> root.lin-output-width;
            lin-precision <=> root.lin-precision;
            lin-sweep-mode-index <=> root.lin-sweep-mode-index;
            lin-points <=> root.lin-points;
            lin-start <=> root.lin-start;
            lin-end <=> root.lin-end;
            lin-data-table <=> root.lin-data-table;
            lin-print-enabled <=> root.lin-print-enabled;
            lin-print-type-index <=> root.lin-print-type-index;
            lin-print-all-nodes <=> root.lin-print-all-nodes;
            lin-print-all-currents <=> root.lin-print-all-currents;
            lin-print-specific-variables <=> root.lin-print-specific-variables;
            lin-print-format-index <=> root.lin-print-format-index;
            lin-print-output-file <=> root.lin-print-output-file;
            lin-print-extra-options <=> root.lin-print-extra-options;
            lin-replace-ground <=> root.lin-replace-ground;
            pce-enabled <=> root.pce-enabled;
            pce-use-expression <=> root.pce-use-expression;
            pce-parameters <=> root.pce-parameters;
            pce-add-parameter => { root.pce-add-parameter(); }
            pce-remove-parameter(index) => { root.pce-remove-parameter(index); }
            pce-parameter-row-updated(index, row) => { root.pce-parameter-row-updated(index, row); }
            pces-options <=> root.pces-options;
            pce-print-enabled <=> root.pce-print-enabled;
            pce-print-all-nodes <=> root.pce-print-all-nodes;
            pce-print-all-currents <=> root.pce-print-all-currents;
            pce-print-specific-variables <=> root.pce-print-specific-variables;
            pce-print-format-index <=> root.pce-print-format-index;
            pce-print-output-file <=> root.pce-print-output-file;
            pce-print-extra-options <=> root.pce-print-extra-options;
            timeint-rows <=> root.timeint-rows;
            nonlin-rows <=> root.nonlin-rows;
            nonlin-tran-rows <=> root.nonlin-tran-rows;
            linsol-ac-rows <=> root.linsol-ac-rows;
            loca-rows <=> root.loca-rows;
            fft-rows <=> root.fft-rows;
            output-rows <=> root.output-rows;
            sim-options-row-edited(pkg, idx, row) => { root.sim-options-row-edited(pkg, idx, row); }
        }
    }

    // options panel rendered as an inline modal overlay: a dimmed backdrop covers the whole window and a centered card lists every managed package; modality is enforced by the guard_modal gate and the panel's dimmed backdrop
    if root.options-visible: OptionsPanel {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        device-rows <=> root.options-device-rows;
        linsol-rows <=> root.options-linsol-rows;
        parser-rows <=> root.options-parser-rows;
        diagnostic-rows <=> root.options-diagnostic-rows;
        dist-rows <=> root.options-dist-rows;
        measure-rows <=> root.options-measure-rows;
        restart-rows <=> root.options-restart-rows;
        accepted => { root.options-accepted(); }
        dismissed => { root.options-dismissed(); }
        option-row-edited(pkg, idx, row) => { root.options-row-edited(pkg, idx, row); }
    }

    // FFT setup panel rendered as an inline modal overlay (no separate OS
        // window); modality is enforced by the guard_modal gate and the panel's
        // dimmed backdrop
        if root.fft-panel-visible: FftPanel {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        range-mode <=> root.fft-range-mode;
        custom-from <=> root.fft-custom-from;
        custom-to <=> root.fft-custom-to;
        window-index <=> root.fft-window-index;
        format-index <=> root.fft-format-index;
        output-index <=> root.fft-output-index;
        keep-dc <=> root.fft-keep-dc;
        np-index <=> root.fft-np-index;
        custom-np <=> root.fft-custom-np;
        expressions: root.fft-expressions;
        breadcrumb: root.fft-breadcrumb;
        legend-items: root.fft-legend-items;
        show-selected: root.fft-show-selected;
        filter-text <=> root.fft-filter-text;
        show-error: root.fft-show-error;
        error-message: root.fft-error-message;
        accepted => { root.fft-accepted(); }
        dismissed => { root.fft-dismissed(); }
        expression-clicked(index) => { root.fft-expression-clicked(index); }
        breadcrumb-clicked(level) => { root.fft-breadcrumb-clicked(level); }
        selected-link-clicked => { root.fft-selected-link-clicked(); }
        filter-changed(query) => { root.fft-filter-changed(query); }
    }

    // step tool panel rendered as an inline modal overlay (no separate OS window)
    if root.step-tool-panel-visible: StepToolPanel {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        steps: root.step-tool-steps;
        keys: root.step-tool-keys;
        selection-count: root.step-tool-selection-count;
        accepted => { root.step-tool-accepted(); }
        dismissed => { root.step-tool-dismissed(); }
        select-all => { root.step-tool-select-all(); }
        clear-all => { root.step-tool-clear-all(); }
        invert-selection => { root.step-tool-invert-selection(); }
        step-toggled(index) => { root.step-tool-step-toggled(index); }
    }

    // debug only: automation trigger for the save-as flow; the native save
    // dialog is rendered by the platform and unreachable for the automation,
    // so the trigger primes the path the dialog would return through
    // set_element_value; zero size keeps it out of the layout while it stays
    // in the element tree
    if root.debug-tools-enabled: test-save-as := TouchArea {
        width: 0px;
        height: 0px;
        accessible-role: button;
        accessible-label: "save as";
        accessible-action-set-value(path) => { MainWindowActions.prime-save-as-path(path); }
    }
}
