            lin-print-extra-options <=> root.lin-print-extra-options;
            lin-replace-ground <=> root.lin-replace-ground;
        }
    }

    // FFT setup panel rendered as an inline modal overlay (no separate OS
        // window); modality is enforced by the guard_modal gate and the panel's
        // dimmed backdrop
        if root.fft-panel-visible: FftPanel {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        range-mode <=> root.fft-range-mode;
        custom-from <=> root.fft-custom-from;
        custom-to <=> root.fft-custom-to;
        window-index <=> root.fft-window-index;
        format-index <=> root.fft-format-index;
        output-index <=> root.fft-output-index;
        keep-dc <=> root.fft-keep-dc;
        np-index <=> root.fft-np-index;
        custom-np <=> root.fft-custom-np;
        expressions: root.fft-expressions;
        breadcrumb: root.fft-breadcrumb;
        show-selected: root.fft-show-selected;
        filter-text <=> root.fft-filter-text;
        show-error: root.fft-show-error;
        error-message: root.fft-error-message;
        accepted => { root.fft-accepted(); }
        dismissed => { root.fft-dismissed(); }
        expression-clicked(index) => { root.fft-expression-clicked(index); }
        breadcrumb-clicked(level) => { root.fft-breadcrumb-clicked(level); }
        selected-link-clicked => { root.fft-selected-link-clicked(); }
        filter-changed(query) => { root.fft-filter-changed(query); }
    }

    // step tool panel rendered as an inline modal overlay (no separate OS
        // window); modality is enforced by the guard_modal gate and the panel's
        // dimmed backdrop
        if root.step-tool-panel-visible: StepToolPanel {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        steps: root.step-tool-steps;
        keys: root.step-tool-keys;
        selection-count: root.step-tool-selection-count;
        accepted => { root.step-tool-accepted(); }
        dismissed => { root.step-tool-dismissed(); }
        select-all => { root.step-tool-select-all(); }
        clear-all => { root.step-tool-clear-all(); }
        invert-selection => { root.step-tool-invert-selection(); }
        step-toggled(index) => { root.step-tool-step-toggled(index); }
    }
}
