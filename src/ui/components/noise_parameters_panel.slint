import {
    CheckBox,
    ComboBox,
    LineEdit,
    Palette,
    TextEdit,
} from "std-widgets.slint";

export component NoiseParametersPanel inherits Rectangle {

    // --- noise configuration ---
    in-out property <string> output-node: "";
    in-out property <string> ref-node: "";
    in-out property <string> source-name: "";
    in-out property <string> start-freq: "";
    in-out property <string> end-freq: "";
    in-out property <string> num-points: "";
    // 0 = LIN, 1 = DEC, 2 = OCT, 3 = DATA
    in-out property <int> sweep-type-index: 0;
    in-out property <string> data-table: "";
    in-out property <string> device-noise: "";

    // --- .PRINT section ---
    in-out property <bool> print-enabled: false;
    in-out property <int> print-type-index: 0;
    in-out property <bool> print-all-nodes: false;
    in-out property <bool> print-all-currents: false;
    in-out property <string> print-specific-variables: "";
    in-out property <int> print-format-index: 0;
    in-out property <string> print-output-file: "";
    in-out property <string> print-extra-options: "";

    // --- global settings (replace ground) ---
    in-out property <bool> replace-ground: true;

    // card look: bordered, rounded, on the control background
    border-radius: 8px;
    border-width: 1px;
    border-color: Palette.border;
    background: Palette.control-background;

    VerticalLayout {

        padding: 16px;
        spacing: 14px;

        // card header
        Text {
            text: "Noise Analysis (.NOISE)";
            font-size: 13px;
            font-weight: 600;
            color: Palette.foreground;
            horizontal-alignment: left;
            overflow: elide;
        }

        // ---- .PRINT section ----
        print-card := Rectangle {

            border-width: 1px;
            border-color: Palette.border;
            border-radius: 6px;
            background: Palette.alternate-background;

            VerticalLayout {

                padding: 10px;
                spacing: 8px;

                CheckBox {
                    text: "Enable .PRINT output";
                    font-weight: 600;
                    checked <=> root.print-enabled;
                }

                if root.print-enabled: VerticalLayout {
                    padding-left: 24px;
                    spacing: 8px;

                    // print type selector (single NOISE type)
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: LayoutAlignment.start;
                        Text {
                            text: "Print type";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        ComboBox {
                            height: 28px;
                            model: ["NOISE"];
                            current-index <=> root.print-type-index;
                        }
                    }

                    // wildcard voltage/current rows; power and device lead
                    // currents are not available for a noise analysis (only
                    // branch currents of V, E, H and L devices)
                    HorizontalLayout {
                        spacing: 16px;
                        // explicit widths pin each checkbox so toggling cannot reflow the row
                        // (the cupertino style reports a narrower preferred width when checked)
                        CheckBox {
                            text: "All voltages V(*)";
                            width: 108px;
                            checked <=> root.print-all-nodes;
                        }

                        CheckBox {
                            text: "All currents I(*)";
                            width: 102px;
                            checked <=> root.print-all-currents;
                        }
                    }

                    // additional variables
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Additional variables";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        LineEdit {
                            height: 28px;
                            placeholder-text: "e.g. V(out) V(in)";
                            text <=> root.print-specific-variables;
                        }
                    }

                    // format combo
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: LayoutAlignment.start;
                        Text {
                            text: "Format";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        ComboBox {
                            height: 28px;
                            model: [
                                "(default)",
                                "STD",
                                "NOINDEX",
                                "PROBE",
                                "TECPLOT",
                                "RAW",
                                "CSV",
                                "GNUPLOT",
                                "SPLOT"
                            ];
                            current-index <=> root.print-format-index;
                        }
                    }

                    // output file
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Output file";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        LineEdit {
                            height: 28px;
                            placeholder-text: "optional output file path";
                            text <=> root.print-output-file;
                        }
                    }

                    // extra print options (WIDTH=, PRECISION=, ...). The RAW
                    // format writes binary rawfiles and ignores them (Xyce RG
                    // 2.1.31 / section 8.2), so the row is hidden for RAW;
                    // RAW is index 5 of the format model below
                    if root.print-format-index != 5: HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Extra options";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        LineEdit {
                            height: 28px;
                            placeholder-text: "e.g. WIDTH=20 PRECISION=12";
                            text <=> root.print-extra-options;
                        }
                    }
                }
            }
        }

        // ---- noise configuration ----
        config-card := Rectangle {

            border-width: 1px;
            border-color: Palette.border;
            border-radius: 6px;
            background: Palette.alternate-background;

            VerticalLayout {

                padding: 10px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Output node";
                        font-size: 13px;
                        color: Palette.foreground;
                        min-width: 120px;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        overflow: elide;
                    }

                    LineEdit {
                        height: 28px;
                        placeholder-text: "e.g. V(out)";
                        text <=> root.output-node;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Reference node";
                        font-size: 13px;
                        color: Palette.foreground;
                        min-width: 120px;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        overflow: elide;
                    }

                    LineEdit {
                        height: 28px;
                        placeholder-text: "e.g. V(0)";
                        text <=> root.ref-node;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Source name";
                        font-size: 13px;
                        color: Palette.foreground;
                        min-width: 120px;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        overflow: elide;
                    }

                    LineEdit {
                        height: 28px;
                        placeholder-text: "noise source (e.g. R1)";
                        text <=> root.source-name;
                    }
                }

                // sweep type selector
                HorizontalLayout {
                    spacing: 8px;
                    alignment: LayoutAlignment.start;
                    Text {
                        text: "Sweep type";
                        font-size: 13px;
                        color: Palette.foreground;
                        min-width: 120px;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        overflow: elide;
                    }

                    ComboBox {
                        height: 28px;
                        model: ["LIN", "DEC", "OCT", "DATA"];
                        current-index <=> root.sweep-type-index;
                        selected(current-value) => {
                            // clear the fields hidden by the new sweep type
                            if current-value == "DATA" {
                                root.start-freq = "";
                                root.end-freq = "";
                                root.num-points = "";
                            } else {
                                root.data-table = "";
                            }
                        }
                    }
                }

                // frequency range fields for LIN, DEC and OCT sweeps
                if root.sweep-type-index != 3: VerticalLayout {
                    spacing: 8px;

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Start frequency";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        LineEdit {
                            height: 28px;
                            placeholder-text: "start frequency (e.g. 1)";
                            text <=> root.start-freq;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "End frequency";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        LineEdit {
                            height: 28px;
                            placeholder-text: "end frequency (e.g. 10k)";
                            text <=> root.end-freq;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Number of points";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        LineEdit {
                            height: 28px;
                            placeholder-text: "points per decade/octave";
                            text <=> root.num-points;
                        }
                    }
                }

                // data table name for DATA sweeps
                if root.sweep-type-index == 3: HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Data table";
                        font-size: 13px;
                        color: Palette.foreground;
                        min-width: 120px;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        overflow: elide;
                    }

                    LineEdit {
                        height: 28px;
                        placeholder-text: "name of the data block to sweep";
                        text <=> root.data-table;
                    }
                }
            }
        }

        // ---- device noise operators ----
        dno-card := Rectangle {

            border-width: 1px;
            border-color: Palette.border;
            border-radius: 6px;
            background: Palette.alternate-background;

            VerticalLayout {

                padding: 10px;
                spacing: 6px;

                Text {
                    text: "Device noise operators (one per line: DNI|DNO node source)";
                    font-size: 13px;
                    font-weight: 600;
                    color: Palette.foreground;
                    horizontal-alignment: left;
                    overflow: elide;
                }

                TextEdit {
                    min-height: 60px;
                    wrap: word-wrap;
                    placeholder-text: "e.g. DNI 2 R1";
                    text <=> root.device-noise;
                }
            }
        }

        // ---- global settings ----
        global-card := Rectangle {

            border-width: 1px;
            border-color: Palette.border;
            border-radius: 6px;
            background: Palette.alternate-background;

            VerticalLayout {
                padding: 10px;
                spacing: 6px;

                CheckBox {
                    text: "Replace ground (GND) with 0";
                    checked <=> root.replace-ground;
                }

                Text {
                    text: "When enabled, all ground (GND) references in the netlist are replaced with the node name '0' before simulation. This is required by Xyce which uses '0' as the global ground node.";
                    font-size: 12px;
                    font-italic: true;
                    color: Palette.foreground.transparentize(0.4);
                    wrap: word-wrap;
                    horizontal-alignment: left;
                    overflow: elide;
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
        }
    }
}
