// inline simulation parameters panel rendered within the main window for
// configuring Xyce simulation parameters. inherits the common modal panel
// chrome (title bar, close button, dimmed backdrop, OK/Cancel footer) from
// ModalPanel; only the tabbed analysis form content and panel-specific
// properties/callbacks are defined here.
import { Palette, ScrollView } from "std-widgets.slint";
import { AcParametersPanel } from "../components/ac_parameters_panel.slint";
import {
    DcParametersPanel,
    DcSweepRow,
} from "../components/dc_parameters_panel.slint";
import { HbParametersPanel } from "../components/hb_parameters_panel.slint";
import { LinParametersPanel } from "../components/lin_parameters_panel.slint";
import {
    NoiseParametersPanel,
} from "../components/noise_parameters_panel.slint";
import { ModalPanel } from "../components/modal_panel.slint";
import { OpParametersPanel } from "../components/op_parameters_panel.slint";
import {
    PceParametersPanel,
    PceParamRow,
} from "../components/pce_parameters_panel.slint";
import {
    TransientParametersPanel,
} from "../components/transient_parameters_panel.slint";

component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;

    height: 32px;
    border-radius: 6px;

    // macOS-sidebar-style selection: tinted fill for active, subtle hover fill
    background: active ? Palette.selection-background : (touch-area.has-hover ? Palette.alternate-background : transparent);

    animate background { duration: 120ms; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;

        Text {
            text: root.text;
            font-size: 13px;
            font-weight: 500;
            color: active ? Palette.selection-foreground : Palette.foreground;
            opacity: active ? 1.0 : 0.75;
            vertical-alignment: center;
            horizontal-alignment: left;
            animate opacity { duration: 120ms; }
        }
    }

    touch-area := TouchArea {
        clicked => { root.clicked(); }
    }
}

component TabSectionLabel inherits Text {
    height: 20px;
    font-size: 11px;
    font-weight: 600;
    color: Palette.foreground;
    opacity: 0.45;
    vertical-alignment: center;
}

export component SimulationParametersPanel inherits ModalPanel {

    title: "Xyce Simulation";
    card-width: 820px;
    card-height: 600px;

    // analysis tab selected in the tabbed parameter panel
    in-out property <int> selected-tab: 0;

    // operating point (.OP) panel state, two-way bound to the OpParametersPanel
    // sub-component. C++ reads/writes these root-level properties (sub-component
    // state is not directly addressable from C++ in this Slint version).
    in-out property <bool> op-print-enabled: false;
    in-out property <bool> op-print-all-nodes: false;
    in-out property <bool> op-print-all-currents: false;
    in-out property <bool> op-print-power: false;
    in-out property <bool> op-print-bjt-leads: false;
    in-out property <bool> op-print-fet-leads: false;
    in-out property <string> op-print-specific-variables: "";
    in-out property <int> op-print-format-index: 0;
    in-out property <string> op-print-output-file: "";
    in-out property <string> op-print-extra-options: "";
    in-out property <bool> op-save-enabled: false;
    in-out property <int> op-save-type-index: 0;
    in-out property <string> op-save-file: "";
    in-out property <int> op-save-level-index: 0;
    in-out property <string> op-nodeset: "";
    in-out property <string> op-initial-conditions: "";
    in-out property <bool> op-replace-ground: true;

    // AC analysis (.AC) panel state, two-way bound to the AcParametersPanel
    // sub-component. C++ reads/writes these root-level properties (sub-component
    // state is not directly addressable from C++ in this Slint version).
    in-out property <int> ac-sweep-mode-index: 0;
    in-out property <string> ac-points: "";
    in-out property <string> ac-start: "";
    in-out property <string> ac-end: "";
    in-out property <string> ac-data-table: "";
    in-out property <string> ac-measure: "";
    in-out property <bool> ac-print-enabled: false;
    in-out property <int> ac-print-type-index: 0;
    in-out property <bool> ac-print-all-nodes: false;
    in-out property <bool> ac-print-all-currents: false;
    in-out property <string> ac-print-specific-variables: "";
    in-out property <int> ac-print-format-index: 0;
    in-out property <string> ac-print-output-file: "";
    in-out property <string> ac-print-extra-options: "";
    in-out property <bool> ac-replace-ground: true;

    // transient (.TRAN) panel state, two-way bound to the TransientParametersPanel
    // sub-component. C++ reads/writes these root-level properties (sub-component
    // state is not directly addressable from C++ in this Slint version).
    in-out property <string> tran-initial-step: "";
    in-out property <string> tran-final-time: "";
    in-out property <string> tran-start-time: "";
    in-out property <string> tran-step-ceiling: "";
    in-out property <int> tran-op-keyword-index: 0;
    in-out property <string> tran-schedule: "";
    in-out property <string> tran-fft: "";
    in-out property <string> tran-four: "";
    in-out property <string> tran-measure: "";
    in-out property <bool> tran-print-enabled: false;
    in-out property <int> tran-print-type-index: 0;
    in-out property <bool> tran-print-all-nodes: false;
    in-out property <bool> tran-print-all-currents: false;
    in-out property <bool> tran-print-power: false;
    in-out property <bool> tran-print-bjt-leads: false;
    in-out property <bool> tran-print-fet-leads: false;
    in-out property <string> tran-print-specific-variables: "";
    in-out property <int> tran-print-format-index: 0;
    in-out property <string> tran-print-output-file: "";
    in-out property <string> tran-print-extra-options: "";
    in-out property <bool> tran-replace-ground: true;

    // DC sweep (.DC) panel state, two-way bound to the DcParametersPanel
    // sub-component. C++ reads/writes these root-level properties (sub-component
    // state is not directly addressable from C++ in this Slint version).
    in-out property <int> dc-sweep-mode-index: 0;
    // nested sweep rows — projected from DCSimulationParameters::sweeps by C++
    in-out property <[DcSweepRow]> dc-sweeps: [];
    // forwarded DcParametersPanel sweep table actions
    callback dc-add-sweep();
    callback dc-remove-sweep(int);
    callback dc-sweep-row-updated(int, DcSweepRow);
    in-out property <string> dc-data-table: "";
    in-out property <string> dc-measure: "";
    in-out property <bool> dc-print-enabled: false;
    in-out property <int> dc-print-type-index: 0;
    in-out property <bool> dc-print-all-nodes: false;
    in-out property <bool> dc-print-all-currents: false;
    in-out property <bool> dc-print-power: false;
    in-out property <bool> dc-print-bjt-leads: false;
    in-out property <bool> dc-print-fet-leads: false;
    in-out property <string> dc-print-specific-variables: "";
    in-out property <int> dc-print-format-index: 0;
    in-out property <string> dc-print-output-file: "";
    in-out property <string> dc-print-extra-options: "";
    in-out property <bool> dc-replace-ground: true;

    // noise analysis (.NOISE) panel state, two-way bound to the
    // NoiseParametersPanel sub-component. C++ reads/writes these root-level
    // properties (sub-component state is not directly addressable from C++ in
    // this Slint version).
    in-out property <string> noise-output-node: "";
    in-out property <string> noise-ref-node: "";
    in-out property <string> noise-source-name: "";
    in-out property <string> noise-start-freq: "";
    in-out property <string> noise-end-freq: "";
    in-out property <string> noise-num-points: "";
    in-out property <int> noise-sweep-type-index: 0;
    in-out property <string> noise-data-table: "";
    in-out property <string> noise-device-noise: "";
    in-out property <bool> noise-print-enabled: false;
    in-out property <int> noise-print-type-index: 0;
    in-out property <bool> noise-print-all-nodes: false;
    in-out property <bool> noise-print-all-currents: false;
    in-out property <string> noise-print-specific-variables: "";
    in-out property <int> noise-print-format-index: 0;
    in-out property <string> noise-print-output-file: "";
    in-out property <string> noise-print-extra-options: "";
    in-out property <bool> noise-replace-ground: true;

    // harmonic balance (.HB) panel state, two-way bound to the HbParametersPanel
    // sub-component. C++ reads/writes these root-level properties (sub-component
    // state is not directly addressable from C++ in this Slint version).
    in-out property <string> hb-frequencies: "";
    in-out property <string> hb-harmonics: "";
    in-out property <string> hb-tahb: "";
    in-out property <string> hb-selectharms: "";
    in-out property <string> hb-startup-periods: "";
    in-out property <string> hb-nonlin-options: "";
    in-out property <string> hb-linsol-options: "";
    in-out property <bool> hb-print-enabled: false;
    in-out property <int> hb-print-type-index: 0;
    in-out property <bool> hb-print-all-nodes: false;
    in-out property <bool> hb-print-all-currents: false;
    in-out property <string> hb-print-specific-variables: "";
    in-out property <int> hb-print-format-index: 0;
    in-out property <string> hb-print-output-file: "";
    in-out property <string> hb-print-extra-options: "";
    in-out property <bool> hb-replace-ground: true;

    // linear analysis (.LIN) panel state, two-way bound to the LinParametersPanel
    // sub-component. C++ reads/writes these root-level properties (sub-component
    // state is not directly addressable from C++ in this Slint version).
    in-out property <bool> lin-sparcalc: false;
    in-out property <int> lin-format-index: 0;
    in-out property <int> lin-lintype-index: 0;
    in-out property <int> lin-dataformat-index: 0;
    in-out property <string> lin-file: "";
    in-out property <string> lin-output-width: "";
    in-out property <string> lin-precision: "";
    in-out property <int> lin-sweep-mode-index: 0;
    in-out property <string> lin-points: "";
    in-out property <string> lin-start: "";
    in-out property <string> lin-end: "";
    in-out property <string> lin-data-table: "";
    in-out property <bool> lin-print-enabled: false;
    in-out property <int> lin-print-type-index: 0;
    in-out property <bool> lin-print-all-nodes: false;
    in-out property <bool> lin-print-all-currents: false;
    in-out property <string> lin-print-specific-variables: "";
    in-out property <int> lin-print-format-index: 0;
    in-out property <string> lin-print-output-file: "";
    in-out property <string> lin-print-extra-options: "";
    in-out property <bool> lin-replace-ground: true;

    // uncertainty quantification (.PCE) section state, shared by the DC and
    // transient pages via the PceParametersPanel sub-component. C++ reads/writes
    // these root-level properties (sub-component state is not directly
    // addressable from C++ in this Slint version).
    in-out property <bool> pce-enabled: false;
    in-out property <bool> pce-use-expression: false;
    // uncertain parameter rows — projected from PceParameters by C++
    in-out property <[PceParamRow]> pce-parameters: [];
    // forwarded PceParametersPanel parameter table actions
    callback pce-add-parameter();
    callback pce-remove-parameter(int);
    callback pce-parameter-row-updated(int, PceParamRow);
    in-out property <string> pces-options: "";
    in-out property <bool> pce-print-enabled: false;
    in-out property <bool> pce-print-all-nodes: false;
    in-out property <bool> pce-print-all-currents: false;
    in-out property <string> pce-print-specific-variables: "";
    in-out property <int> pce-print-format-index: 0;
    in-out property <string> pce-print-output-file: "";
    in-out property <string> pce-print-extra-options: "";

    // the tabbed parameter interface: a vertical sidebar of analysis tabs on
    // the left, a divider, and a scrollable content area on the right that
    // shows the parameters for the selected analysis
    HorizontalLayout {
        spacing: 10px;

        VerticalLayout {
            width: 130px;
            spacing: 4px;

            TabSectionLabel {
                text: "DC";
            }

            TabButton {
                text: ".OP";
                active: root.selected-tab == 0;
                clicked => { root.selected-tab = 0; }
            }

            TabButton {
                text: ".DC";
                active: root.selected-tab == 2;
                clicked => { root.selected-tab = 2; }
            }

            TabSectionLabel {
                text: "Time-domain";
            }

            TabButton {
                text: ".TRAN";
                active: root.selected-tab == 1;
                clicked => { root.selected-tab = 1; }
            }

            TabSectionLabel {
                text: "Frequency-domain";
            }

            TabButton {
                text: ".AC";
                active: root.selected-tab == 3;
                clicked => { root.selected-tab = 3; }
            }

            TabButton {
                text: ".NOISE";
                active: root.selected-tab == 4;
                clicked => { root.selected-tab = 4; }
            }

            TabButton {
                text: ".HB";
                active: root.selected-tab == 5;
                clicked => { root.selected-tab = 5; }
            }

            TabButton {
                text: ".LIN";
                active: root.selected-tab == 6;
                clicked => { root.selected-tab = 6; }
            }

            Rectangle {
                vertical-stretch: 1;
            }
        }

        // vertical divider line between tab bar and panel
        Rectangle {
            width: 1px;
            background: Palette.border;
        }

        // tab content container using scroll views
        Rectangle {
            horizontal-stretch: 1;

            ScrollView {
                visible: root.selected-tab == 0;
                content-height: op-panel.preferred-height;

                op-panel := OpParametersPanel {
                    print-enabled <=> root.op-print-enabled;
                    print-all-nodes <=> root.op-print-all-nodes;
                    print-all-currents <=> root.op-print-all-currents;
                    print-power <=> root.op-print-power;
                    print-bjt-leads <=> root.op-print-bjt-leads;
                    print-fet-leads <=> root.op-print-fet-leads;
                    print-specific-variables <=> root.op-print-specific-variables;
                    print-format-index <=> root.op-print-format-index;
                    print-output-file <=> root.op-print-output-file;
                    print-extra-options <=> root.op-print-extra-options;
                    save-enabled <=> root.op-save-enabled;
                    save-type-index <=> root.op-save-type-index;
                    save-file <=> root.op-save-file;
                    save-level-index <=> root.op-save-level-index;
                    nodeset <=> root.op-nodeset;
                    initial-conditions <=> root.op-initial-conditions;
                    replace-ground <=> root.op-replace-ground;
                }
            }

            ScrollView {
                visible: root.selected-tab == 1;
                content-height: tran-page.preferred-height;

                tran-page := VerticalLayout {
                    spacing: 10px;

                    tran-panel := TransientParametersPanel {
                        initial-step <=> root.tran-initial-step;
                        final-time <=> root.tran-final-time;
                        start-time <=> root.tran-start-time;
                        step-ceiling <=> root.tran-step-ceiling;
                        op-keyword-index <=> root.tran-op-keyword-index;
                        schedule <=> root.tran-schedule;
                        fft <=> root.tran-fft;
                        four <=> root.tran-four;
                        measure <=> root.tran-measure;
                        print-enabled <=> root.tran-print-enabled;
                        print-type-index <=> root.tran-print-type-index;
                        print-all-nodes <=> root.tran-print-all-nodes;
                        print-all-currents <=> root.tran-print-all-currents;
                        print-power <=> root.tran-print-power;
                        print-bjt-leads <=> root.tran-print-bjt-leads;
                        print-fet-leads <=> root.tran-print-fet-leads;
                        print-specific-variables <=> root.tran-print-specific-variables;
                        print-format-index <=> root.tran-print-format-index;
                        print-output-file <=> root.tran-print-output-file;
                        print-extra-options <=> root.tran-print-extra-options;
                        replace-ground <=> root.tran-replace-ground;
                    }

                    PceParametersPanel {
                        section-enabled <=> root.pce-enabled;
                        use-expression <=> root.pce-use-expression;
                        parameters <=> root.pce-parameters;
                        add-parameter => { root.pce-add-parameter(); }
                        remove-parameter(index) => { root.pce-remove-parameter(index); }
                        parameter-row-updated(index, row) => { root.pce-parameter-row-updated(index, row); }
                        pces-options <=> root.pces-options;
                        print-enabled <=> root.pce-print-enabled;
                        print-all-nodes <=> root.pce-print-all-nodes;
                        print-all-currents <=> root.pce-print-all-currents;
                        print-specific-variables <=> root.pce-print-specific-variables;
                        print-format-index <=> root.pce-print-format-index;
                        print-output-file <=> root.pce-print-output-file;
                        print-extra-options <=> root.pce-print-extra-options;
                    }
                }
            }

            ScrollView {
                visible: root.selected-tab == 2;
                content-height: dc-page.preferred-height;

                dc-page := VerticalLayout {
                    spacing: 10px;

                    dc-panel := DcParametersPanel {
                        sweep-mode-index <=> root.dc-sweep-mode-index;
                        sweeps <=> root.dc-sweeps;
                        data-table <=> root.dc-data-table;
                        add-sweep => { root.dc-add-sweep(); }
                        remove-sweep(index) => { root.dc-remove-sweep(index); }
                        sweep-row-updated(index, row) => { root.dc-sweep-row-updated(index, row); }
                        measure <=> root.dc-measure;
                        print-enabled <=> root.dc-print-enabled;
                        print-type-index <=> root.dc-print-type-index;
                        print-all-nodes <=> root.dc-print-all-nodes;
                        print-all-currents <=> root.dc-print-all-currents;
                        print-power <=> root.dc-print-power;
                        print-bjt-leads <=> root.dc-print-bjt-leads;
                        print-fet-leads <=> root.dc-print-fet-leads;
                        print-specific-variables <=> root.dc-print-specific-variables;
                        print-format-index <=> root.dc-print-format-index;
                        print-output-file <=> root.dc-print-output-file;
                        print-extra-options <=> root.dc-print-extra-options;
                        replace-ground <=> root.dc-replace-ground;
                    }

                    PceParametersPanel {
                        section-enabled <=> root.pce-enabled;
                        use-expression <=> root.pce-use-expression;
                        parameters <=> root.pce-parameters;
                        add-parameter => { root.pce-add-parameter(); }
                        remove-parameter(index) => { root.pce-remove-parameter(index); }
                        parameter-row-updated(index, row) => { root.pce-parameter-row-updated(index, row); }
                        pces-options <=> root.pces-options;
                        print-enabled <=> root.pce-print-enabled;
                        print-all-nodes <=> root.pce-print-all-nodes;
                        print-all-currents <=> root.pce-print-all-currents;
                        print-specific-variables <=> root.pce-print-specific-variables;
                        print-format-index <=> root.pce-print-format-index;
                        print-output-file <=> root.pce-print-output-file;
                        print-extra-options <=> root.pce-print-extra-options;
                    }
                }
            }

            ScrollView {
                visible: root.selected-tab == 3;
                content-height: ac-panel.preferred-height;

                ac-panel := AcParametersPanel {
                    sweep-mode-index <=> root.ac-sweep-mode-index;
                    points <=> root.ac-points;
                    start <=> root.ac-start;
                    end <=> root.ac-end;
                    data-table <=> root.ac-data-table;
                    measure <=> root.ac-measure;
                    print-enabled <=> root.ac-print-enabled;
                    print-type-index <=> root.ac-print-type-index;
                    print-all-nodes <=> root.ac-print-all-nodes;
                    print-all-currents <=> root.ac-print-all-currents;
                    print-specific-variables <=> root.ac-print-specific-variables;
                    print-format-index <=> root.ac-print-format-index;
                    print-output-file <=> root.ac-print-output-file;
                    print-extra-options <=> root.ac-print-extra-options;
                    replace-ground <=> root.ac-replace-ground;
                }
            }

            ScrollView {
                visible: root.selected-tab == 4;
                content-height: noise-panel.preferred-height;

                noise-panel := NoiseParametersPanel {
                    output-node <=> root.noise-output-node;
                    ref-node <=> root.noise-ref-node;
                    source-name <=> root.noise-source-name;
                    start-freq <=> root.noise-start-freq;
                    end-freq <=> root.noise-end-freq;
                    num-points <=> root.noise-num-points;
                    sweep-type-index <=> root.noise-sweep-type-index;
                    data-table <=> root.noise-data-table;
                    device-noise <=> root.noise-device-noise;
                    print-enabled <=> root.noise-print-enabled;
                    print-type-index <=> root.noise-print-type-index;
                    print-all-nodes <=> root.noise-print-all-nodes;
                    print-all-currents <=> root.noise-print-all-currents;
                    print-specific-variables <=> root.noise-print-specific-variables;
                    print-format-index <=> root.noise-print-format-index;
                    print-output-file <=> root.noise-print-output-file;
                    print-extra-options <=> root.noise-print-extra-options;
                    replace-ground <=> root.noise-replace-ground;
                }
            }

            ScrollView {
                visible: root.selected-tab == 5;
                content-height: hb-panel.preferred-height;

                hb-panel := HbParametersPanel {
                    frequencies <=> root.hb-frequencies;
                    harmonics <=> root.hb-harmonics;
                    tahb <=> root.hb-tahb;
                    selectharms <=> root.hb-selectharms;
                    startup-periods <=> root.hb-startup-periods;
                    nonlin-options <=> root.hb-nonlin-options;
                    linsol-options <=> root.hb-linsol-options;
                    print-enabled <=> root.hb-print-enabled;
                    print-type-index <=> root.hb-print-type-index;
                    print-all-nodes <=> root.hb-print-all-nodes;
                    print-all-currents <=> root.hb-print-all-currents;
                    print-specific-variables <=> root.hb-print-specific-variables;
                    print-format-index <=> root.hb-print-format-index;
                    print-output-file <=> root.hb-print-output-file;
                    print-extra-options <=> root.hb-print-extra-options;
                    replace-ground <=> root.hb-replace-ground;
                }
            }

            ScrollView {
                visible: root.selected-tab == 6;
                content-height: lin-panel.preferred-height;

                lin-panel := LinParametersPanel {
                    sparcalc <=> root.lin-sparcalc;
                    format-index <=> root.lin-format-index;
                    lintype-index <=> root.lin-lintype-index;
                    dataformat-index <=> root.lin-dataformat-index;
                    file <=> root.lin-file;
                    output-width <=> root.lin-output-width;
                    precision <=> root.lin-precision;
                    sweep-mode-index <=> root.lin-sweep-mode-index;
                    points <=> root.lin-points;
                    start <=> root.lin-start;
                    end <=> root.lin-end;
                    data-table <=> root.lin-data-table;
                    print-enabled <=> root.lin-print-enabled;
                    print-type-index <=> root.lin-print-type-index;
                    print-all-nodes <=> root.lin-print-all-nodes;
                    print-all-currents <=> root.lin-print-all-currents;
                    print-specific-variables <=> root.lin-print-specific-variables;
                    print-format-index <=> root.lin-print-format-index;
                    print-output-file <=> root.lin-print-output-file;
                    print-extra-options <=> root.lin-print-extra-options;
                    replace-ground <=> root.lin-replace-ground;
                }
            }
        }
    }
}
