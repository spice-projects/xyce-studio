import {
    CheckBox,
    ComboBox,
    LineEdit,
    Palette,
    TextEdit,
} from "std-widgets.slint";

export component LinParametersPanel inherits Rectangle {

    // --- s-parameter options ---
    in-out property <bool> sparcalc: false;
    // Xyce RG 2.1.17: FORMAT=<TOUCHSTONE2|TOUCHSTONE>
    // 0 = TOUCHSTONE2 (default), 1 = TOUCHSTONE (v1)
    in-out property <int> format-index: 0;
    // Xyce RG 2.1.17: LINTYPE=<S|Y|Z>
    // 0 = S, 1 = Y, 2 = Z
    in-out property <int> lintype-index: 0;
    // 0 = RI, 1 = MA, 2 = DB
    in-out property <int> dataformat-index: 0;
    in-out property <string> file: "";
    in-out property <string> output-width: "";
    in-out property <string> precision: "";

    // --- embedded AC sweep ---
    // 0 = LIN, 1 = DEC, 2 = OCT, 3 = DATA
    in-out property <int> sweep-mode-index: 0;
    in-out property <string> points: "";
    in-out property <string> start: "";
    in-out property <string> end: "";
    in-out property <string> data-table: "";

    // --- .PRINT section ---
    in-out property <bool> print-enabled: false;
    in-out property <int> print-type-index: 0;
    in-out property <bool> print-all-nodes: false;
    in-out property <bool> print-all-currents: false;
    in-out property <string> print-specific-variables: "";
    in-out property <int> print-format-index: 0;
    in-out property <string> print-output-file: "";
    in-out property <string> print-extra-options: "";

    // --- global settings (replace ground) ---
    in-out property <bool> replace-ground: true;

    // card look: bordered, rounded, on the control background
    border-radius: 8px;
    border-width: 1px;
    border-color: Palette.border;
    background: Palette.control-background;

    VerticalLayout {

        padding: 16px;
        spacing: 14px;

        // card header
        Text {
            text: "Linear Analysis (.LIN)";
            font-size: 13px;
            font-weight: 600;
            color: Palette.foreground;
            horizontal-alignment: left;
            overflow: elide;
        }

        // ---- .PRINT section ----
        print-card := Rectangle {

            border-width: 1px;
            border-color: Palette.border;
            border-radius: 6px;
            background: Palette.alternate-background;

            VerticalLayout {

                padding: 10px;
                spacing: 8px;

                CheckBox {
                    text: "Enable .PRINT output";
                    font-weight: 600;
                    checked <=> root.print-enabled;
                }

                if root.print-enabled: VerticalLayout {
                    padding-left: 24px;
                    spacing: 8px;

                    // print type selector (single AC type)
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: LayoutAlignment.start;
                        Text {
                            text: "Print type";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        ComboBox {
                            height: 28px;
                            model: ["AC"];
                            current-index <=> root.print-type-index;
                        }
                    }

                    // wildcard voltage/current rows; power and device lead
                    // currents are not available for a linear analysis (the
                    // print is an AC print, only branch currents of V, E, H
                    // and L devices are supported)
                    HorizontalLayout {
                        spacing: 16px;
                        // min-widths pin each checkbox so toggling cannot reflow the row
                        // (the cupertino style reports a narrower preferred width when checked)
                        CheckBox {
                            text: "All voltages V(*)";
                            min-width: 142px;
                            checked <=> root.print-all-nodes;
                        }

                        CheckBox {
                            text: "All currents I(*)";
                            min-width: 136px;
                            checked <=> root.print-all-currents;
                        }
                    }

                    // additional variables
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Additional variables";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        LineEdit {
                            height: 28px;
                            placeholder-text: "e.g. V(out) V(in)";
                            text <=> root.print-specific-variables;
                        }
                    }

                    // format combo
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: LayoutAlignment.start;
                        Text {
                            text: "Format";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        ComboBox {
                            height: 28px;
                            model: [
                                "(default)",
                                "STD",
                                "NOINDEX",
                                "PROBE",
                                "TECPLOT",
                                "RAW",
                                "CSV",
                                "GNUPLOT",
                                "SPLOT"
                            ];
                            current-index <=> root.print-format-index;
                        }
                    }

                    // output file
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Output file";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        LineEdit {
                            height: 28px;
                            placeholder-text: "optional output file path";
                            text <=> root.print-output-file;
                        }
                    }

                    // extra print options (WIDTH=, PRECISION=, ...). The RAW
                    // format writes binary rawfiles and ignores them (Xyce RG
                    // 2.1.31 / section 8.2), so the row is hidden for RAW;
                    // RAW is index 5 of the format model below
                    if root.print-format-index != 5: HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Extra options";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        LineEdit {
                            height: 28px;
                            placeholder-text: "e.g. WIDTH=20 PRECISION=12";
                            text <=> root.print-extra-options;
                        }
                    }
                }
            }
        }

        // ---- parameter extraction options ----
        spar-card := Rectangle {

            border-width: 1px;
            border-color: Palette.border;
            border-radius: 6px;
            background: Palette.alternate-background;

            VerticalLayout {

                padding: 10px;
                spacing: 8px;

                Text {
                    text: "Parameter extraction options";
                    font-size: 13px;
                    font-weight: 600;
                    color: Palette.foreground;
                    horizontal-alignment: left;
                    overflow: elide;
                }

                CheckBox {
                    text: "Enable SPARCALC";
                    checked <=> root.sparcalc;
                }

                // extraction options only apply while SPARCALC is enabled;
                // without it Xyce runs a plain AC analysis and ignores them
                if root.sparcalc: VerticalLayout {
                    padding-left: 24px;
                    spacing: 8px;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: LayoutAlignment.start;
                        Text {
                            text: "Format";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        ComboBox {
                            height: 28px;
                            model: ["TOUCHSTONE2", "TOUCHSTONE"];
                            current-index <=> root.format-index;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: LayoutAlignment.start;
                        Text {
                            text: "Type";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        ComboBox {
                            height: 28px;
                            model: ["S", "Y", "Z"];
                            current-index <=> root.lintype-index;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: LayoutAlignment.start;
                        Text {
                            text: "Data format";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        ComboBox {
                            height: 28px;
                            model: ["RI", "MA", "DB"];
                            current-index <=> root.dataformat-index;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Output file";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        LineEdit {
                            height: 28px;
                            placeholder-text: "touchstone output file path";
                            text <=> root.file;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Width";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        LineEdit {
                            height: 28px;
                            placeholder-text: "width in characters";
                            text <=> root.output-width;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Precision";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        LineEdit {
                            height: 28px;
                            placeholder-text: "decimal precision";
                            text <=> root.precision;
                        }
                    }
                }
            }
        }

        // ---- embedded AC sweep ----
        ac-card := Rectangle {

            border-width: 1px;
            border-color: Palette.border;
            border-radius: 6px;
            background: Palette.alternate-background;

            VerticalLayout {

                padding: 10px;
                spacing: 8px;

                Text {
                    text: "AC Sweep";
                    font-size: 13px;
                    font-weight: 600;
                    color: Palette.foreground;
                    horizontal-alignment: left;
                    overflow: elide;
                }

                // sweep mode selector
                HorizontalLayout {
                    spacing: 8px;
                    alignment: LayoutAlignment.start;
                    Text {
                        text: "Sweep mode";
                        font-size: 13px;
                        color: Palette.foreground;
                        min-width: 120px;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        overflow: elide;
                    }

                    ComboBox {
                        height: 28px;
                        model: ["LIN", "DEC", "OCT", "DATA"];
                        current-index <=> root.sweep-mode-index;
                        selected(current-value) => {
                            // clear the fields hidden by the new sweep mode
                            if current-value == "DATA" {
                                root.points = "";
                                root.start = "";
                                root.end = "";
                            } else {
                                root.data-table = "";
                            }
                        }
                    }
                }

                // sweep range fields for LIN, DEC and OCT sweeps
                if root.sweep-mode-index != 3: VerticalLayout {
                    spacing: 8px;

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Points";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        LineEdit {
                            height: 28px;
                            placeholder-text: "number of points per decade";
                            text <=> root.points;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Start";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        LineEdit {
                            height: 28px;
                            placeholder-text: "start frequency (e.g. 1k)";
                            text <=> root.start;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "End";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        LineEdit {
                            height: 28px;
                            placeholder-text: "stop frequency (e.g. 100MEG)";
                            text <=> root.end;
                        }
                    }
                }

                // data table name for DATA sweeps
                if root.sweep-mode-index == 3: HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Data table";
                        font-size: 13px;
                        color: Palette.foreground;
                        min-width: 120px;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        overflow: elide;
                    }

                    LineEdit {
                        height: 28px;
                        placeholder-text: "name of the data block to sweep";
                        text <=> root.data-table;
                    }
                }
            }
        }

        // ---- global settings ----
        global-card := Rectangle {

            border-width: 1px;
            border-color: Palette.border;
            border-radius: 6px;
            background: Palette.alternate-background;

            VerticalLayout {
                padding: 10px;
                spacing: 6px;

                CheckBox {
                    text: "Replace ground (GND) with 0";
                    checked <=> root.replace-ground;
                }

                Text {
                    text: "When enabled, all ground (GND) references in the netlist are replaced with the node name '0' before simulation. This is required by Xyce which uses '0' as the global ground node.";
                    font-size: 12px;
                    font-italic: true;
                    color: Palette.foreground.transparentize(0.4);
                    wrap: word-wrap;
                    horizontal-alignment: left;
                    overflow: elide;
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
        }
    }
}
