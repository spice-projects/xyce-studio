import "../fonts/Inter-Regular.ttf";

// one legend entry of the chart view
export struct ChartLegendItemData {
    name: string,
    color: color,
}

// one plotted series; the polyline is provided as svg commands in pixel
// coordinates relative to the plot rect origin (see ChartLayout)
export struct ChartSeriesData {
    name: string,
    color: color,
    commands: string,
}

// one axis tick label positioned at a pixel offset along the axis
export struct ChartTickData {
    label: string,
    pixel-pos: float,
    show: bool,
    major: bool,
}

// one grid line at a pixel offset with its opacity
export struct ChartGridData {
    pixel-pos: float,
    major: bool,
    alpha: float,
}

// pixel-space rendering data of one chart, produced by the chart layout
// engine (ChartFrame) and rendered natively by the ChartView component
export struct ChartFrameData {
    // palette roles of the charts (chart_palette.h)
    text-color: color,
    panel-color: color,
    border-color: color,
    grid-color: color,
    // viewport the frame was laid out for; the view scales its contents to
    // its own size so a stretched window shows the chart filling the area
    // until the layout republishes exact geometry
    frame-w: float,
    frame-h: float,
    plot-x: float,
    plot-y: float,
    plot-w: float,
    plot-h: float,
    x-datum: float,
    x-ticks: [ChartTickData],
    y-ticks: [ChartTickData],
    y2-ticks: [ChartTickData],
    y3-ticks: [ChartTickData],
    y2-datum: float,
    y3-datum: float,
    x-grid: [ChartGridData],
    y-grid: [ChartGridData],
    y2-grid: [ChartGridData],
    y3-grid: [ChartGridData],
    legend-x: float,
    legend-y: float,
    legend-w: float,
    legend-h: float,
    // smith charts draw the fixed +-1 gamma plane with a grid of constant
    // resistance circles and constant reactance arcs instead of axis ticks
    smith: bool,
    smith-grid: [ChartSeriesData],
    legend: [ChartLegendItemData],
    series: [ChartSeriesData],
}

// slint native chart view rendering one ChartFrame snapshot; geometry comes
// in logical px from the chart layout engine
export component ChartView inherits Rectangle {
    in property <ChartFrameData> frame;

    // accessible identity naming the plotted series so screen readers and the
    // test automation can tell charts apart; empty charts report no name
    accessible-role: groupbox;
    private property <string> first-series-name:
        frame.series.length > 0 ? frame.series[0].name : "";
    accessible-label: root.first-series-name;

    // provisional stretch from the frame's laid-out viewport to the current
    // element size, so a resizing window shows the chart filling the area
    // until the layout publishes exact geometry (mirrors the image scaling)
    property <length> scale-x: frame.frame-w > 0.0 ? self.width / frame.frame-w : 1px;
    property <length> scale-y: frame.frame-h > 0.0 ? self.height / frame.frame-h : 1px;

    // outward tick mark lengths matching the implot axis tick geometry
    // (major tick len 4px, minor tick len 2px)
    function tick-length(major: bool) -> length {
        if major { return 4px; }
        return 2px;
    }

    // grid line color from the shared chart palette; minor lines carry their
    // own opacity
    function axis-grid-color(major: bool, alpha: float) -> color {
        if major { return frame.grid-color; }
        return frame.grid-color.transparentize(1.0 - alpha);
    }

    // plot background matching the implot plot background (panel role)
    Rectangle {
        x: frame.plot-x * root.scale-x;
        y: frame.plot-y * root.scale-y;
        width: frame.plot-w * root.scale-x;
        height: frame.plot-h * root.scale-y;
        background: frame.panel-color;
    }

    // grid lines and series inside the plot rect, clipped
    Rectangle {
        x: frame.plot-x * root.scale-x;
        y: frame.plot-y * root.scale-y;
        width: frame.plot-w * root.scale-x;
        height: frame.plot-h * root.scale-y;
        clip: true;

        // major and minor grid lines from the abscissa axis; pixel positions
        // are frame relative, the clip rect is plot relative
        for line in frame.x-grid: Rectangle {
            x: (line.pixel-pos - frame.plot-x) * root.scale-x;
            y: 0px;
            width: 1px;
            height: 100%;
            background: root.axis-grid-color(line.major, line.alpha);
        }

        // major and minor grid lines from the west y axis
        for line in frame.y-grid: Rectangle {
            x: 0px;
            y: (line.pixel-pos - frame.plot-y) * root.scale-y;
            width: 100%;
            height: 1px;
            background: root.axis-grid-color(line.major, line.alpha);
        }

        // major and minor grid lines from the first east y axis
        for line in frame.y2-grid: Rectangle {
            x: 0px;
            y: (line.pixel-pos - frame.plot-y) * root.scale-y;
            width: 100%;
            height: 1px;
            background: root.axis-grid-color(line.major, line.alpha);
        }

        // major and minor grid lines from the second east y axis
        for line in frame.y3-grid: Rectangle {
            x: 0px;
            y: (line.pixel-pos - frame.plot-y) * root.scale-y;
            width: 100%;
            height: 1px;
            background: root.axis-grid-color(line.major, line.alpha);
        }

        // smith grid: the unit circle boundary and the constant resistance
        // and reactance grid polylines, drawn under the series
        for run in frame.smith-grid: Path {
            commands: run.commands;
            fill: transparent;
            stroke: run.color;
            stroke-width: 1px;
            width: frame.plot-w * root.scale-x;
            height: frame.plot-h * root.scale-y;
            viewbox-x: 0;
            viewbox-y: 0;
            viewbox-width: frame.plot-w;
            viewbox-height: frame.plot-h;
        }

        // plotted series as stroked polylines clipped to the plot area
        for run in frame.series: Path {
            commands: run.commands;
            fill: transparent;
            stroke: run.color;
            // 2.0px logical matches implot LineWeight, but the implot stroke
            // renders ~3.4 device px of ink at scale 2; use the same effective
            // width so the strokes look identical
            stroke-width: 1.7px;
            width: frame.plot-w * root.scale-x;
            height: frame.plot-h * root.scale-y;
            viewbox-x: 0;
            viewbox-y: 0;
            viewbox-width: frame.plot-w;
            viewbox-height: frame.plot-h;
        }
    }

    // plot border drawn around the plot rect
    Rectangle {
        x: frame.plot-x * root.scale-x;
        y: frame.plot-y * root.scale-y;
        width: frame.plot-w * root.scale-x;
        height: frame.plot-h * root.scale-y;
        background: transparent;
        border-width: 1px;
        border-color: frame.border-color;
    }

    // x tick marks extending up from the datum line into the plot
    for tick in frame.x-ticks: Rectangle {
        visible: tick.show && tick.pixel-pos >= frame.plot-x && tick.pixel-pos <= frame.plot-x + frame.plot-w;
        x: tick.pixel-pos * root.scale-x;
        y: frame.x-datum * root.scale-y;
        width: 1px;
        height: root.tick-length(tick.major);
        background: frame.border-color;
    }

    // x tick labels centered under the datum line
    for tick in frame.x-ticks: Rectangle {
        visible: tick.show && tick.pixel-pos >= frame.plot-x - 1.0 && tick.pixel-pos <= frame.plot-x + frame.plot-w + 1.0;
        x: tick.pixel-pos * root.scale-x - 40px;
        y: frame.x-datum * root.scale-y + 6px;
        width: 80px;
        height: 14px;

        Text {
            width: 100%;
            height: 100%;
            text: tick.label;
            font-family: "Inter";
            font-size: 11.56px;
            color: frame.text-color;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // y1 tick marks extending right from the west datum into the plot
    for tick in frame.y-ticks: Rectangle {
        visible: tick.show && tick.pixel-pos >= frame.plot-y && tick.pixel-pos <= frame.plot-y + frame.plot-h;
        x: frame.plot-x * root.scale-x;
        y: tick.pixel-pos * root.scale-y - root.tick-length(tick.major) / 2;
        width: root.tick-length(tick.major);
        height: 1px;
        background: frame.border-color;
    }

    // y1 tick labels right aligned at the west datum
    for tick in frame.y-ticks: Rectangle {
        visible: tick.show && tick.pixel-pos >= frame.plot-y - 1.0 && tick.pixel-pos <= frame.plot-y + frame.plot-h + 1.0;
        x: frame.plot-x * root.scale-x - 6px - 80px;
        y: tick.pixel-pos * root.scale-y - 7px;
        width: 80px;
        height: 14px;

        Text {
            width: 100%;
            height: 100%;
            text: tick.label;
            font-family: "Inter";
            font-size: 11.56px;
            color: frame.text-color;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }

    // y2 tick marks extending left from the east datum into the plot
    for tick in frame.y2-ticks: Rectangle {
        visible: tick.show;
        x: frame.y2-datum * root.scale-x - root.tick-length(tick.major);
        y: tick.pixel-pos * root.scale-y - root.tick-length(tick.major) / 2;
        width: root.tick-length(tick.major);
        height: 1px;
        background: frame.border-color;
    }

    // y2 tick labels left aligned at the east datum, clamped to the panel width
    for tick in frame.y2-ticks: Rectangle {
        visible: tick.show;
        x: frame.y2-datum * root.scale-x + 6px;
        y: tick.pixel-pos * root.scale-y - 7px;
        width: min(80px, parent.width - frame.y2-datum * root.scale-x - 6px);
        height: 14px;

        Text {
            width: 100%;
            height: 100%;
            text: tick.label;
            font-family: "Inter";
            font-size: 11.56px;
            color: frame.text-color;
            horizontal-alignment: left;
            vertical-alignment: center;
        }
    }

    // y3 tick marks extending left from the east datum into the plot
    for tick in frame.y3-ticks: Rectangle {
        visible: tick.show;
        x: frame.y3-datum * root.scale-x - root.tick-length(tick.major);
        y: tick.pixel-pos * root.scale-y - root.tick-length(tick.major) / 2;
        width: root.tick-length(tick.major);
        height: 1px;
        background: frame.border-color;
    }

    // y3 tick labels left aligned at the east datum, clamped to the panel width
    for tick in frame.y3-ticks: Rectangle {
        visible: tick.show;
        x: frame.y3-datum * root.scale-x + 6px;
        y: tick.pixel-pos * root.scale-y - 7px;
        width: min(80px, parent.width - frame.y3-datum * root.scale-x - 6px);
        height: 14px;

        Text {
            width: 100%;
            height: 100%;
            text: tick.label;
            font-family: "Inter";
            font-size: 11.56px;
            color: frame.text-color;
            horizontal-alignment: left;
            vertical-alignment: center;
        }
    }

    // y3 axis line: implot draws a vertical datum line at the second east
    // axis position when two axes share the east side (the border rect only
    // covers y2 at the plot edge, so y3 stacked outward needs its own line)
    Rectangle {
        visible: frame.y3-ticks.length > 0;
        x: frame.y3-datum * root.scale-x;
        y: frame.plot-y * root.scale-y;
        width: 1px;
        height: frame.plot-h * root.scale-y;
        background: frame.border-color;
    }

    // legend block overlapping the abscissa tick label band, like implot
    Rectangle {
        visible: frame.legend.length > 0;
        x: frame.legend-x * root.scale-x;
        y: frame.legend-y * root.scale-y;
        width: frame.legend-w * root.scale-x;
        height: frame.legend-h * root.scale-y;

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            padding-top: 4px;
            padding-bottom: 4px;
            spacing: 12px;
            alignment: center;

            for item in frame.legend: HorizontalLayout {
                spacing: 0px;
                alignment: center;

                // icon slot with the swatch inset like the implot legend icon
                Rectangle {
                    width: 14px;
                    height: 14px;

                    Rectangle {
                        x: 2px;
                        y: 2px;
                        width: 10px;
                        height: 10px;
                        background: item.color;
                    }
                }

                Text {
                    text: item.name;
                    font-family: "Inter";
                    font-size: 11.56px;
                    color: frame.text-color;
                    vertical-alignment: center;
                }
            }
        }
    }
}
