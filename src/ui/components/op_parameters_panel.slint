import { CheckBox, ComboBox, LineEdit, Palette } from "std-widgets.slint";

export component OpParametersPanel inherits Rectangle {

    // --- .PRINT section ---
    // the print section is always "DC" for an OP analysis, so there is no print-type
    // combo; that field is synthesized to "DC" by the C++ builder
    in-out property <bool> print-enabled: false;
    in-out property <bool> print-all-nodes: false;
    in-out property <bool> print-all-currents: false;
    in-out property <bool> print-power: false;
    in-out property <bool> print-bjt-leads: false;
    in-out property <bool> print-fet-leads: false;
    in-out property <string> print-specific-variables: "";
    in-out property <int> print-format-index: 0;
    in-out property <string> print-output-file: "";
    in-out property <string> print-extra-options: "";

    // --- .SAVE section ---
    in-out property <bool> save-enabled: false;
    in-out property <int> save-type-index: 0; // 0 = NODESET, 1 = IC
    in-out property <string> save-file: "";
    in-out property <int> save-level-index: 0; // 0 = (default), 1 = all, 2 = none

    // --- convergence hints / initial conditions ---
    in-out property <string> nodeset: "";
    in-out property <string> initial-conditions: "";

    // --- global settings (replace ground) ---
    in-out property <bool> replace-ground: true;

    // card look: bordered, rounded, on the control background
    border-radius: 8px;
    border-width: 1px;
    border-color: Palette.border;
    background: Palette.control-background;

    VerticalLayout {

        padding: 16px;
        spacing: 14px;

        // card header
        Text {
            text: "Operating Point Analysis (.OP)";
            font-size: 13px;
            font-weight: 600;
            color: Palette.foreground;
            horizontal-alignment: left;
            overflow: elide;
        }

        // ---- .PRINT section ----
        print-card := Rectangle {
            border-width: 1px;
            border-color: Palette.border;
            border-radius: 6px;
            background: Palette.alternate-background;

            VerticalLayout {

                padding: 10px;
                spacing: 8px;

                CheckBox {
                    text: "Enable .PRINT output";
                    font-weight: 600;
                    checked <=> root.print-enabled;
                }

                if root.print-enabled: VerticalLayout {
                    padding-left: 24px;
                    spacing: 8px;

                    // wildcard voltage/current/power and lead row
                    HorizontalLayout {
                        spacing: 16px;
                        // explicit widths pin each checkbox so toggling cannot reflow the row
                        // (the cupertino style reports a narrower preferred width when checked);
                        // the fixed widths total 444px, which fits the panel width with the
                        // 16px spacing in a single row
                        CheckBox {
                            text: "All voltages V(*)";
                            width: 108px;
                            checked <=> root.print-all-nodes;
                        }

                        CheckBox {
                            text: "All currents I(*)";
                            width: 102px;
                            checked <=> root.print-all-currents;
                        }

                        CheckBox {
                            text: "Power P(*)";
                            width: 81px;
                            checked <=> root.print-power;
                        }

                        CheckBox {
                            text: "BJT leads";
                            width: 76px;
                            checked <=> root.print-bjt-leads;
                        }

                        CheckBox {
                            text: "FET leads";
                            width: 77px;
                            checked <=> root.print-fet-leads;
                        }
                    }

                    // additional variables
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Additional variables";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        LineEdit {
                            height: 28px;
                            placeholder-text: "e.g. V(out) V(in)";
                            text <=> root.print-specific-variables;
                        }
                    }

                    // format combo
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: LayoutAlignment.start;
                        Text {
                            text: "Format";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        ComboBox {
                            height: 28px;
                            model: [
                                "(default)",
                                "STD",
                                "NOINDEX",
                                "PROBE",
                                "TECPLOT",
                                "RAW",
                                "CSV",
                                "GNUPLOT",
                                "SPLOT"
                            ];
                            current-index <=> root.print-format-index;
                        }
                    }

                    // output file
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Output file";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        LineEdit {
                            height: 28px;
                            placeholder-text: "optional output file path";
                            text <=> root.print-output-file;
                        }
                    }

                    // extra print options (WIDTH=, PRECISION=, ...). The RAW
                    // format writes binary rawfiles and ignores them (Xyce RG
                    // 2.1.31 / section 8.2), so the row is hidden for RAW;
                    // RAW is index 5 of the format model below
                    if root.print-format-index != 5: HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Extra options";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        LineEdit {
                            height: 28px;
                            placeholder-text: "e.g. WIDTH=20 PRECISION=12";
                            text <=> root.print-extra-options;
                        }
                    }
                }
            }
        }

        // ---- .SAVE section ----
        save-card := Rectangle {

            border-width: 1px;
            border-color: Palette.border;
            border-radius: 6px;
            background: Palette.alternate-background;

            VerticalLayout {
                padding: 10px;
                spacing: 8px;

                CheckBox {
                    text: "Enable .SAVE operating point";
                    font-weight: 600;
                    checked <=> root.save-enabled;
                }

                if root.save-enabled: VerticalLayout {
                    padding-left: 24px;
                    spacing: 8px;

                    // save type selector (NODESET vs IC)
                    HorizontalLayout {
                        spacing: 8px;
                        ComboBox {
                            height: 28px;
                            model: ["Save as .NODESET", "Save as .IC"];
                            current-index <=> root.save-type-index;
                        }
                    }

                    // save file row
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Save file";
                            font-size: 13px;
                            color: Palette.foreground.transparentize(0.4);
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        LineEdit {
                            height: 28px;
                            placeholder-text: "optional output file path";
                            text <=> root.save-file;
                        }
                    }

                    // save level selector (HSPICE compatibility; Xyce default is all)
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Level";
                            font-size: 13px;
                            color: Palette.foreground.transparentize(0.4);
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        ComboBox {
                            height: 28px;
                            model: ["(default)", "all", "none"];
                            current-index <=> root.save-level-index;
                        }
                    }
                }
            }
        }

        // ---- convergence hints (.NODESET) ----
        nodeset-card := Rectangle {

            border-width: 1px;
            border-color: Palette.border;
            border-radius: 6px;
            background: Palette.alternate-background;

            VerticalLayout {
                padding: 10px;
                spacing: 6px;

                Text {
                    text: "Convergence Hints (.NODESET)";
                    font-size: 13px;
                    font-weight: 600;
                    color: Palette.foreground;
                    horizontal-alignment: left;
                    overflow: elide;
                }

                Text {
                    text: "Initial voltage/current guesses to help DC convergence";
                    font-size: 12px;
                    color: Palette.foreground.transparentize(0.4);
                    horizontal-alignment: left;
                    overflow: elide;
                }

                LineEdit {
                    height: 28px;
                    placeholder-text: "e.g. V(1)=5.0 V(2)=3.3";
                    text <=> root.nodeset;
                }
            }
        }

        // ---- initial conditions (.IC / .DCVOLT) ----
        ic-card := Rectangle {

            border-width: 1px;
            border-color: Palette.border;
            border-radius: 6px;
            background: Palette.alternate-background;

            VerticalLayout {
                padding: 10px;
                spacing: 6px;

                Text {
                    text: "Initial Conditions (.IC / .DCVOLT)";
                    font-size: 13px;
                    font-weight: 600;
                    color: Palette.foreground;
                    horizontal-alignment: left;
                    overflow: elide;
                }

                Text {
                    text: "Initial conditions for operating-point analysis";
                    font-size: 12px;
                    color: Palette.foreground.transparentize(0.4);
                    horizontal-alignment: left;
                    overflow: elide;
                }

                LineEdit {
                    height: 28px;
                    placeholder-text: "e.g. V(out)=1.0 V(in)=0";
                    text <=> root.initial-conditions;
                }
            }
        }

        // ---- global settings ----
        global-card := Rectangle {

            border-width: 1px;
            border-color: Palette.border;
            border-radius: 6px;
            background: Palette.alternate-background;

            VerticalLayout {
                padding: 10px;
                spacing: 6px;

                CheckBox {
                    text: "Replace ground (GND) with 0";
                    checked <=> root.replace-ground;
                }

                Text {
                    text: "When enabled, all ground (GND) references in the netlist are replaced with the node name '0' before simulation. This is required by Xyce which uses '0' as the global ground node.";
                    font-size: 12px;
                    font-italic: true;
                    color: Palette.foreground.transparentize(0.4);
                    wrap: word-wrap;
                    horizontal-alignment: left;
                    overflow: elide;
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
        }
    }
}
