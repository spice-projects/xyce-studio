// Simulation output panel: a header row with a title, copy and close buttons
// over a monospaced, virtualized list of log lines.
//
// The log uses a custom `ListView` element rather than the std-widgets one.
// The std-widgets ListView is a ScrollView whose own scrollbar consumes wheel
// events and applies the raw trackpad delta with no momentum, which scrolls
// far too slowly on macOS; it also two-way-binds its content-y through the
// Flickable, which fights programmatic scrolling. This ListView inherits the
// builtin Flickable so the compiler virtualizes the for-loop inside it (it
// keys on the element type name "ListView" plus the content properties).
//
// The builtin Flickable's own wheel handling applies raw trackpad deltas with
// kinetic momentum, which scrolls too fast on macOS. Wheel scrolling is
// therefore handled by a selection overlay on top of the list instead: it
// scrolls one-to-one with the raw delta (no momentum), and additionally
// implements terminal-style line selection (click, shift+click, drag). A thin
// LogScrollBar adds a draggable thumb and scrolls the strip under the pointer.
import { Palette } from "std-widgets.slint";

component ListView inherits Flickable {
    // explicit visible-size mirrors, as the builtin Flickable does not expose
    // them (the std-widgets ScrollView declares them); the ListView
    // virtualization pass requires both on the element
    out property <length> visible-width <=> self.width;
    out property <length> visible-height <=> self.height;
}

// thin overlay scrollbar for the log. it only draws the thumb, lets the user
// drag it, and scrolls the strip under the pointer; wheel events over the log
// itself are handled by the selection overlay (see SimulationOutputPanel)
component LogScrollBar inherits Rectangle {
    in property <length> viewport-y;
    in property <length> viewport-height;
    in property <length> visible-height;

    callback scrolled-to(y: length);

    private property <length> track: max(2px, self.height - 8px);
    private property <length> grab-offset: 0px;

    width: 12px;
    visible: self.viewport-height > self.visible-height;
    background: transparent;
    clip: true;

    track-rect := Rectangle {
        x: parent.width / 2 - self.width / 2;
        y: 4px;
        width: 2px;
        height: root.track;
        border-radius: 1px;
        background: Palette.foreground.with-alpha(0.12);
    }

    thumb := Rectangle {
        x: parent.width / 2 - self.width / 2;
        width: 6px;
        y: 4px + root.track * (-root.viewport-y / max(1px, root.viewport-height));
        height: max(18px, root.track * root.visible-height / max(1px, root.viewport-height));
        border-radius: 3px;
        background: Palette.foreground.with-alpha(0.35);
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;

        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.grab-offset = self.mouse-y - thumb.y;
            }
        }

        moved => {
            if (self.pressed) {
                root.scrolled-to(max(-(root.viewport-height - root.visible-height), min(0px,
                    -(self.mouse-y - root.grab-offset - 4px) / root.track * root.viewport-height)));
            }
        }

        scroll-event(event) => {
            if (event.delta-y != 0) {
                root.scrolled-to(max(-(root.viewport-height - root.visible-height), min(0px,
                    root.viewport-y + event.delta-y)));
                return accept;
            }
            reject
        }
    }
}

export component SimulationOutputPanel inherits Rectangle {
    in property <[string]> log-lines;
    in-out property <int> selection-start: -1;
    in-out property <int> selection-end: -1;
    callback close;
    callback copy-requested(start: int, end: int);

    // uniform row height: the selection math and the virtualized list layout
    // both rely on it
    private property <length> row-height: 18px;
    // selection anchor for shift+click / drag range selection
    private property <int> anchor: -1;

    background: Palette.background;

    VerticalLayout {
        HorizontalLayout {
            cross-axis-alignment: center;
            padding-left: 12px;
            padding-right: 4px;

            Text {
                text: "Simulation Output";
                font-size: 13px;
                font-weight: 600;
                color: Palette.foreground;
                vertical-alignment: center;
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            copy-button := Rectangle {
                min-width: 52px;
                height: 24px;
                border-radius: 4px;
                background: cpb.pressed
                    ? Palette.foreground.transparentize(0.82)
                    : cpb.has-hover
                    ? Palette.foreground.transparentize(0.92)
                    : transparent;
                animate background {
                    duration: 100ms;
                    easing: ease-out;
                }

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;

                    Text {
                        text: "Copy";
                        font-size: 12px;
                        color: Palette.foreground;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }

                cpb := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        // copy the selection, or the whole log when nothing is selected
                        if (root.selection-start < 0) {
                            root.copy-requested(0, max(0, root.log-lines.length - 1));
                        } else {
                            root.copy-requested(root.selection-start, root.selection-end);
                        }
                    }
                }
            }

            close-button := Rectangle {
                min-width: 24px;
                max-width: 24px;
                height: 24px;
                border-radius: 4px;
                background: tb.pressed
                    ? Palette.foreground.transparentize(0.82)
                    : tb.has-hover
                    ? Palette.foreground.transparentize(0.92)
                    : transparent;
                animate background {
                    duration: 100ms;
                    easing: ease-out;
                }

                Image {
                    x: (parent.width - 12px) / 2;
                    y: (parent.height - 12px) / 2;
                    width: 12px;
                    height: 12px;
                    source: @image-url("../kicad-icons/cancel_24.png");
                    image-fit: contain;
                }

                tb := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.close(); }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Palette.border;
        }

        Rectangle {
            vertical-stretch: 1;
            horizontal-stretch: 1;

            keys := FocusScope {
                log := ListView {
                    width: parent.width;
                    height: parent.height;

                    // monospaced log lines; the bundled "JetBrains Mono"
                    // family (imported and embedded by main_window.slint)
                    // keeps columns aligned with identical metrics on every
                    // platform (the generic "monospace" family does not
                    // resolve to a real monospace font in this slint build)
                    for line[index] in root.log-lines: log-line := Rectangle {
                        height: root.row-height;
                        background: index >= root.selection-start && index <= root.selection-end
                            ? Palette.foreground.with-alpha(0.14)
                            : transparent;

                        Text {
                            x: 0;
                            width: 100%;
                            height: 100%;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            text: line;
                            font-family: "JetBrains Mono";
                            font-size: 13px;
                            color: Palette.foreground;
                            wrap: no-wrap;
                        }
                    }

                    // keep the log pinned to the bottom while lines arrive. the
                    // first user scroll (wheel or thumb drag) replaces this
                    // binding, so new lines no longer force the viewport back
                    // to the bottom while reading
                    content-y: max(0px, self.content-height - self.visible-height);
                }

                // selection overlay on top of the log: handles line selection
                // (terminal style) and wheel scrolling with a controlled step
                // instead of the Flickable's momentum-based builtin handling.
                // it must not cover the scrollbar strip below it
                overlay := TouchArea {
                    x: 0;
                    y: 0;
                    width: parent.width - scrollbar.width;
                    height: parent.height;

                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                            keys.focus();
                            let row = max(0, min(root.log-lines.length - 1,
                                floor((-log.content-y + self.mouse-y) / root.row-height)));
                            if (event.modifiers.shift) {
                                root.selection-start = min(root.anchor, row);
                                root.selection-end = max(root.anchor, row);
                            } else {
                                root.anchor = row;
                                root.selection-start = row;
                                root.selection-end = row;
                            }
                        }
                    }

                    moved => {
                        if (self.pressed) {
                            let row = max(0, min(root.log-lines.length - 1,
                                floor((-log.content-y + self.mouse-y) / root.row-height)));
                            root.selection-start = min(root.anchor, row);
                            root.selection-end = max(root.anchor, row);
                        }
                    }

                    scroll-event(event) => {
                        if (event.delta-y != 0) {
                            log.content-y = max(-(log.content-height - log.visible-height), min(0px,
                                log.content-y + event.delta-y));
                            return accept;
                        }
                        reject
                    }
                }

                scrollbar := LogScrollBar {
                    x: parent.width - self.width;
                    y: 0;
                    height: parent.height;
                    viewport-y: log.content-y;
                    viewport-height: log.content-height;
                    visible-height: log.visible-height;
                    scrolled-to(y) => {
                        log.content-y = y;
                    }
                }

                // Cmd/Ctrl+C copies the selection (or everything when nothing
                // is selected), Cmd/Ctrl+A selects all
                key-pressed(event) => {
                    if (event.modifiers.control || event.modifiers.meta) {
                        if (event.text == "c") {
                            if (root.selection-start < 0) {
                                root.copy-requested(0, max(0, root.log-lines.length - 1));
                            } else {
                                root.copy-requested(root.selection-start, root.selection-end);
                            }
                            return accept;
                        }
                        if (event.text == "a") {
                            root.selection-start = 0;
                            root.selection-end = max(0, root.log-lines.length - 1);
                            return accept;
                        }
                    }
                    reject
                }
            }
        }
    }
}
