import {
    CheckBox,
    ComboBox,
    LineEdit,
    Palette,
    TextEdit,
} from "std-widgets.slint";

export component AcParametersPanel inherits Rectangle {

    // --- sweep configuration ---
    // 0 = LIN, 1 = DEC, 2 = OCT, 3 = DATA
    in-out property <int> sweep-mode-index: 0;
    in-out property <string> points: "";
    in-out property <string> start: "";
    in-out property <string> end: "";
    in-out property <string> data-table: "";

    // --- .MEASURE directives ---
    in-out property <string> measure: "";

    // --- .PRINT section ---
    in-out property <bool> print-enabled: false;
    // 0 = AC, 1 = AC_IC
    in-out property <int> print-type-index: 0;
    in-out property <bool> print-all-nodes: false;
    in-out property <bool> print-all-currents: false;
    in-out property <string> print-specific-variables: "";
    in-out property <int> print-format-index: 0;
    in-out property <string> print-output-file: "";
    in-out property <string> print-extra-options: "";

    // --- global settings (replace ground) ---
    in-out property <bool> replace-ground: true;

    // card look: bordered, rounded, on the control background
    border-radius: 8px;
    border-width: 1px;
    border-color: Palette.border;
    background: Palette.control-background;

    VerticalLayout {

        padding: 16px;
        spacing: 14px;

        // card header
        Text {
            text: "AC Analysis (.AC)";
            font-size: 13px;
            font-weight: 600;
            color: Palette.foreground;
            horizontal-alignment: left;
            overflow: elide;
        }

        // ---- sweep configuration ----
        sweep-card := Rectangle {

            border-width: 1px;
            border-color: Palette.border;
            border-radius: 6px;
            background: Palette.alternate-background;

            VerticalLayout {

                padding: 10px;
                spacing: 8px;

                // sweep mode selector
                HorizontalLayout {
                    spacing: 8px;
                    alignment: LayoutAlignment.start;
                    Text {
                        text: "Sweep mode";
                        font-size: 13px;
                        color: Palette.foreground;
                        min-width: 120px;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        overflow: elide;
                    }

                    ComboBox {
                        height: 28px;
                        model: ["LIN", "DEC", "OCT", "DATA"];
                        current-index <=> root.sweep-mode-index;
                        selected(current-value) => {
                            // clear the fields hidden by the new sweep mode
                            if current-value == "DATA" {
                                root.points = "";
                                root.start = "";
                                root.end = "";
                            }
                            else {
                                root.data-table = "";
                            }
                        }
                    }
                }

                // sweep range fields for LIN, DEC and OCT sweeps
                if root.sweep-mode-index != 3: VerticalLayout {
                    spacing: 8px;

                    // points row
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Points";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        LineEdit {
                            height: 28px;
                            placeholder-text: "number of points per decade";
                            text <=> root.points;
                        }
                    }

                    // start frequency row
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Start";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        LineEdit {
                            height: 28px;
                            placeholder-text: "start frequency (e.g. 1k)";
                            text <=> root.start;
                        }
                    }

                    // end frequency row
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "End";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        LineEdit {
                            height: 28px;
                            placeholder-text: "stop frequency (e.g. 100MEG)";
                            text <=> root.end;
                        }
                    }
                }

                // data table name row for DATA sweeps
                if root.sweep-mode-index == 3: HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Data table";
                        font-size: 13px;
                        color: Palette.foreground;
                        min-width: 120px;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        overflow: elide;
                    }

                    LineEdit {
                        height: 28px;
                        placeholder-text: "name of the data block to sweep";
                        text <=> root.data-table;
                    }
                }
            }
        }

        // ---- .MEASURE directives ----
        measure-card := Rectangle {

            border-width: 1px;
            border-color: Palette.border;
            border-radius: 6px;
            background: Palette.alternate-background;

            VerticalLayout {

                padding: 10px;
                spacing: 6px;

                Text {
                    text: ".MEASURE directives (one per line)";
                    font-size: 13px;
                    font-weight: 600;
                    color: Palette.foreground;
                    horizontal-alignment: left;
                    overflow: elide;
                }

                TextEdit {
                    min-height: 60px;
                    wrap: word-wrap;
                    placeholder-text: "e.g. .MEASURE AC vout_max MAX V(out)";
                    text <=> root.measure;
                }
            }
        }

        // ---- .PRINT section ----
        print-card := Rectangle {

            border-width: 1px;
            border-color: Palette.border;
            border-radius: 6px;
            background: Palette.alternate-background;

            VerticalLayout {

                padding: 10px;
                spacing: 8px;

                CheckBox {
                    text: "Enable .PRINT output";
                    font-weight: 600;
                    checked <=> root.print-enabled;
                }

                if root.print-enabled: VerticalLayout {
                    padding-left: 24px;
                    spacing: 8px;

                    // print type selector (AC / AC_IC)
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: LayoutAlignment.start;
                        Text {
                            text: "Print type";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        ComboBox {
                            height: 28px;
                            model: ["AC", "AC_IC"];
                            current-index <=> root.print-type-index;
                        }
                    }

                    // wildcard voltage/current rows; power and device lead
                    // currents are not available for an AC analysis (only
                    // branch currents of V, E, H and L devices)
                    HorizontalLayout {
                        spacing: 16px;
                        // min-widths pin each checkbox so toggling cannot reflow the row
                        // (the cupertino style reports a narrower preferred width when checked)
                        CheckBox {
                            text: "All voltages V(*)";
                            min-width: 142px;
                            checked <=> root.print-all-nodes;
                        }

                        CheckBox {
                            text: "All currents I(*)";
                            min-width: 136px;
                            checked <=> root.print-all-currents;
                        }
                    }

                    // additional variables
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Additional variables";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        LineEdit {
                            height: 28px;
                            placeholder-text: "e.g. V(out) V(in)";
                            text <=> root.print-specific-variables;
                        }
                    }

                    // format combo
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: LayoutAlignment.start;
                        Text {
                            text: "Format";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        ComboBox {
                            height: 28px;
                            model: [
                                "(default)",
                                "STD",
                                "NOINDEX",
                                "PROBE",
                                "TECPLOT",
                                "RAW",
                                "CSV",
                                "GNUPLOT",
                                "SPLOT"
                            ];
                            current-index <=> root.print-format-index;
                        }
                    }

                    // output file
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Output file";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        LineEdit {
                            height: 28px;
                            placeholder-text: "optional output file path";
                            text <=> root.print-output-file;
                        }
                    }

                    // extra print options (WIDTH=, PRECISION=, ...). The RAW
                    // format writes binary rawfiles and ignores them (Xyce RG
                    // 2.1.31 / section 8.2), so the row is hidden for RAW;
                    // RAW is index 5 of the format model below
                    if root.print-format-index != 5: HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Extra options";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        LineEdit {
                            height: 28px;
                            placeholder-text: "e.g. WIDTH=20 PRECISION=12";
                            text <=> root.print-extra-options;
                        }
                    }
                }
            }
        }

        // ---- global settings ----
        global-card := Rectangle {

            border-width: 1px;
            border-color: Palette.border;
            border-radius: 6px;
            background: Palette.alternate-background;

            VerticalLayout {
                padding: 10px;
                spacing: 6px;

                CheckBox {
                    text: "Replace ground (GND) with 0";
                    checked <=> root.replace-ground;
                }

                Text {
                    text: "When enabled, all ground (GND) references in the netlist are replaced with the node name '0' before simulation. This is required by Xyce which uses '0' as the global ground node.";
                    font-size: 12px;
                    font-italic: true;
                    color: Palette.foreground.transparentize(0.4);
                    wrap: word-wrap;
                    horizontal-alignment: left;
                    overflow: elide;
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
        }
    }
}
