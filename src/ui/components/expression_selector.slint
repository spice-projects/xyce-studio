import { Palette, ScrollView, VerticalBox } from "std-widgets.slint";

// expression offered for plotting; either an expression tile or a drill-in
// scope tile
export struct ExpressionItem {
    // display label; scope-relative for expression tiles inside a scope
    label: string,
    // scope kind: "subcircuit" or "sheet" for scope tiles; empty for
    // expression tiles
    kind: string,
    // signal classification for expression tiles (the measurement unit),
    // empty for misc and scope tiles
    type: string,
    // identity dot color of the expression tile, computed by the view
    dot-color: color,
    // scope tiles drill into the group when clicked
    is-scope: bool,
    // expression tiles only
    selected: bool,
    // scope tiles only: number of contained expressions
    count: int,
    // full expression name for the tooltip and the expression builder;
    // empty for scope tiles
    name: string,
}

// one segment of the breadcrumb path above the grid
export struct BreadcrumbItem {
    label: string,
    // scope level restored when the segment is clicked, 0 is the root
    level: int,
}

// resolves a hierarchy scope kind to its color
export global TypePalette {
    // resolves a hierarchy scope kind to its color
    public pure function group-color(kind: string) -> color {
        if (kind.to-lowercase() == "subcircuit") { return #8e6dd9; }
        if (kind.to-lowercase() == "sheet") { return #4dd0e1; }
        return #3a3d4a;
    }
}

// small filled dot marking the chip signal type
component TypeDot inherits Rectangle {
    in property <color> dot-color;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: dot-color;
}

// selectable expression tile: colored identity dot, ellipsized name, accent when
// picked. State transitions are animated for a native, non-janky feel. the
// tooltip shows the full expression name, the label may be scope-relative.
component ExpressionChip inherits Rectangle {
    in property <string> label;
    in property <string> name;
    in property <color> dot-color;
    in property <bool> selected: false;
    callback clicked;
    callback right-clicked;

    height: 32px;
    border-radius: 8px;
    border-width: root.selected ? 1.5px : 1px;
    border-color: root.selected ? Palette.accent-background : (touch.has-hover ? Palette.accent-background : Palette.border);
    background: root.selected ? Palette.accent-background : (touch.has-hover ? Palette.control-background : Palette.alternate-background);

    animate background, border-color, border-width {
        duration: 140ms;
        easing: ease-out;
    }

    HorizontalLayout {
        alignment: start;
        padding-left: 10px;
        padding-right: 8px;
        spacing: 7px;

        VerticalLayout {
            width: 8px;
            alignment: center;
            TypeDot {
                dot-color: root.dot-color;
                opacity: root.selected ? 0.9 : 1;
            }
        }

        Text {
            text: root.label;
            color: root.selected ? Palette.accent-foreground : Palette.foreground;
            font-size: 13px;
            horizontal-alignment: left;
            vertical-alignment: center;
            overflow: elide;
        }

        VerticalLayout {
            width: 16px;
            visible: root.selected;
            alignment: center;
            Text {
                text: "✓";
                color: Palette.accent-foreground;
                font-size: 13px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                root.right-clicked();
            }
        }
        clicked => {
            root.clicked();
        }
    }

    Tooltip {
        VerticalBox {
            Text {
                text: root.name == "" ? root.label : root.name;
                color: Palette.foreground;
                font-size: 13px;
                horizontal-alignment: left;
                vertical-alignment: center;
            }
        }
    }
}

// drill-in scope tile: kind-colored dot, scope name, contained expression
// count, and a chevron affordance. clicking drills into the scope.
component ScopeChip inherits Rectangle {
    in property <string> label;
    in property <string> kind;
    in property <int> count;
    callback clicked;

    height: 32px;
    border-radius: 8px;
    border-width: 1px;
    border-color: touch.has-hover ? TypePalette.group-color(root.kind) : Palette.border;
    background: touch.has-hover ? Palette.control-background : Palette.alternate-background;

    animate background, border-color {
        duration: 140ms;
        easing: ease-out;
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 7px;

        VerticalLayout {
            width: 8px;
            alignment: center;
            TypeDot {
                dot-color: TypePalette.group-color(root.kind);
            }
        }

        Text {
            text: root.label;
            color: Palette.foreground;
            font-size: 13px;
            horizontal-alignment: left;
            vertical-alignment: center;
            overflow: elide;
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        Text {
            text: "\{root.count}";
            font-size: 11px;
            color: Palette.foreground.transparentize(0.4);
            vertical-alignment: center;
        }

        Text {
            text: "›";
            font-size: 13px;
            color: TypePalette.group-color(root.kind);
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    Tooltip {
        VerticalBox {
            Text {
                text: "Open \{root.label} (\{root.count} expressions)";
                color: Palette.foreground;
                font-size: 13px;
                horizontal-alignment: left;
                vertical-alignment: center;
            }
        }
    }
}

// breadcrumb path of the browsed scope; the last segment is the current
// scope and is not clickable
export component Breadcrumb inherits HorizontalLayout {
    in property <[BreadcrumbItem]> items;
    callback segment-clicked(int);

    alignment: start;
    spacing: 6px;

    for segment[index] in root.items: HorizontalLayout {
        spacing: 6px;

        if index > 0: Text {
            text: "›";
            font-size: 12px;
            color: Palette.foreground.transparentize(0.5);
            vertical-alignment: center;
        }

        Rectangle {
            HorizontalLayout {
                Text {
                    text: segment.label;
                    font-size: 12px;
                    color: index == root.items.length - 1 ? Palette.foreground : Palette.accent-background;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            tap := TouchArea {
                enabled: index < root.items.length - 1;
                mouse-cursor: pointer;
                clicked => {
                    root.segment-clicked(segment.level);
                }
            }
        }
    }
}

// flow of chips inside a scrollable region; columns reflow with the dialog
// width. scope tiles drill into subcircuit and sheet scopes, expression
// tiles toggle the plot selection
export component ExpressionGrid inherits ScrollView {
    in property <[ExpressionItem]> expressions;
    callback expression-clicked(int);
    callback expression-right-clicked(int);

    private property <length> gap: 8px;
    private property <int> columns: max(1, Math.round(self.width / 190px));
    private property <length> cell-width: (self.visible-width - (self.columns - 1) * self.gap - 8px) / self.columns;
    private property <length> row-height: 32px;
    private property <int> row-count: Math.ceil(self.expressions.length / self.columns);
    private property <length> grid-height: self.row-count * (self.row-height + self.gap);

    vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;

    content-width: self.visible-width;
    content-height: self.grid-height + 8px;

    for exp[index] in root.expressions: Rectangle {
        x: 4px + Math.mod(index, root.columns) * (root.cell-width + root.gap);
        y: 4px + Math.floor(index / root.columns) * (root.row-height + root.gap);
        width: root.cell-width;
        height: root.row-height;

        if exp.is-scope: ScopeChip {
            width: 100%;
            height: 100%;
            label: exp.label;
            kind: exp.kind;
            count: exp.count;
            clicked => {
                root.expression-clicked(index);
            }
        }

        if !exp.is-scope: ExpressionChip {
            width: 100%;
            height: 100%;
            label: exp.label;
            name: exp.name;
            dot-color: exp.dot-color;
            selected: exp.selected;
            clicked => {
                root.expression-clicked(index);
            }
            right-clicked => {
                root.expression-right-clicked(index);
            }
        }
    }
}

// bottom legend of the signal categories
export struct LegendItem {
    label: string,
    color: color,
}

export component Legend inherits HorizontalLayout {
    in property <[LegendItem]> items;

    for item in root.items: HorizontalLayout {
        spacing: 4px;
        TypeDot {
            dot-color: item.color;
        }

        Text {
            text: item.label;
            font-size: 11px;
            color: Palette.foreground.transparentize(0.35);
            vertical-alignment: center;
        }
    }
}
