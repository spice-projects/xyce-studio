import {
    CheckBox,
    ComboBox,
    LineEdit,
    Palette,
    TextEdit,
} from "std-widgets.slint";

export component TransientParametersPanel inherits Rectangle {

    // --- time stepping fields ---
    in-out property <string> initial-step: "";
    in-out property <string> final-time: "";
    in-out property <string> start-time: "";
    in-out property <string> step-ceiling: "";
    // 0 = (None), 1 = NOOP, 2 = UIC
    in-out property <int> op-keyword-index: 0;
    in-out property <string> schedule: "";

    // --- .FFT / .FOUR / .MEASURE directives ---
    in-out property <string> fft: "";
    in-out property <string> four: "";
    in-out property <string> measure: "";

    // --- .PRINT section ---
    in-out property <bool> print-enabled: false;
    // 0 = TRAN, 1 = TRANADJOINT
    in-out property <int> print-type-index: 0;
    in-out property <bool> print-all-nodes: false;
    in-out property <bool> print-all-currents: false;
    in-out property <bool> print-power: false;
    in-out property <bool> print-bjt-leads: false;
    in-out property <bool> print-fet-leads: false;
    in-out property <string> print-specific-variables: "";
    in-out property <int> print-format-index: 0;
    in-out property <string> print-output-file: "";
    in-out property <string> print-extra-options: "";

    // --- global settings (replace ground) ---
    in-out property <bool> replace-ground: true;

    // card look: bordered, rounded, on the control background
    border-radius: 8px;
    border-width: 1px;
    border-color: Palette.border;
    background: Palette.control-background;

    VerticalLayout {

        padding: 16px;
        spacing: 14px;

        // card header
        Text {
            text: "Transient Analysis (.TRAN)";
            font-size: 13px;
            font-weight: 600;
            color: Palette.foreground;
            horizontal-alignment: left;
            overflow: elide;
        }

        // ---- time stepping ----
        time-card := Rectangle {

            border-width: 1px;
            border-color: Palette.border;
            border-radius: 6px;
            background: Palette.alternate-background;

            VerticalLayout {

                padding: 10px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Initial step";
                        font-size: 13px;
                        color: Palette.foreground;
                        min-width: 120px;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        overflow: elide;
                    }

                    LineEdit {
                        height: 28px;
                        placeholder-text: "initial time step (e.g. 1n)";
                        text <=> root.initial-step;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Final time";
                        font-size: 13px;
                        color: Palette.foreground;
                        min-width: 120px;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        overflow: elide;
                    }

                    LineEdit {
                        height: 28px;
                        placeholder-text: "simulation end time (e.g. 1u)";
                        text <=> root.final-time;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Start time";
                        font-size: 13px;
                        color: Palette.foreground;
                        min-width: 120px;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        overflow: elide;
                    }

                    LineEdit {
                        height: 28px;
                        placeholder-text: "optional start time (e.g. 0)";
                        text <=> root.start-time;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Max time step";
                        font-size: 13px;
                        color: Palette.foreground;
                        min-width: 120px;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        overflow: elide;
                    }

                    LineEdit {
                        height: 28px;
                        placeholder-text: "optional step ceiling";
                        text <=> root.step-ceiling;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: LayoutAlignment.start;
                    Text {
                        text: "OP keyword";
                        font-size: 13px;
                        color: Palette.foreground;
                        min-width: 120px;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        overflow: elide;
                    }

                    ComboBox {
                        height: 28px;
                        model: ["(None)", "NOOP", "UIC"];
                        current-index <=> root.op-keyword-index;
                    }
                }
            }
        }

        // ---- schedule points ----
        schedule-card := Rectangle {

            border-width: 1px;
            border-color: Palette.border;
            border-radius: 6px;
            background: Palette.alternate-background;

            VerticalLayout {

                padding: 10px;
                spacing: 6px;

                Text {
                    text: "Schedule points (one per line: time, max_step)";
                    font-size: 13px;
                    font-weight: 600;
                    color: Palette.foreground;
                    horizontal-alignment: left;
                    overflow: elide;
                }

                TextEdit {
                    min-height: 60px;
                    wrap: word-wrap;
                    placeholder-text: "e.g. 1n, 1n";
                    text <=> root.schedule;
                }
            }
        }

        // ---- .PRINT section ----
        print-card := Rectangle {

            border-width: 1px;
            border-color: Palette.border;
            border-radius: 6px;
            background: Palette.alternate-background;

            VerticalLayout {

                padding: 10px;
                spacing: 8px;

                CheckBox {
                    text: "Enable .PRINT output";
                    font-weight: 600;
                    checked <=> root.print-enabled;
                }

                if root.print-enabled: VerticalLayout {
                    padding-left: 24px;
                    spacing: 8px;

                    // print type selector (TRAN / TRANADJOINT)
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: LayoutAlignment.start;
                        Text {
                            text: "Print type";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        ComboBox {
                            height: 28px;
                            model: ["TRAN", "TRANADJOINT"];
                            current-index <=> root.print-type-index;
                        }
                    }

                    // wildcard voltage/current/power and lead row
                    HorizontalLayout {
                        spacing: 16px;
                        // explicit widths pin each checkbox so toggling cannot reflow the row
                        // (the cupertino style reports a narrower preferred width when checked);
                        // the fixed widths total 444px, which fits the panel width with the
                        // 16px spacing in a single row
                        CheckBox {
                            text: "All voltages V(*)";
                            width: 108px;
                            checked <=> root.print-all-nodes;
                        }

                        CheckBox {
                            text: "All currents I(*)";
                            width: 102px;
                            checked <=> root.print-all-currents;
                        }

                        CheckBox {
                            text: "Power P(*)";
                            width: 81px;
                            checked <=> root.print-power;
                        }

                        CheckBox {
                            text: "BJT leads";
                            width: 76px;
                            checked <=> root.print-bjt-leads;
                        }

                        CheckBox {
                            text: "FET leads";
                            width: 77px;
                            checked <=> root.print-fet-leads;
                        }
                    }

                    // additional variables
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Additional variables";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        LineEdit {
                            height: 28px;
                            placeholder-text: "e.g. V(out) V(in)";
                            text <=> root.print-specific-variables;
                        }
                    }

                    // format combo
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: LayoutAlignment.start;
                        Text {
                            text: "Format";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        ComboBox {
                            height: 28px;
                            model: [
                                "(default)",
                                "STD",
                                "NOINDEX",
                                "PROBE",
                                "TECPLOT",
                                "RAW",
                                "CSV",
                                "GNUPLOT",
                                "SPLOT"
                            ];
                            current-index <=> root.print-format-index;
                        }
                    }

                    // output file
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Output file";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        LineEdit {
                            height: 28px;
                            placeholder-text: "optional output file path";
                            text <=> root.print-output-file;
                        }
                    }

                    // extra print options (WIDTH=, PRECISION=, ...). The RAW
                    // format writes binary rawfiles and ignores them (Xyce RG
                    // 2.1.31 / section 8.2), so the row is hidden for RAW;
                    // RAW is index 5 of the format model below
                    if root.print-format-index != 5: HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Extra options";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        LineEdit {
                            height: 28px;
                            placeholder-text: "e.g. WIDTH=20 PRECISION=12";
                            text <=> root.print-extra-options;
                        }
                    }
                }
            }
        }

        // ---- .FFT directives ----
        fft-card := Rectangle {

            border-width: 1px;
            border-color: Palette.border;
            border-radius: 6px;
            background: Palette.alternate-background;

            VerticalLayout {

                padding: 10px;
                spacing: 6px;

                Text {
                    text: ".FFT directives (one per line)";
                    font-size: 13px;
                    font-weight: 600;
                    color: Palette.foreground;
                    horizontal-alignment: left;
                    overflow: elide;
                }

                TextEdit {
                    min-height: 60px;
                    wrap: word-wrap;
                    placeholder-text: "e.g. .FFT V(out) START=1n STOP=1u NP=1024";
                    text <=> root.fft;
                }
            }
        }

        // ---- .FOUR directives ----
        four-card := Rectangle {

            border-width: 1px;
            border-color: Palette.border;
            border-radius: 6px;
            background: Palette.alternate-background;

            VerticalLayout {

                padding: 10px;
                spacing: 6px;

                Text {
                    text: ".FOUR directives (one per line)";
                    font-size: 13px;
                    font-weight: 600;
                    color: Palette.foreground;
                    horizontal-alignment: left;
                    overflow: elide;
                }

                TextEdit {
                    min-height: 60px;
                    wrap: word-wrap;
                    placeholder-text: "e.g. .FOUR 1e6 V(out)";
                    text <=> root.four;
                }
            }
        }

        // ---- .MEASURE directives ----
        measure-card := Rectangle {

            border-width: 1px;
            border-color: Palette.border;
            border-radius: 6px;
            background: Palette.alternate-background;

            VerticalLayout {

                padding: 10px;
                spacing: 6px;

                Text {
                    text: ".MEASURE directives (one per line)";
                    font-size: 13px;
                    font-weight: 600;
                    color: Palette.foreground;
                    horizontal-alignment: left;
                    overflow: elide;
                }

                TextEdit {
                    min-height: 60px;
                    wrap: word-wrap;
                    placeholder-text: "e.g. .MEASURE TRAN vout_max MAX V(out)";
                    text <=> root.measure;
                }
            }
        }

        // ---- global settings ----
        global-card := Rectangle {

            border-width: 1px;
            border-color: Palette.border;
            border-radius: 6px;
            background: Palette.alternate-background;

            VerticalLayout {
                padding: 10px;
                spacing: 6px;

                CheckBox {
                    text: "Replace ground (GND) with 0";
                    checked <=> root.replace-ground;
                }

                Text {
                    text: "When enabled, all ground (GND) references in the netlist are replaced with the node name '0' before simulation. This is required by Xyce which uses '0' as the global ground node.";
                    font-size: 12px;
                    font-italic: true;
                    color: Palette.foreground.transparentize(0.4);
                    wrap: word-wrap;
                    horizontal-alignment: left;
                    overflow: elide;
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
        }
    }
}
