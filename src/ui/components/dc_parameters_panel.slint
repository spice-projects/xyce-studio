import {
    Button,
    CheckBox,
    ComboBox,
    LineEdit,
    Palette,
    TextEdit,
} from "std-widgets.slint";

// one row of the nested DC sweep table
export struct DcSweepRow {
    variable: string,
    start: string,
    stop: string,
    step: string,
    points: string,
    list-values: string,
}

// one editable row of the nested sweep table; text is displayed one-way
// from the host-owned model and committed back through the edited callback
component DcSweepRowEditor inherits Rectangle {

    border-width: 1px;
    border-color: Palette.border;
    border-radius: 4px;
    background: Palette.background;

    // index of this row within the sweeps model
    in property <int> sweep-index;
    // 0 = LIN, 1 = DEC, 2 = OCT, 3 = LIST, 4 = DATA
    in property <int> mode-index;
    // the row values owned by the host model
    in property <DcSweepRow> row-data;
    // a committed field edit; carries the full updated row
    callback edited(int, DcSweepRow);
    // the remove button was pressed for this row
    callback remove-requested(int);

    // scratch copy used to build the updated row on commit
    private property <DcSweepRow> pending;

    VerticalLayout {
        padding: 8px;
        spacing: 6px;

        // row header with the per-row remove action
        HorizontalLayout {
            spacing: 8px;

            Text {
                text: "Sweep \{sweep-index + 1}";
                font-size: 12px;
                font-weight: 600;
                color: Palette.foreground;
                vertical-alignment: center;
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            Button {
                text: "Remove";
                height: 24px;
                clicked => { root.remove-requested(sweep-index); }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "Variable";
                font-size: 13px;
                color: Palette.foreground;
                min-width: 120px;
                vertical-alignment: center;
                horizontal-alignment: left;
                overflow: elide;
            }

            LineEdit {
                height: 28px;
                placeholder-text: "e.g. V1";
                text: root.row-data.variable;
                edited(new-text) => {
                    root.pending = root.row-data;
                    root.pending.variable = new-text;
                    root.edited(root.sweep-index, root.pending);
                }
            }
        }

        // start value for linear and log sweeps
        if root.mode-index == 0 || root.mode-index == 1 || root.mode-index == 2: HorizontalLayout {
            spacing: 8px;
            Text {
                text: "Start";
                font-size: 13px;
                color: Palette.foreground;
                min-width: 120px;
                vertical-alignment: center;
                horizontal-alignment: left;
                overflow: elide;
            }

            LineEdit {
                height: 28px;
                placeholder-text: "start value (e.g. 0)";
                text: root.row-data.start;
                edited(new-text) => {
                    root.pending = root.row-data;
                    root.pending.start = new-text;
                    root.edited(root.sweep-index, root.pending);
                }
            }
        }

        // stop value for linear and log sweeps
        if root.mode-index == 0 || root.mode-index == 1 || root.mode-index == 2: HorizontalLayout {
            spacing: 8px;
            Text {
                text: "Stop";
                font-size: 13px;
                color: Palette.foreground;
                min-width: 120px;
                vertical-alignment: center;
                horizontal-alignment: left;
                overflow: elide;
            }

            LineEdit {
                height: 28px;
                placeholder-text: "stop value (e.g. 5)";
                text: root.row-data.stop;
                edited(new-text) => {
                    root.pending = root.row-data;
                    root.pending.stop = new-text;
                    root.edited(root.sweep-index, root.pending);
                }
            }
        }

        // step size for LIN sweeps
        if root.mode-index == 0: HorizontalLayout {
            spacing: 8px;
            Text {
                text: "Step";
                font-size: 13px;
                color: Palette.foreground;
                min-width: 120px;
                vertical-alignment: center;
                horizontal-alignment: left;
                overflow: elide;
            }

            LineEdit {
                height: 28px;
                placeholder-text: "step size (e.g. 0.1)";
                text: root.row-data.step;
                edited(new-text) => {
                    root.pending = root.row-data;
                    root.pending.step = new-text;
                    root.edited(root.sweep-index, root.pending);
                }
            }
        }

        // points for DEC/OCT log sweeps
        if root.mode-index == 1 || root.mode-index == 2: HorizontalLayout {
            spacing: 8px;
            Text {
                text: "Points";
                font-size: 13px;
                color: Palette.foreground;
                min-width: 120px;
                vertical-alignment: center;
                horizontal-alignment: left;
                overflow: elide;
            }

            LineEdit {
                height: 28px;
                placeholder-text: "points per decade/octave";
                text: root.row-data.points;
                edited(new-text) => {
                    root.pending = root.row-data;
                    root.pending.points = new-text;
                    root.edited(root.sweep-index, root.pending);
                }
            }
        }

        // space-separated values for LIST sweeps
        if root.mode-index == 3: HorizontalLayout {
            spacing: 8px;
            Text {
                text: "List values";
                font-size: 13px;
                color: Palette.foreground;
                min-width: 120px;
                vertical-alignment: center;
                horizontal-alignment: left;
                overflow: elide;
            }

            LineEdit {
                height: 28px;
                placeholder-text: "space-separated values (e.g. 0 1 2 5)";
                text: root.row-data.list-values;
                edited(new-text) => {
                    root.pending = root.row-data;
                    root.pending.list-values = new-text;
                    root.edited(root.sweep-index, root.pending);
                }
            }
        }
    }
}

export component DcParametersPanel inherits Rectangle {

    // --- sweep configuration ---
    // 0 = LIN, 1 = DEC, 2 = OCT, 3 = LIST, 4 = DATA
    in-out property <int> sweep-mode-index: 0;
    // nested sweep rows — one per sweep tuple, any count (0..N)
    in-out property <[DcSweepRow]> sweeps: [];
    // request a new blank sweep row
    callback add-sweep();
    // remove the sweep row at the given index
    callback remove-sweep(int);
    // a row's field was committed; deliver the updated row to the host
    callback sweep-row-updated(int, DcSweepRow);
    in-out property <string> data-table: "";

    // --- .MEASURE directives ---
    in-out property <string> measure: "";

    // --- .PRINT section ---
    in-out property <bool> print-enabled: false;
    // 0 = DC, 1 = HOMOTOPY
    in-out property <int> print-type-index: 0;
    in-out property <bool> print-all-nodes: false;
    in-out property <bool> print-all-currents: false;
    in-out property <bool> print-power: false;
    in-out property <bool> print-bjt-leads: false;
    in-out property <bool> print-fet-leads: false;
    in-out property <string> print-specific-variables: "";
    in-out property <int> print-format-index: 0;
    in-out property <string> print-output-file: "";
    in-out property <string> print-extra-options: "";

    // --- global settings (replace ground) ---
    in-out property <bool> replace-ground: true;

    // card look: bordered, rounded, on the control background
    border-radius: 8px;
    border-width: 1px;
    border-color: Palette.border;
    background: Palette.control-background;

    VerticalLayout {

        padding: 16px;
        spacing: 14px;

        // card header
        Text {
            text: "DC Sweep (.DC)";
            font-size: 13px;
            font-weight: 600;
            color: Palette.foreground;
            horizontal-alignment: left;
            overflow: elide;
        }

        // ---- .PRINT section ----
        print-card := Rectangle {

            border-width: 1px;
            border-color: Palette.border;
            border-radius: 6px;
            background: Palette.alternate-background;

            VerticalLayout {

                padding: 10px;
                spacing: 8px;

                CheckBox {
                    text: "Enable .PRINT output";
                    font-weight: 600;
                    checked <=> root.print-enabled;
                }

                if root.print-enabled: VerticalLayout {
                    padding-left: 24px;
                    spacing: 8px;

                    // print type selector (DC / HOMOTOPY)
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: LayoutAlignment.start;
                        Text {
                            text: "Print type";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        ComboBox {
                            height: 28px;
                            model: ["DC", "HOMOTOPY"];
                            current-index <=> root.print-type-index;
                        }
                    }

                    // wildcard voltage/current/power and lead row
                    HorizontalLayout {
                        spacing: 16px;
                        // explicit widths pin each checkbox so toggling cannot reflow the row
                        // (the cupertino style reports a narrower preferred width when checked);
                        // the fixed widths total 444px, which fits the panel width with the
                        // 16px spacing in a single row
                        CheckBox {
                            text: "All voltages V(*)";
                            width: 108px;
                            checked <=> root.print-all-nodes;
                        }

                        CheckBox {
                            text: "All currents I(*)";
                            width: 102px;
                            checked <=> root.print-all-currents;
                        }

                        CheckBox {
                            text: "Power P(*)";
                            width: 81px;
                            checked <=> root.print-power;
                        }

                        CheckBox {
                            text: "BJT leads";
                            width: 76px;
                            checked <=> root.print-bjt-leads;
                        }

                        CheckBox {
                            text: "FET leads";
                            width: 77px;
                            checked <=> root.print-fet-leads;
                        }
                    }

                    // additional variables
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Additional variables";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        LineEdit {
                            height: 28px;
                            placeholder-text: "e.g. V(out) V(in)";
                            text <=> root.print-specific-variables;
                        }
                    }

                    // format combo
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: LayoutAlignment.start;
                        Text {
                            text: "Format";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        ComboBox {
                            height: 28px;
                            model: [
                                "(default)",
                                "STD",
                                "NOINDEX",
                                "PROBE",
                                "TECPLOT",
                                "RAW",
                                "CSV",
                                "GNUPLOT",
                                "SPLOT"
                            ];
                            current-index <=> root.print-format-index;
                        }
                    }

                    // output file
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Output file";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        LineEdit {
                            height: 28px;
                            placeholder-text: "optional output file path";
                            text <=> root.print-output-file;
                        }
                    }

                    // extra print options (WIDTH=, PRECISION=, ...). The RAW
                    // format writes binary rawfiles and ignores them (Xyce RG
                    // 2.1.31 / section 8.2), so the row is hidden for RAW;
                    // RAW is index 5 of the format model below
                    if root.print-format-index != 5: HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Extra options";
                            font-size: 13px;
                            color: Palette.foreground;
                            min-width: 120px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        LineEdit {
                            height: 28px;
                            placeholder-text: "e.g. WIDTH=20 PRECISION=12";
                            text <=> root.print-extra-options;
                        }
                    }
                }
            }
        }

        // ---- sweep configuration ----
        sweep-card := Rectangle {

            border-width: 1px;
            border-color: Palette.border;
            border-radius: 6px;
            background: Palette.alternate-background;

            VerticalLayout {

                padding: 10px;
                spacing: 8px;

                // sweep mode selector
                HorizontalLayout {
                    spacing: 8px;
                    alignment: LayoutAlignment.start;
                    Text {
                        text: "Sweep mode";
                        font-size: 13px;
                        color: Palette.foreground;
                        min-width: 120px;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        overflow: elide;
                    }

                    ComboBox {
                        height: 28px;
                        model: ["LIN", "DEC", "OCT", "LIST", "DATA"];
                        current-index <=> root.sweep-mode-index;
                    }
                }

                // data table name for DATA sweeps
                if root.sweep-mode-index == 4: HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Data table";
                        font-size: 13px;
                        color: Palette.foreground;
                        min-width: 120px;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        overflow: elide;
                    }

                    LineEdit {
                        height: 28px;
                        placeholder-text: "name of the data block to sweep";
                        text <=> root.data-table;
                    }
                }

                // nested sweep table — one row card per sweep tuple, any count
                if root.sweep-mode-index != 4: VerticalLayout {
                    spacing: 8px;

                    // table header with the global add-sweep action
                    HorizontalLayout {
                        spacing: 8px;

                        Text {
                            text: "Nested sweeps";
                            font-size: 13px;
                            font-weight: 600;
                            color: Palette.foreground;
                            vertical-alignment: center;
                        }

                        // spacer pushes the add button to the trailing edge
                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        Button {
                            text: "Add Sweep";
                            height: 26px;
                            clicked => { root.add-sweep(); }
                        }
                    }

                    // empty-state hint when no sweeps are configured
                    if root.sweeps.length == 0: Text {
                        text: "No sweeps configured — use Add Sweep";
                        font-size: 12px;
                        font-italic: true;
                        color: Palette.foreground.transparentize(0.4);
                        horizontal-alignment: left;
                        overflow: elide;
                    }

                    for row[idx] in root.sweeps: DcSweepRowEditor {
                        sweep-index: idx;
                        mode-index: root.sweep-mode-index;
                        row-data: row;
                        edited(index, updated-row) => { root.sweep-row-updated(index, updated-row); }
                        remove-requested(index) => { root.remove-sweep(index); }
                    }
                }
            }
        }

        // ---- .MEASURE directives ----
        measure-card := Rectangle {

            border-width: 1px;
            border-color: Palette.border;
            border-radius: 6px;
            background: Palette.alternate-background;

            VerticalLayout {

                padding: 10px;
                spacing: 6px;

                Text {
                    text: ".MEASURE directives (one per line)";
                    font-size: 13px;
                    font-weight: 600;
                    color: Palette.foreground;
                    horizontal-alignment: left;
                    overflow: elide;
                }

                TextEdit {
                    min-height: 60px;
                    wrap: word-wrap;
                    placeholder-text: "e.g. .MEASURE DC vout_max MAX V(out)";
                    text <=> root.measure;
                }
            }
        }

        // ---- global settings ----
        global-card := Rectangle {

            border-width: 1px;
            border-color: Palette.border;
            border-radius: 6px;
            background: Palette.alternate-background;

            VerticalLayout {
                padding: 10px;
                spacing: 6px;

                CheckBox {
                    text: "Replace ground (GND) with 0";
                    checked <=> root.replace-ground;
                }

                Text {
                    text: "When enabled, all ground (GND) references in the netlist are replaced with the node name '0' before simulation. This is required by Xyce which uses '0' as the global ground node.";
                    font-size: 12px;
                    font-italic: true;
                    color: Palette.foreground.transparentize(0.4);
                    wrap: word-wrap;
                    horizontal-alignment: left;
                    overflow: elide;
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
        }
    }
}
