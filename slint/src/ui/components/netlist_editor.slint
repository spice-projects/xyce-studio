import { Palette, ScrollView } from "std-widgets.slint";

// a single coloured fragment of netlist text (one lexer token)
export struct HighlightedToken {
    text: string,
    color: color,
    // code-point column where the token starts within its line; lets the
    // token layer place glyphs on the TextInput's fractional character grid
    column-offset: int,
}

// one line of the netlist: its 1-based number and the ordered token fragments
export struct HighlightedLine {
    line-number: int,
    tokens: [HighlightedToken],
}

// NetlistEditor renders an editable netlist with per-token syntax colouring, a
// line-number gutter and a cross-platform blinking caret.  The coloured token
// layer, the caret rectangle and an alpha-transparent TextInput share the
// coordinate
// space of one ScrollView so they scroll in lockstep; the invisible TextInput
// owns all interaction (caret, selection, clipboard, IME) and drives the caret
// overlay, which stays visible on every platform (Slint derives the native
// caret colour from the selection colour on macOS and from the text colour
// elsewhere, so a transparent text colour would hide it on Linux/Windows).
export component NetlistEditor inherits Rectangle {
    // raw netlist text – two-way bound to the interactive TextInput
    in-out property <string> text: "";
    in property <bool> read-only: false;
    // highlighted lines model; rebuilt by the C++ adapter on load, on edits
    // and on theme changes
    in-out property <[HighlightedLine]> lines-model: [];
    // emitted whenever the user modifies the text
    callback edited();

    // caret position in content coordinates, tracked from the TextInput
    property <length> caret-x: 0;
    property <length> caret-y: 0;
    // blink phase; forced back on whenever the caret moves
    property <bool> caret-on: true;
    // height of one text line: the TextInput's line advance, i.e. the shared
    // font's ascent + descent.  This must match the TextInput's internal line
    // layout exactly — a Text element's own height is derived from different
    // font metrics and can differ from the TextInput's line advance by a
    // fraction of a pixel per line, which accumulates into a visible drift
    // between the selection highlight and the token layer down the document.
    property <length> line-height: input.font-metrics.ascent - input.font-metrics.descent;
    // font size shared by the gutter, the token layer and the text input;
    // every element uses the bundled "JetBrains Mono" family (imported and
    // embedded by main_window.slint) so all three platforms resolve the same
    // font with identical metrics — a generic "monospace" family or a
    // platform-only family would make the two text engines disagree
    property <length> editor-font-size: 13px;
    // horizontal advance of one character, recovered from a long probe run:
    // the TextInput's text layout positions glyphs with fractional advances,
    // while a Text element reports its width rounded up to whole logical
    // pixels; packing tokens with a HorizontalLayout would accumulate that
    // rounding into a visible offset per token, so every token is instead
    // absolutely positioned at its code-point column times this advance.  The
    // probe run is 1024 characters, so its own rounding error stays far below
    // a pixel per character.
    property <length> char-advance: width-probe.width / 1024;
    property <string> probe-128: "XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX";
    property <string> probe-256: probe-128 + probe-128;
    property <string> probe-512: probe-256 + probe-256;

    background: Palette.alternate-background;

    forward-focus: input;

    // caret blink timer; runs only while the text input is focused
    Timer {
        interval: 500ms;
        running: input.has-focus;
        triggered => { root.caret-on = !root.caret-on; }
    }

    HorizontalLayout {
        // line-number gutter; rows are offset by the content scroll position
        // (content-y is negative when scrolled down) so the numbers stay
        // aligned with the token layer while scrolling
        Rectangle {
            width: 44px;
            clip: true;

            for line in root.lines-model: Text {
                y: (line.line-number - 1) * root.line-height + scroller.content-y;
                width: parent.width - 8px;
                height: root.line-height;
                horizontal-alignment: right;
                vertical-alignment: top;
                text: line.line-number;
                color: Palette.foreground.transparentize(0.6);
                font-family: "JetBrains Mono";
                font-size: root.editor-font-size;
            }

            // gutter/content separator
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                height: parent.height;
                background: Palette.foreground.with-alpha(0.12);
            }

            // zero-size clip container that hides the probe element used to
            // measure the font's per-character advance (clipped away but
            // still laid out, so its width reflects the shared font metrics)
            Rectangle {
                width: 0px;
                height: 0px;
                clip: true;

                width-probe := Text {
                    text: root.probe-512 + root.probe-512;
                    font-family: "JetBrains Mono";
                    font-size: root.editor-font-size;
                }
            }
        }

        // shared scrollable coordinate space for the token layer, the caret
        // and the transparent text input; the stretch factor lets the editor
        // fill the space left of the gutter instead of keeping its preferred
        // width
        scroller := ScrollView {
            horizontal-stretch: 1;
            content-width: max(self.visible-width, input.preferred-width);
            content-height: max(self.visible-height, input.preferred-height);

            // layer 1: coloured token fragments, one row per netlist line; the
            // fixed row height matches the TextInput line height so the layers
            // stay aligned.  Tokens are absolutely positioned on the
            // fractional character grid instead of being laid out as a row of
            // Text elements, whose rounded widths would accumulate a drift
            // against the TextInput's own text.
            VerticalLayout {
                alignment: start;

                for line in root.lines-model: Rectangle {
                    height: root.line-height;

                    for token in line.tokens: Text {
                        x: token.column-offset * root.char-advance;
                        y: 0;
                        height: parent.height;
                        text: token.text;
                        color: token.color;
                        font-family: "JetBrains Mono";
                        font-size: root.editor-font-size;
                    }
                }
            }

            // layer 2: blinking caret rectangle tracking the TextInput cursor
            caret-rect := Rectangle {
                x: root.caret-x;
                y: root.caret-y;
                width: 2px;
                height: root.line-height;
                background: Palette.foreground;
                visible: input.has-focus && root.caret-on;
            }

            // layer 3: interactive text input owning the caret, selection,
            // clipboard and IME; the text colour uses alpha 1 because a fully
            // transparent colour (alpha 0) makes the renderer skip the whole
            // text input draw pass, which would also hide the selection
            // highlight; alpha 1 is invisible to the eye
            input := TextInput {
                single-line: false;
                wrap: no-wrap;
                color: #00000001;
                read-only: root.read-only;
                vertical-alignment: top;
                horizontal-alignment: left;
                font-family: "JetBrains Mono";
                font-size: root.editor-font-size;
                // tinted selection highlight so the token colours stay visible
                // under it; the selected glyphs are drawn transparent for the
                // same reason
                selection-background-color: Palette.foreground.transparentize(0.75);
                selection-foreground-color: transparent;
                // page height for page-up/page-down scrolling
                page-height: scroller.visible-height;
                text <=> root.text;

                changed has-focus => {
                    // restart the blink phase from the visible state
                    root.caret-on = true;
                }

                edited => { root.edited(); }

                cursor-position-changed(cpos) => {
                    // track the caret for the overlay rectangle
                    root.caret-x = cpos.x;
                    root.caret-y = cpos.y;
                    // keep the caret visible while it moves
                    root.caret-on = true;
                    // scroll the caret into view horizontally
                    if (root.caret-x + scroller.content-x < 0px) {
                        scroller.content-x = min(0px, max(scroller.visible-width - self.width, -root.caret-x));
                    } else if (root.caret-x + scroller.content-x > scroller.visible-width) {
                        scroller.content-x = min(0px, max(scroller.visible-width - self.width, scroller.visible-width - root.caret-x));
                    }
                    // scroll the caret into view vertically
                    if (root.caret-y + scroller.content-y < 0px) {
                        scroller.content-y = min(0px, max(scroller.visible-height - self.height, -root.caret-y));
                    } else if (root.caret-y + scroller.content-y > scroller.visible-height - root.line-height) {
                        scroller.content-y = min(0px, max(scroller.visible-height - self.height, scroller.visible-height - root.caret-y - root.line-height));
                    }
                }
            }
        }
    }
}
