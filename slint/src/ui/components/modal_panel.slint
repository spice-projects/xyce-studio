// shared base component for all inline modal panels. provides a consistent
// title bar with close button, a dimmed backdrop that absorbs pointer input,
// and OK/Cancel footer buttons. The FocusScope root captures keyboard focus
// via init => self.focus() and accepts all key events so Escape (dismiss)
// and other keys never reach the underlying content — except Tab/Backtab,
// which are rejected so the built-in tab focus traversal can move between
// the dialog's input controls. implementing panels inherit from this
// component, set the title/card-width/card-height properties, and provide
// their form content as @children.
import { Palette, ScrollView, StandardButton } from "std-widgets.slint";

export component ModalPanel inherits FocusScope {
    // dialog title shown in the title bar
    in property <string> title: "";
    // card dimensions — specific to each implementing panel
    in property <length> card-width: 540px;
    in property <length> card-height: 320px;
    // validation feedback shown above the footer
    in property <bool> show-error: false;
    in property <string> error-message: "";

    callback accepted;
    callback dismissed;

    // grab focus on creation so Escape and other keys are captured before
    // they can reach the underlying content
    init => { self.focus(); }

    // intercept key events at the root level; accept all keys so they do
    // not propagate to the underlying window — except Tab/Backtab, which are
    // rejected so slint's built-in tab focus traversal can move focus between
    // the dialog's input controls
    key-pressed(event) => {
        if event.text == Key.Escape {
            root.dismissed();
            accept
        } else if event.text == Key.Tab || event.text == Key.Backtab {
            reject
        } else {
            accept
        }
    }

    // dimmed backdrop: a child Rectangle provides the visual overlay and a
    // TouchArea absorbs pointer events so clicks don't reach the underlying content
    Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: Palette.background.transparentize(0.65);

        TouchArea {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
        }
    }

    // centered card with window-like styling: solid background, border,
    // rounded corners, and a drop-shadow that gives the card an elevated
    // appearance on top of the dimmed backdrop
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.card-width;
        height: root.card-height;
        background: Palette.background;
        border-color: Palette.border;
        border-width: 1px;
        border-radius: 8px;
        drop-shadow-color: #00000040;
        drop-shadow-offset-y: 6px;
        drop-shadow-blur: 16px;

        VerticalLayout {
            padding: 0;
            spacing: 0;

            // title bar: a slightly subdued stripe at the top with the
             // dialog title on the left and a close (X) button on the right
             Rectangle {
                height: 40px;
                background: Palette.background.transparentize(0.92);

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;

                    Text {
                        text: root.title;
                        font-size: 13px;
                        font-weight: 600;
                        color: Palette.foreground;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }
                }

                // close button (X) — uses the KiCad cancel icon; the
                // unicode ✕ (U+2715) used in other panels does not
                // render in the default font. positioned at the right edge
                // of the title bar, vertically centered
                close := Rectangle {
                    x: parent.width - 38px;
                    y: (parent.height - 24px) / 2;
                    width: 24px;
                    height: 24px;
                    border-radius: 4px;
                    background: cb.pressed
                        ? Palette.foreground.transparentize(0.82)
                        : cb.has-hover
                        ? Palette.foreground.transparentize(0.92)
                        : transparent;
                    animate background {
                        duration: 100ms;
                        easing: ease-out;
                    }

                    Image {
                        x: (parent.width - 12px) / 2;
                        y: (parent.height - 12px) / 2;
                        width: 12px;
                        height: 12px;
                        source: @image-url("../kicad-icons/cancel_24.png");
                        image-fit: contain;
                    }

                    cb := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.dismissed(); }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Palette.border;
            }

            // content area — implementing panel content goes here via @children
            VerticalLayout {
                vertical-stretch: 1;
                padding: 14px;
                spacing: 10px;

                @children

                if root.show-error: Text {
                    text: root.error-message;
                    font-size: 12px;
                    color: #cc0000;
                }
            }

            Rectangle {
                height: 1px;
                background: Palette.border;
            }

            Rectangle {
                height: 42px;
                background: Palette.background.transparentize(0.96);

                HorizontalLayout {
                    y: (parent.height - 28px) / 2;
                    height: 28px;
                    padding-left: 14px;
                    padding-right: 14px;

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    StandardButton {
                        kind: cancel;
                        clicked => { root.dismissed(); }
                    }

                    Rectangle {
                        width: 8px;
                    }

                    StandardButton {
                        kind: ok;
                        primary: true;
                        clicked => { root.accepted(); }
                    }
                }
            }
        }
    }
}
