      "default-features": false
    },
    {
      "name": "nativefiledialog-extended",
      "version>=": "1.3.0"
    },
    {
      "name": "nng",
      "default-features": false,
      "version>=": "1.8.0"
    },
    {
      "name": "pocketfft",
