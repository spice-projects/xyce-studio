// the FFT setup dialog, which selects the expressions and the transform parameters
component FftDialog {
    signal filter_changed(string text);
    signal accepted();
    signal dismissed();

    Column {
        spacing: 0px;

        Column {
            vertical_align: Align.stretch;
            padding: 14px;
            spacing: 10px;

            Label {
                text: "Select the expressions and the transform parameters:";
                font_size: 13px;
                font_weight: Weight.semibold;
            }

            TextField {
                id: fft_filter;
                placeholder: "Filter expressions...";
                on_changed: {
                    filter_changed(value);
                }
            }

            SizedBox {
                id: fft_breadcrumb_host;
                height: 18px;
                horizontal_align: Align.stretch;
            }

            Panel {
                vertical_align: Align.stretch;
                padding: 0px;
                spacing: 0px;
                background: #00000000;
                border_width: 0px;

                ScrollView {
                    vertical_align: Align.stretch;
                    scrollbar: Scrollbar.as_needed;

                    Grid {
                        id: fft_grid;
                        columns: 3;
                        spacing: 8px;
                        horizontal_align: Align.stretch;
                    }
                }
            }

            SizedBox {
                id: fft_legend_host;
                height: 20px;
                horizontal_align: Align.stretch;
            }

            Column {
                id: fft_params;
                spacing: 8px;
                horizontal_align: Align.stretch;
            }
        }

        Padding {
            padding: Insets { left: 14px, right: 14px };

            Label {
                id: fft_error;
                text: "";
                font_size: 12px;
                foreground: #CC0000;
            }
        }

        SizedBox {
            height: 8px;
        }

        // the bordered panel marks the dialog action area
        Panel {
            padding: 8px;
            spacing: 8px;
            corner_radius: 0px;
            border_width: 1px;
            horizontal_align: Align.stretch;

            Row {
                spacing: 8px;
                horizontal_align: Align.end;

                SizedBox {
                    width: 80px;
                    height: 28px;

                    Button {
                        id: fft_cancel;
                        text: "Cancel";
                        cancel: true;
                        on_clicked: {
                            dismissed();
                        }
                    }
                }

                SizedBox {
                    width: 80px;
                    height: 28px;

                    Button {
                        id: fft_ok;
                        text: "OK";
                        default: true;
                        on_clicked: {
                            accepted();
                        }
                    }
                }
            }
        }
    }
}
