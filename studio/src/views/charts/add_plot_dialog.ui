// the select-plots dialog content, which the shell window hosts as a modal dialog

component AddPlotDialog {
    // whether the chart accepts a custom expression, which a smith chart refuses
    in property<bool> allow_custom: true;
    // whether the custom expression was refused
    in property<bool> show_error: false;
    // the message a refused custom expression produced
    in property<string> error_message: "";
    // the filter the text field edits
    inout property<string> filter_text: "";
    // the custom expression the text field edits
    inout property<string> custom_text: "";

    signal filter_changed(string text);
    signal custom_added();
    signal accepted();
    signal dismissed();

    Column {
        spacing: 0px;

        // scrollable plot selection content
        Column {
            vertical_align: Align.stretch;
            padding: 14px;
            spacing: 10px;

            Label {
                text: "Select one or more expressions to plot:";
                font_size: 13px;
                font_weight: Weight.semibold;
            }

            TextField {
                id: add_plot_filter;
                placeholder: "Filter expressions...";
                value: filter_text;
                on_changed: {
                    filter_text = value;
                    filter_changed(value);
                }
            }

            SizedBox {
                id: add_plot_breadcrumb_host;
                height: 18px;
                horizontal_align: Align.stretch;
            }

            Panel {
                padding: 0px;
                spacing: 0px;
                background: #00000000;
                border_width: 0px;
                vertical_align: Align.stretch;

                ScrollView {
                    vertical_align: Align.stretch;
                    scrollbar: Scrollbar.as_needed;

                    Grid {
                        id: add_plot_grid;
                        columns: 3;
                        spacing: 8px;
                        horizontal_align: Align.stretch;
                    }
                }
            }

            if allow_custom {
                Row {
                    spacing: 8px;
                    vertical_align: Align.center;

                    Label {
                        text: "Expression:";
                        font_size: 13px;
                    }

                    TextField {
                        id: add_plot_custom;
                        placeholder: "e.g. V(net1) / I(R1)";
                        value: custom_text;
                        horizontal_align: Align.stretch;
                        on_changed: {
                            custom_text = value;
                        }
                    }

                    Button {
                        id: add_plot_add;
                        text: "Add";
                        on_clicked: {
                            custom_added();
                        }
                    }
                }
            }

            if show_error {
                Label {
                    id: add_plot_error;
                    text: error_message;
                    font_size: 12px;
                    foreground: #CC0000;
                }
            }

            SizedBox {
                id: add_plot_legend_host;
                height: 16px;
                horizontal_align: Align.stretch;
            }
        }

        SizedBox {
            height: 1px;

            Panel {
                padding: 0px;
                background: #00000010;
                border_width: 0px;
                corner_radius: 0px;
            }
        }

        // footer actions
        SizedBox {
            height: 42px;

            Panel {
                padding: 7px;
                spacing: 0px;
                background: #00000000;
                border_width: 0px;
                corner_radius: 0px;

                Row {
                    spacing: 8px;

                    Label {
                        text: "";
                        horizontal_align: Align.stretch;
                    }

                    Button {
                        id: add_plot_cancel;
                        text: "Cancel";
                        cancel: true;
                        on_clicked: {
                            dismissed();
                        }
                    }

                    Button {
                        id: add_plot_ok;
                        text: "OK";
                        default: true;
                        on_clicked: {
                            accepted();
                        }
                    }
                }
            }
        }
    }
}
