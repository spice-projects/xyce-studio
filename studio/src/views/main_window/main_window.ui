// the shell of the Albor frontend; the charts view arrives in a later slice
component MainWindow {
    // toolbar actions the presenter drives
    signal open_clicked();
    signal save_clicked();
    signal plugin_settings_clicked();
    // the configure action opens the simulation parameters dialog
    signal configure_simulation_clicked();
    // the run action starts the simulation and becomes the stop action while it runs
    signal run_clicked();
    // the exit action closes the shell window
    signal exit_clicked();
    // the output action reveals the simulation output panel again
    signal output_clicked();

    // raised while the user edits the netlist text, which marks the netlist dirty
    signal netlist_edited();
    // the user closed the output panel
    signal output_close_clicked();
    // the user copied the selection or the whole output log
    signal output_copy_clicked();

    // the netlist text the editor edits, fed back to the host on every edit
    inout property<string> netlist_text: "";
    // whether the editor refuses edits, which the connected KiCad slice drives
    in property<bool> netlist_read_only: false;
    // the styled ranges over the netlist, one per highlighted token
    in property<vector<TextDecoration>> netlist_decorations: [];
    // the toolbar enablement, which the action states refresh
    in property<bool> open_enabled: true;
    in property<bool> save_enabled: false;
    // the run action only lights up when a netlist is loaded
    in property<bool> run_enabled: false;
    // the configure action needs a netlist to describe an analysis
    in property<bool> configure_enabled: false;
    // whether a simulation is live, which swaps the run action for the stop action
    in property<bool> simulation_running: false;
    // the one line status the shell reports
    in property<string> status: "Ready";

    // the simulation output panel holds the live console log of the running or
    // finished simulation; the panel remounts on every show and the host owns
    // its content through the properties below
    in property<bool> output_visible: false;
    // whether the toolbar output action can reveal a log the shell still holds
    in property<bool> output_available: false;
    // the whole log as one string, one line per row
    in property<string> output_text: "";
    // the styled ranges over the log, one per warning or error line
    in property<vector<TextDecoration>> output_decorations: [];
    // the warning badge text and visibility, which the header shows when the log carries one
    in property<string> output_warning_text: "";
    in property<bool> output_warning_visible: false;
    // the error badge text and visibility, which the header shows when the log carries one
    in property<string> output_error_text: "";
    in property<bool> output_error_visible: false;
    // the scroll offset the log pins to; a value past the content end clamps
    // into the range, which is what keeps the viewport on the last line
    in property<float> output_pin_offset: 1000000.0;

    // the live run progress the status bar shows while a simulation is live
    in property<bool> progress_visible: false;
    // whether Xyce reported a completion percentage, which makes the bar determinate
    in property<bool> progress_determinate: false;
    // the completion fraction the determinate bar fills to
    in property<float> progress_value: 0.0;
    // the phase, percentage, estimate and counts folded into one run
    in property<string> progress_text: "";

    Column {
        spacing: 0px;

        ToolBar {
            padding: 12px;
            spacing: 2px;
            corner_radius: 0px;
            vertical_align: Align.start;

            // icon-only actions announce their tooltip, which is their accessible name
            Button {
                id: main_open;
                tooltip: "Open";
                icon: @image("icons/directory_open_48.png");
                icon_size: 20px;
                disabled: !open_enabled;
                on_clicked: {
                    open_clicked();
                }
            }

            Button {
                id: main_save;
                tooltip: "Save";
                icon: @image("icons/save_48.png");
                icon_size: 20px;
                disabled: !save_enabled;
                on_clicked: {
                    save_clicked();
                }
            }

            Button {
                id: main_output;
                tooltip: "Sim Output";
                icon: @image("icons/sim_command_48.png");
                icon_size: 20px;
                disabled: !output_available;
                on_clicked: {
                    output_clicked();
                }
            }

            // the run action is replaced by the stop action while a simulation
            // lives, which also swaps the icon the plate draws
            if !simulation_running {
                Button {
                    id: main_run;
                    text: "Run";
                    icon: @image("icons/sim_run_48.png");
                    icon_size: 16px;
                    disabled: !run_enabled;
                    on_clicked: {
                        run_clicked();
                    }
                }
            }

            if simulation_running {
                Button {
                    id: main_run;
                    text: "Stop";
                    icon: @image("icons/cancel_48.png");
                    icon_size: 16px;
                    on_clicked: {
                        run_clicked();
                    }
                }
            }

            Button {
                id: main_configure;
                tooltip: "Simulation Parameters";
                icon: @image("icons/sim_tune_48.png");
                icon_size: 20px;
                disabled: !configure_enabled;
                on_clicked: {
                    configure_simulation_clicked();
                }
            }

            Button {
                id: main_plugin_settings;
                tooltip: "Plugin Settings";
                icon: @image("icons/preference_48.png");
                icon_size: 20px;
                on_clicked: {
                    plugin_settings_clicked();
                }
            }

            Button {
                id: main_exit;
                tooltip: "Exit";
                icon: @image("icons/exit_48.png");
                icon_size: 20px;
                on_clicked: {
                    exit_clicked();
                }
            }
        }

        // the editor is the content surface; it scrolls its own viewport once
        // the column caps its height
        TextField {
            id: netlist_editor;
            multiline: true;
            value: netlist_text;
            read_only: netlist_read_only;
            decorations: netlist_decorations;
            font_family: "JetBrains Mono";
            font_size: 13px;
            horizontal_align: Align.stretch;
            vertical_align: Align.stretch;
            on_changed: {
                netlist_text = value;
                netlist_edited();
            }
        }

        // the output panel docks over the lower part of the shell while a
        // simulation runs or its log holds content
        if output_visible {
            Panel {
                id: output_panel;
                padding: 0px;
                spacing: 0px;
                corner_radius: 0px;
                vertical_align: Align.start;

                Padding {
                    padding: 8px;

                    Row {
                        spacing: 8px;

                        Label {
                            id: output_title;
                            text: "Simulation Output";
                            font_size: 13px;
                            vertical_align: Align.center;
                        }

                        // the warning badge carries the reported count in the warning amber
                        Label {
                            id: output_warning_badge;
                            text: output_warning_text;
                            visible: output_warning_visible;
                            foreground: #d9a441;
                            vertical_align: Align.center;
                        }

                        // the error badge carries the reported count in the error red
                        Label {
                            id: output_error_badge;
                            text: output_error_text;
                            visible: output_error_visible;
                            foreground: #e05b4b;
                            vertical_align: Align.center;
                        }

                        // the stretch spacer pushes the actions to the far end
                        Label {
                            horizontal_align: Align.stretch;
                        }

                        Button {
                            id: output_copy;
                            text: "Copy";
                            on_clicked: {
                                output_copy_clicked();
                            }
                        }

                        Button {
                            id: output_close;
                            icon: @image("icons/cancel_16.png");
                            icon_size: 12px;
                            on_clicked: {
                                output_close_clicked();
                            }
                        }
                    }
                }

                ScrollView {
                    id: output_scroll;
                    // the viewport is the fixed extent the log reads through,
                    // which is what pins the panel while the content scrolls
                    viewport_height: 152px;

                    // the offset pins the log to its bottom: the presented
                    // offset clamps into the content range, which is what keeps
                    // the viewport on the last line
                    offset: output_pin_offset;

                    TextField {
                        id: output_log;
                        multiline: true;
                        read_only: true;
                        value: output_text;
                        decorations: output_decorations;
                        font_family: "JetBrains Mono";
                        font_size: 13px;
                        content_align: Align.start;
                    }
                }
            }
        }

        Panel {
            padding: 4px;
            corner_radius: 0px;
            vertical_align: Align.start;

            Row {
                spacing: 12px;

                Label {
                    id: main_status;
                    text: status;
                    vertical_align: Align.center;
                }

                // the stretch spacer pushes the run progress to the far end
                Label {
                    horizontal_align: Align.stretch;
                }

                if progress_visible {
                    Row {
                        spacing: 8px;
                        vertical_align: Align.center;

                        // the bar sweeps while the analysis reports no percentage, and fills once it does
                        ProgressBar {
                            id: main_progress_bar;
                            indeterminate: !progress_determinate;
                            value: progress_value;
                            vertical_align: Align.center;
                        }

                        Label {
                            id: main_progress;
                            text: progress_text;
                            vertical_align: Align.center;
                        }
                    }
                }
            }
        }
    }
}
