// the options dialog, which edits the simulation-agnostic .OPTIONS packages
component OptionsDialog {
    signal accepted();
    signal dismissed();

    Column {
        spacing: 0px;

        Padding {
            padding: 14px;
            vertical_align: Align.stretch;

            Column {
                spacing: 10px;
                vertical_align: Align.stretch;

                Label {
                    text: "Xyce Options";
                    font_size: 16px;
                    font_weight: Weight.semibold;
                }

                Label {
                    id: options_hint;
                    text: "Valued options are written to the netlist, empty fields omit the option, and the flag entry keeps a bare flag";
                    font_size: 12px;
                }

                // the package cards are built by the host from the option catalog
                Panel {
                    vertical_align: Align.stretch;
                    padding: 0px;
                    spacing: 0px;
                    background: #00000000;
                    border_width: 0px;

                    ScrollView {
                        vertical_align: Align.stretch;
                        scrollbar: Scrollbar.as_needed;

                        Column {
                            id: options_cards;
                            vertical_align: Align.start;
                            spacing: 10px;
                            horizontal_align: Align.stretch;
                        }
                    }
                }
            }
        }

        SizedBox {
            height: 8px;
        }

        // the bordered panel marks the dialog action area
        Panel {
            padding: 8px;
            spacing: 8px;
            corner_radius: 0px;
            border_width: 1px;
            horizontal_align: Align.stretch;

            Row {
                spacing: 8px;
                horizontal_align: Align.end;

                SizedBox {
                    width: 80px;
                    height: 28px;

                    Button {
                        id: options_cancel;
                        text: "Cancel";
                        cancel: true;
                        on_clicked: {
                            dismissed();
                        }
                    }
                }

                SizedBox {
                    width: 80px;
                    height: 28px;

                    Button {
                        id: options_ok;
                        text: "OK";
                        default: true;
                        on_clicked: {
                            accepted();
                        }
                    }
                }
            }
        }
    }
}
