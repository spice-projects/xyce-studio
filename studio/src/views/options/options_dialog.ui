// the options dialog, which edits the simulation-agnostic .OPTIONS packages
component OptionsDialog {
    signal accepted();
    signal dismissed();

    Column {
        padding: 14px;
        spacing: 10px;

        Label {
            text: "Xyce Options";
            font_size: 16px;
            font_weight: Weight.semibold;
        }

        Label {
            id: options_hint;
            text: "Valued options are written to the netlist, empty fields omit the option, and the flag entry keeps a bare flag";
            font_size: 12px;
        }

        // the package cards are built by the host from the option catalog
        Panel {
            vertical_align: Align.stretch;
            padding: 0px;
            spacing: 0px;
            background: #00000000;
            border_width: 0px;

            ScrollView {
                vertical_align: Align.stretch;
                scrollbar: Scrollbar.as_needed;

                Column {
                    id: options_cards;
                    vertical_align: Align.start;
                    spacing: 10px;
                    horizontal_align: Align.stretch;
                }
            }
        }

        Row {
            spacing: 8px;
            horizontal_align: Align.end;

            Button {
                id: options_cancel;
                text: "Cancel";
                cancel: true;
                on_clicked: {
                    dismissed();
                }
            }

            Button {
                id: options_ok;
                text: "OK";
                default: true;
                on_clicked: {
                    accepted();
                }
            }
        }
    }
}
