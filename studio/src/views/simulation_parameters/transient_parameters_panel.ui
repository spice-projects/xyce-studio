// the transient analysis panel, which edits one .TRAN directive

import simulation_ui;

import "form_label.ui";

import "ground_replace_row.ui";
import "ic_section.ui";
import "measure_section.ui";
import "option_package_card.ui";
import "pce_section.ui";
import "print_section.ui";

component TransientParametersPanel {
    // the transient state the dialog owns
    inout property<TranUi> state;
    // the print state the dialog owns
    in property<PrintUi> print;
    // the PCE state the dialog owns
    inout property<PceUi> pce;
    // the PCE print state the dialog owns
    in property<PrintUi> pce_print;
    // the PCE parameter rows the dialog owns
    in property<vector<PceRow>> pce_rows: [];
    // whether the PCE table has no row, which shows its hint
    in property<bool> pce_rows_empty: true;
    // the transient state the user changed
    signal state_changed(TranUi value);
    // the print state the user changed
    signal print_changed(PrintUi value);
    // the PCE state the user changed
    signal pce_changed(PceUi value);
    // the PCE print state the user changed
    signal pce_print_changed(PrintUi value);
    // the managed option rows the dialog owns
    in property<vector<OptionRow>> timeint_rows: [];
    in property<vector<OptionRow>> nonlin_tran_rows: [];
    in property<vector<OptionRow>> loca_rows: [];
    in property<vector<OptionRow>> fft_rows: [];
    in property<vector<OptionRow>> output_rows: [];
    // the user changed an option row in its text editor
    signal option_row_edited(int package, string key, OptionRow row);
    // the user picked a combo entry for an option row
    signal option_choice_selected(int package, string key, int index);
    // the user asked for a new PCE parameter row
    signal pce_add_row();
    // the user asked to remove the PCE row with this key
    signal pce_remove_row(string key);
    // the user changed the PCE row with this key
    signal pce_row_edited(string key, PceRow row);

    Column {
        spacing: 10px;

        Label {
            text: "Transient Analysis (.TRAN)";
            font_weight: Weight.semibold;
            font_size: 13px;
        }

        ScrollView {
            id: simulation_parameters_page;
            scrollbar: Scrollbar.as_needed;
            vertical_align: Align.stretch;

            Column {
                spacing: 10px;

                Panel {
                    vertical_align: Align.start;

                    Column {
                        spacing: 8px;
                        Row {
                            spacing: 8px;
                            vertical_align: Align.center;
                            FormLabel {
                                id: simulation_tran_initial_step_caption;
                                text: "Initial step";
                            }
                            SizedBox {
                                width: 300px;
                                TextField {
                                    font_size: 13px;
                                    id: simulation_tran_initial_step;
                                    value: state.initial_step;
                                    placeholder: "initial time step (e.g. 1n)";
                                    horizontal_align: Align.stretch;
                                    on_changed: {
                                        state.initial_step = value;
                                        state_changed(state);
                                    }
                                }
                            }
                        }
                        Row {
                            spacing: 8px;
                            vertical_align: Align.center;
                            FormLabel {
                                id: simulation_tran_final_time_caption;
                                text: "Final time";
                            }
                            SizedBox {
                                width: 300px;
                                TextField {
                                    font_size: 13px;
                                    id: simulation_tran_final_time;
                                    value: state.final_time;
                                    placeholder: "simulation end time (e.g. 1u)";
                                    horizontal_align: Align.stretch;
                                    on_changed: {
                                        state.final_time = value;
                                        state_changed(state);
                                    }
                                }
                            }
                        }
                        Row {
                            spacing: 8px;
                            vertical_align: Align.center;
                            FormLabel {
                                id: simulation_tran_start_time_caption;
                                text: "Start time";
                            }
                            SizedBox {
                                width: 300px;
                                TextField {
                                    font_size: 13px;
                                    id: simulation_tran_start_time;
                                    value: state.start_time;
                                    placeholder: "optional start time (e.g. 0)";
                                    horizontal_align: Align.stretch;
                                    on_changed: {
                                        state.start_time = value;
                                        state_changed(state);
                                    }
                                }
                            }
                        }
                        Row {
                            spacing: 8px;
                            vertical_align: Align.center;
                            FormLabel {
                                id: simulation_tran_step_ceiling_caption;
                                text: "Max time step";
                            }
                            SizedBox {
                                width: 300px;
                                TextField {
                                    font_size: 13px;
                                    id: simulation_tran_step_ceiling;
                                    value: state.step_ceiling;
                                    placeholder: "optional step ceiling";
                                    horizontal_align: Align.stretch;
                                    on_changed: {
                                        state.step_ceiling = value;
                                        state_changed(state);
                                    }
                                }
                            }
                        }
                        Row {
                            spacing: 8px;
                            vertical_align: Align.center;
                            FormLabel {
                                id: simulation_tran_op_keyword_caption;
                                text: "OP keyword";
                            }
                            SizedBox {
                                width: 300px;
                                ComboBox {
                                    horizontal_align: Align.stretch;
                                    id: simulation_tran_op_keyword;
                                    items: ["(None)", "NOOP", "UIC"];
                                    selected: state.op_keyword_index;
                                    on_selection_changed: {
                                        state.op_keyword_index = index;
                                        state_changed(state);
                                    }
                                }
                            }
                        }
                    }
                }

                Panel {
                    vertical_align: Align.start;

                    Column {
                        spacing: 6px;

                        Label {
                            font_size: 13px;
                            text: "Schedule points (one per line: time, max_step)";
                            font_weight: Weight.semibold;
                        }

                        SizedBox {
                            width: 508px;
                            height: 64px;
                            horizontal_align: Align.start;

                            TextField {
                                font_size: 13px;
                                id: simulation_tran_schedule;
                                value: state.schedule;
                                placeholder: "e.g. 1n, 1n";
                                multiline: true;
                                horizontal_align: Align.stretch;
                                on_changed: {
                                    state.schedule = value;
                                    state_changed(state);
                                }
                            }
                        }
                    }
                }

                PrintSection {
                    level: 1;
                    state: print;
                    type_items: ["TRAN", "TRANADJOINT"];
                    on_state_changed: {
                        print_changed(value);
                    }
                }

                Panel {
                    vertical_align: Align.start;

                    Column {
                        spacing: 6px;

                        Label {
                            font_size: 13px;
                            text: ".FFT directives (one per line)";
                            font_weight: Weight.semibold;
                        }

                        SizedBox {
                            width: 508px;
                            height: 64px;
                            horizontal_align: Align.start;

                            TextField {
                                font_size: 13px;
                                id: simulation_tran_fft;
                                value: state.fft;
                                placeholder: "e.g. .FFT V(out) START=1n STOP=1u NP=1024";
                                multiline: true;
                                horizontal_align: Align.stretch;
                                on_changed: {
                                    state.fft = value;
                                    state_changed(state);
                                }
                            }
                        }
                    }
                }

                Panel {
                    vertical_align: Align.start;

                    Column {
                        spacing: 6px;

                        Label {
                            font_size: 13px;
                            text: ".FOUR directives (one per line)";
                            font_weight: Weight.semibold;
                        }

                        SizedBox {
                            width: 508px;
                            height: 64px;
                            horizontal_align: Align.start;

                            TextField {
                                font_size: 13px;
                                id: simulation_tran_four;
                                value: state.four;
                                placeholder: "e.g. .FOUR 1e6 V(out)";
                                multiline: true;
                                horizontal_align: Align.stretch;
                                on_changed: {
                                    state.four = value;
                                    state_changed(state);
                                }
                            }
                        }
                    }
                }

                MeasureSection {
                    text: state.measure;
                    placeholder: "e.g. .MEASURE TRAN vout_max MAX V(out)";
                    on_text_changed: {
                        state.measure = value;
                        state_changed(state);
                    }
                }

                IcSection {
                    text: state.initial_conditions;
                    on_text_changed: {
                        state.initial_conditions = value;
                        state_changed(state);
                    }
                }

                GroundReplaceRow {
                    id: simulation_tran_replace_ground;
                    checked: state.replace_ground;
                    on_toggled: {
                        state.replace_ground = value;
                        state_changed(state);
                    }
                }

                PceSection {
                    state: pce;
                    print: pce_print;
                    rows: pce_rows;
                    rows_empty: pce_rows_empty;
                    on_state_changed: {
                        pce_changed(value);
                    }
                    on_print_changed: {
                        pce_print_changed(value);
                    }
                    on_add_row: {
                        pce_add_row();
                    }
                    on_remove_row: {
                        pce_remove_row(key);
                    }
                    on_row_edited: {
                        pce_row_edited(key, row);
                    }
                }

                OptionPackageCard {
                    title: ".OPTIONS TIMEINT package";
                    rows: timeint_rows;
                    on_row_edited: {
                        option_row_edited(1, key, row);
                    }
                    on_choice_selected: {
                        option_choice_selected(1, key, index);
                    }
                }

                OptionPackageCard {
                    title: ".OPTIONS NONLIN-TRAN package";
                    rows: nonlin_tran_rows;
                    on_row_edited: {
                        option_row_edited(3, key, row);
                    }
                    on_choice_selected: {
                        option_choice_selected(3, key, index);
                    }
                }

                OptionPackageCard {
                    title: ".OPTIONS LOCA package";
                    rows: loca_rows;
                    on_row_edited: {
                        option_row_edited(6, key, row);
                    }
                    on_choice_selected: {
                        option_choice_selected(6, key, index);
                    }
                }

                OptionPackageCard {
                    title: ".OPTIONS FFT package";
                    rows: fft_rows;
                    on_row_edited: {
                        option_row_edited(11, key, row);
                    }
                    on_choice_selected: {
                        option_choice_selected(11, key, index);
                    }
                }

                OptionPackageCard {
                    title: ".OPTIONS OUTPUT package";
                    rows: output_rows;
                    on_row_edited: {
                        option_row_edited(12, key, row);
                    }
                    on_choice_selected: {
                        option_choice_selected(12, key, index);
                    }
                }
            }
        }
    }
}
