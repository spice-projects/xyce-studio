// the AC sweep analysis panel, which edits one .AC directive

import simulation_ui;

import "form_label.ui";

import "ground_replace_row.ui";
import "measure_section.ui";
import "option_package_card.ui";
import "print_section.ui";
import "sweep_mode_row.ui";

component AcParametersPanel {
    // the AC sweep state the dialog owns
    inout property<AcUi> state;
    // the print state the dialog owns
    in property<PrintUi> print;
    // the AC sweep state the user changed
    signal state_changed(AcUi value);
    // the print state the user changed
    signal print_changed(PrintUi value);
    // the LINSOL-AC option rows the dialog owns
    in property<vector<OptionRow>> linsol_ac_rows: [];
    // the user changed an option row in its text editor
    signal option_row_edited(int package, string key, OptionRow row);
    // the user picked a combo entry for an option row
    signal option_choice_selected(int package, string key, int index);

    Column {
        spacing: 10px;

        Label {
            text: "AC Analysis (.AC)";
            font_weight: Weight.semibold;
            font_size: 13px;
        }

        ScrollView {
            scrollbar: Scrollbar.as_needed;
            vertical_align: Align.stretch;

            Column {
                spacing: 10px;

                Panel {
                    vertical_align: Align.start;

                    Column {
                        spacing: 8px;

                        Row {
                            vertical_align: Align.center;
                            spacing: 8px;

                            FormLabel {
                                text: "Sweep mode";
                            }
                            ComboBox {
                                horizontal_align: Align.stretch;
                                items: ["LIN", "DEC", "OCT", "DATA"];
                                selected: state.sweep_mode_index;
                                on_selection_changed: {
                                    state.sweep_mode_index = index;
                                    state_changed(state);
                                }
                            }
                        }

                        if state.sweep_mode_index != 3 {
                            Row {
                                vertical_align: Align.center;
                                spacing: 8px;

                                FormLabel {
                                    id: simulation_ac_points_caption;
                                    text: "Points";
                                }
                                TextField {
                                    font_size: 13px;
                                    id: simulation_ac_points;
                                    value: state.points;
                                    placeholder: "number of points per decade";
                                    horizontal_align: Align.stretch;
                                    on_changed: {
                                        state.points = value;
                                        state_changed(state);
                                    }
                                }
                            }
                        }
                        if state.sweep_mode_index != 3 {
                            Row {
                                vertical_align: Align.center;
                                spacing: 8px;

                                FormLabel {
                                    id: simulation_ac_start_caption;
                                    text: "Start";
                                }
                                TextField {
                                    font_size: 13px;
                                    id: simulation_ac_start;
                                    value: state.start;
                                    placeholder: "start frequency (e.g. 1k)";
                                    horizontal_align: Align.stretch;
                                    on_changed: {
                                        state.start = value;
                                        state_changed(state);
                                    }
                                }
                            }
                        }
                        if state.sweep_mode_index != 3 {
                            Row {
                                vertical_align: Align.center;
                                spacing: 8px;

                                FormLabel {
                                    id: simulation_ac_end_caption;
                                    text: "End";
                                }
                                TextField {
                                    font_size: 13px;
                                    id: simulation_ac_end;
                                    value: state.end;
                                    placeholder: "stop frequency (e.g. 100MEG)";
                                    horizontal_align: Align.stretch;
                                    on_changed: {
                                        state.end = value;
                                        state_changed(state);
                                    }
                                }
                            }
                        }

                        if state.sweep_mode_index == 3 {
                            Row {
                                vertical_align: Align.center;
                                spacing: 8px;

                                FormLabel {
                                    id: simulation_ac_table_caption;
                                    text: "Data table";
                                }
                                TextField {
                                    font_size: 13px;
                                    id: simulation_ac_table;
                                    value: state.data_table;
                                    placeholder: "name of the data block to sweep";
                                    horizontal_align: Align.stretch;
                                    on_changed: {
                                        state.data_table = value;
                                        state_changed(state);
                                    }
                                }
                            }
                        }
                    }
                }

                MeasureSection {
                    text: state.measure;
                    placeholder: "e.g. .MEASURE AC vout_max MAX V(out)";
                    on_text_changed: {
                        state.measure = value;
                        state_changed(state);
                    }
                }

                PrintSection {
                    level: 1;
                    state: print;
                    type_items: ["AC", "AC_IC"];
                    show_power: false;
                    show_bjt: false;
                    show_fet: false;
                    on_state_changed: {
                        print_changed(value);
                    }
                }

                GroundReplaceRow {
                    id: simulation_ac_replace_ground;
                    checked: state.replace_ground;
                    on_toggled: {
                        state.replace_ground = value;
                        state_changed(state);
                    }
                }

                OptionPackageCard {
                    title: ".OPTIONS LINSOL-AC package";
                    rows: linsol_ac_rows;
                    on_row_edited: {
                        option_row_edited(5, key, row);
                    }
                    on_choice_selected: {
                        option_choice_selected(5, key, index);
                    }
                }
            }
        }
    }
}
