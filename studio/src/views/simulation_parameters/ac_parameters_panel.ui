// the AC sweep analysis panel, which edits one .AC directive

import "ground_replace_row.ui";
import "sweep_mode_row.ui";

component AcParametersPanel {
    // the AC sweep fields the dialog owns, where the mode is LIN, DEC, OCT or DATA
    in property<int> mode: 0;
    in property<string> points: "";
    in property<string> start: "";
    in property<string> end: "";
    in property<string> table: "";
    in property<bool> replace_ground: true;

    // one signal per field, because a composed component cannot write the host property
    signal mode_changed(int value);
    signal points_changed(string value);
    signal start_changed(string value);
    signal end_changed(string value);
    signal table_changed(string value);
    signal replace_ground_changed(bool value);

    Column {
        spacing: 10px;

        Label {
            text: "AC Analysis (.AC)";
            font_size: 13px;
        }

        SweepModeRow {
            id: simulation_ac_mode;
            items: ["LIN", "DEC", "OCT", "DATA"];
            selected: mode;
            on_selection_changed: {
                mode_changed(value);
            }
        }

        if mode != 3 {
            Column {
                spacing: 10px;

                Row {
                    spacing: 8px;

                    Label {
                        id: simulation_ac_points_caption;
                        text: "Points";
                        vertical_align: Align.center;
                    }

                    TextField {
                        id: simulation_ac_points;
                        value: points;
                        placeholder: "points per sweep";
                        horizontal_align: Align.stretch;
                        on_changed: {
                            points_changed(value);
                        }
                    }
                }

                Row {
                    spacing: 8px;

                    Label {
                        id: simulation_ac_start_caption;
                        text: "Start";
                        vertical_align: Align.center;
                    }

                    TextField {
                        id: simulation_ac_start;
                        value: start;
                        placeholder: "start frequency";
                        horizontal_align: Align.stretch;
                        on_changed: {
                            start_changed(value);
                        }
                    }
                }

                Row {
                    spacing: 8px;

                    Label {
                        id: simulation_ac_end_caption;
                        text: "End";
                        vertical_align: Align.center;
                    }

                    TextField {
                        id: simulation_ac_end;
                        value: end;
                        placeholder: "stop frequency";
                        horizontal_align: Align.stretch;
                        on_changed: {
                            end_changed(value);
                        }
                    }
                }
            }
        }

        if mode == 3 {
            Row {
                spacing: 8px;

                Label {
                    id: simulation_ac_table_caption;
                    text: "Data table";
                    vertical_align: Align.center;
                }

                TextField {
                    id: simulation_ac_table;
                    value: table;
                    placeholder: "table name";
                    horizontal_align: Align.stretch;
                    on_changed: {
                        table_changed(value);
                    }
                }
            }
        }

        GroundReplaceRow {
            id: simulation_ac_replace_ground;
            checked: replace_ground;
            on_toggled: {
                replace_ground_changed(value);
            }
        }
    }
}
