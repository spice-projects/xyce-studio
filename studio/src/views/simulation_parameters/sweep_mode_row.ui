// the sweep mode row DC, AC and the other sweep analyses share

import "form_label.ui";

component SweepModeRow {
    // the caption the row shows
    in property<string> label: "Sweep mode";
    // the modes in combo order
    in property<vector<string>> items: [];
    // the selected mode index the host analysis owns
    in property<int> selected: 0;
    // the index the user moved the combo to
    signal selection_changed(int value);

    Column {
        spacing: 8px;
        Row {
            spacing: 8px;
            vertical_align: Align.center;
            FormLabel {
                text: label;
            }
            ComboBox {
                horizontal_align: Align.stretch;
                items: items;
                selected: selected;
                on_selection_changed: {
                    selection_changed(index);
                }
            }
        }
    }
}
