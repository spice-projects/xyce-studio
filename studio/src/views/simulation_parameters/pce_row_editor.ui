// one editable row of the PCE uncertain-parameter table

import simulation_ui;

import "form_label.ui";

component PceRowEditor {
    // the row the host list owns
    inout property<PceRow> row_data;
    // the row the user changed
    signal edited(string key, PceRow updated);
    // the user removed this row
    signal remove_requested(string key);

    Panel {
        padding: 8px;
        corner_radius: 4px;
        background: #FFFFFF33;
        border_width: 1px;
        vertical_align: Align.start;

        Column {
            spacing: 6px;

            Row {
                spacing: 8px;

                Label {
                    text: "Parameter " + row_data.key;
                    font_size: 12px;
                    font_weight: Weight.semibold;
                }

                Label {
                    font_size: 13px;
                    horizontal_align: Align.stretch;
                }

                Button {
                    text: "Remove";
                    on_clicked: {
                        remove_requested(row_data.key);
                    }
                }
            }

            Row {
                spacing: 8px;
                vertical_align: Align.center;
                FormLabel {
                    text: "Parameter";
                    min_width: 180px;
                }
                SizedBox {
                    width: 300px;
                    TextField {
                        font_size: 13px;
                        value: row_data.name;
                        placeholder: "e.g. R1";
                        horizontal_align: Align.stretch;
                        on_changed: {
                            row_data.name = value;
                            edited(row_data.key, row_data);
                        }
                    }
                }
            }

            Row {
                spacing: 8px;
                vertical_align: Align.center;
                FormLabel {
                    text: "Distribution";
                    min_width: 180px;
                }
                SizedBox {
                    width: 300px;
                    ComboBox {
                        horizontal_align: Align.stretch;
                        items: ["uniform", "normal", "gamma"];
                        selected: row_data.type_index;
                        on_selection_changed: {
                            row_data.type_index = index;
                            edited(row_data.key, row_data);
                        }
                    }
                }
            }

            Row {
                spacing: 8px;
                vertical_align: Align.center;

                if row_data.type_index == 0 {
                    FormLabel {
                        text: "Lower bound";
                        min_width: 180px;
                    }
                }
                if row_data.type_index == 1 {
                    FormLabel {
                        text: "Mean";
                        min_width: 180px;
                    }
                }
                if row_data.type_index == 2 {
                    FormLabel {
                        text: "Alpha";
                        min_width: 180px;
                    }
                }

                SizedBox {
                    width: 300px;
                    TextField {
                        font_size: 13px;
                        value: row_data.first_value;
                        placeholder: "e.g. 1K";
                        horizontal_align: Align.stretch;
                        on_changed: {
                            row_data.first_value = value;
                            edited(row_data.key, row_data);
                        }
                    }
                }
            }

            Row {
                spacing: 8px;
                vertical_align: Align.center;

                if row_data.type_index == 0 {
                    FormLabel {
                        text: "Upper bound";
                        min_width: 180px;
                    }
                }
                if row_data.type_index == 1 {
                    FormLabel {
                        text: "Std deviation";
                        min_width: 180px;
                    }
                }
                if row_data.type_index == 2 {
                    FormLabel {
                        text: "Beta";
                        min_width: 180px;
                    }
                }

                SizedBox {
                    width: 300px;
                    TextField {
                        font_size: 13px;
                        value: row_data.second_value;
                        placeholder: "e.g. 5K";
                        horizontal_align: Align.stretch;
                        on_changed: {
                            row_data.second_value = value;
                            edited(row_data.key, row_data);
                        }
                    }
                }
            }
        }
    }
}
