// one editable row of the nested DC sweep table

import simulation_ui;

import "form_label.ui";

component DcSweepRowEditor {
    // the sweep mode the row follows, where the mode hides the fields it cannot use
    in property<int> mode: 0;
    // the row the host list owns
    inout property<DcSweepRow> row_data;
    // the row the user changed
    signal edited(string key, DcSweepRow updated);
    // the user removed this row
    signal remove_requested(string key);

    Panel {
        padding: 8px;
        corner_radius: 4px;
        background: #00000010;
        border_width: 1px;
        vertical_align: Align.start;

        Column {
            spacing: 6px;

            Row {
                spacing: 8px;

                Label {
                    text: "Sweep " + row_data.key;
                font_weight: Weight.semibold;
                    font_size: 12px;
                }

                Label {
                    horizontal_align: Align.stretch;
                }

                Button {
                    text: "Remove";
                    on_clicked: {
                        remove_requested(row_data.key);
                    }
                }
            }

            Column {
                spacing: 8px;
                Row {
                    spacing: 8px;
                    vertical_align: Align.center;
                FormLabel {
                    text: "Variable";
                }
                TextField {
                    value: row_data.variable;
                    placeholder: "e.g. V1";
                    horizontal_align: Align.stretch;
                    on_changed: {
                        row_data.variable = value;
                        edited(row_data.key, row_data);
                    }
                }
                }
            }

            if mode == 0 || mode == 1 || mode == 2 {
                Column {
                    spacing: 8px;
                    Row {
                        spacing: 8px;
                        vertical_align: Align.center;
                    FormLabel {
                        text: "Start";
                    }
                    TextField {
                        value: row_data.start;
                        placeholder: "start value (e.g. 0)";
                        horizontal_align: Align.stretch;
                        on_changed: {
                            row_data.start = value;
                            edited(row_data.key, row_data);
                        }
                    }
                    }
                    Row {
                        spacing: 8px;
                        vertical_align: Align.center;
                    FormLabel {
                        text: "Stop";
                    }
                    TextField {
                        value: row_data.stop;
                        placeholder: "stop value (e.g. 5)";
                        horizontal_align: Align.stretch;
                        on_changed: {
                            row_data.stop = value;
                            edited(row_data.key, row_data);
                        }
                    }
                    }
                }
            }

            if mode == 0 {
                Column {
                    spacing: 8px;
                    Row {
                        spacing: 8px;
                        vertical_align: Align.center;
                    FormLabel {
                        text: "Step";
                    }
                    TextField {
                        value: row_data.step;
                        placeholder: "step size (e.g. 0.1)";
                        horizontal_align: Align.stretch;
                        on_changed: {
                            row_data.step = value;
                            edited(row_data.key, row_data);
                        }
                    }
                    }
                }
            }

            if mode == 1 || mode == 2 {
                Column {
                    spacing: 8px;
                    Row {
                        spacing: 8px;
                        vertical_align: Align.center;
                    FormLabel {
                        text: "Points";
                    }
                    TextField {
                        value: row_data.points;
                        placeholder: "points per decade/octave";
                        horizontal_align: Align.stretch;
                        on_changed: {
                            row_data.points = value;
                            edited(row_data.key, row_data);
                        }
                    }
                    }
                }
            }

            if mode == 3 {
                Column {
                    spacing: 8px;
                    Row {
                        spacing: 8px;
                        vertical_align: Align.center;
                    FormLabel {
                        text: "List values";
                    }
                    TextField {
                        value: row_data.list_values;
                        placeholder: "space-separated values (e.g. 0 1 2 5)";
                        horizontal_align: Align.stretch;
                        on_changed: {
                            row_data.list_values = value;
                            edited(row_data.key, row_data);
                        }
                    }
                    }
                }
            }
        }
    }
}
