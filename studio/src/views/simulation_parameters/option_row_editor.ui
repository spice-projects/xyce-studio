// one editable row of an .OPTIONS package card

import simulation_ui;

import "form_label.ui";

component OptionRowEditor {
    // the row the host list owns
    inout property<OptionRow> row_data;
    // the row the user changed in its text editor
    signal edited(string key, OptionRow updated);
    // the combo entry the user picked, which the host maps back to a value
    signal choice_selected(string key, int index);

    Row {
        spacing: 8px;
        vertical_align: Align.center;

        FormLabel {
            text: row_data.key;
        }

        SizedBox {
            width: 300px;

            if row_data.choice_index >= 0 {
                ComboBox {
                    horizontal_align: Align.stretch;
                    items: row_data.choices;
                    selected: row_data.choice_index;
                    on_selection_changed: {
                        choice_selected(row_data.key, index);
                    }
                }
            }

            if row_data.choice_index < 0 {
                TextField {
                    value: row_data.value;
                    placeholder: row_data.default_value;
                    font_size: 13px;
                    horizontal_align: Align.stretch;
                    on_changed: {
                        row_data.value = value;
                        edited(row_data.key, row_data);
                    }
                }
            }
        }
    }
}
