// the DC sweep analysis panel, which edits one .DC directive

import simulation_ui;

import "dc_sweep_row_editor.ui";
import "form_label.ui";

import "ground_replace_row.ui";
import "ic_section.ui";
import "measure_section.ui";
import "option_package_card.ui";
import "pce_section.ui";
import "print_section.ui";
import "sweep_mode_row.ui";

component DcParametersPanel {
    // the DC sweep state the dialog owns
    inout property<DcUi> state;
    // the print state the dialog owns
    in property<PrintUi> print;
    // the PCE state the dialog owns
    inout property<PceUi> pce;
    // the PCE print state the dialog owns
    in property<PrintUi> pce_print;
    // the PCE parameter rows the dialog owns
    in property<vector<PceRow>> pce_rows: [];
    // whether the PCE table has no row, which shows its hint
    in property<bool> pce_rows_empty: true;
    // the DC sweep state the user changed
    signal state_changed(DcUi value);
    // the print state the user changed
    signal print_changed(PrintUi value);
    // the NONLIN option rows the dialog owns
    in property<vector<OptionRow>> nonlin_rows: [];
    // the LOCA option rows the dialog owns
    in property<vector<OptionRow>> loca_rows: [];
    // whether the sweep table has no row, which shows the reference hint
    in property<bool> sweeps_empty: true;
    // the user changed an option row in its text editor
    signal option_row_edited(int package, string key, OptionRow row);
    // the user picked a combo entry for an option row
    signal option_choice_selected(int package, string key, int index);
    // the nested sweep rows the dialog owns
    in property<vector<DcSweepRow>> sweeps: [];
    // the user asked for a new sweep row
    signal add_sweep();
    // the user asked to remove the row with this key
    signal remove_sweep(string key);
    // the user changed the row with this key
    signal sweep_edited(string key, DcSweepRow row);
    // the PCE state the user changed
    signal pce_changed(PceUi value);
    // the PCE print state the user changed
    signal pce_print_changed(PrintUi value);
    // the user asked for a new PCE parameter row
    signal pce_add_row();
    // the user asked to remove the PCE row with this key
    signal pce_remove_row(string key);
    // the user changed the PCE row with this key
    signal pce_row_edited(string key, PceRow row);

    Column {
        spacing: 10px;
        horizontal_align: Align.start;

        Label {
            text: "DC Sweep (.DC)";
            font_weight: Weight.semibold;
            font_size: 13px;
        }

        ScrollView {
            scrollbar: Scrollbar.as_needed;
            vertical_align: Align.stretch;

            Column {
                spacing: 10px;

                PrintSection {
                    level: 1;
                    state: print;
                    type_items: ["DC", "HOMOTOPY"];
                    on_state_changed: {
                        print_changed(value);
                    }
                }

                Panel {
                    vertical_align: Align.start;

                    Column {
                        spacing: 8px;

                        SweepModeRow {
                            id: simulation_dc_mode;
                            items: ["LIN", "DEC", "OCT", "LIST", "DATA"];
                            selected: state.sweep_mode_index;
                            on_selection_changed: {
                                state.sweep_mode_index = value;
                                state_changed(state);
                            }
                        }

                        if state.sweep_mode_index == 4 {
                            Row {
                                spacing: 8px;
                                vertical_align: Align.center;
                                FormLabel {
                                    id: simulation_dc_table_caption;
                                    text: "Data table";
                                }
                                SizedBox {
                                    width: 300px;
                                    TextField {
                                        font_size: 13px;
                                        id: simulation_dc_table;
                                        value: state.data_table;
                                        placeholder: "name of the data block to sweep";
                                        horizontal_align: Align.stretch;
                                        on_changed: {
                                            state.data_table = value;
                                            state_changed(state);
                                        }
                                    }
                                }
                            }
                        }

                        if state.sweep_mode_index != 4 {
                            Column {
                                spacing: 8px;

                                Row {
                                    spacing: 8px;

                                    Label {
                                        font_size: 13px;
                                        text: "Nested sweeps";
                                        font_weight: Weight.semibold;
                                        vertical_align: Align.center;
                                    }

                                    Label {
                                        font_size: 13px;
                                        horizontal_align: Align.stretch;
                                    }

                                    Button {
                                        id: simulation_dc_add_sweep;
                                        text: "Add Sweep";
                                        on_clicked: {
                                            add_sweep();
                                        }
                                    }
                                }

                                Label {
                                    visible: sweeps_empty;
                                    font_size: 12px;
                                    text: "No sweeps configured — use Add Sweep";
                                    foreground: #888888;
                                }

                                Repeat(row in sweeps) {
                                    DcSweepRowEditor {
                                        mode: state.sweep_mode_index;
                                        row_data: row;
                                        on_edited: {
                                            sweep_edited(key, updated);
                                        }
                                        on_remove_requested: {
                                            remove_sweep(key);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                MeasureSection {
                    text: state.measure;
                    placeholder: "e.g. .MEASURE DC vout_max MAX V(out)";
                    on_text_changed: {
                        state.measure = value;
                        state_changed(state);
                    }
                }

                IcSection {
                    text: state.initial_conditions;
                    on_text_changed: {
                        state.initial_conditions = value;
                        state_changed(state);
                    }
                }

                GroundReplaceRow {
                    id: simulation_dc_replace_ground;
                    checked: state.replace_ground;
                    on_toggled: {
                        state.replace_ground = value;
                        state_changed(state);
                    }
                }

                PceSection {
                    state: pce;
                    print: pce_print;
                    rows: pce_rows;
                    rows_empty: pce_rows_empty;
                    on_state_changed: {
                        pce_changed(value);
                    }
                    on_print_changed: {
                        pce_print_changed(value);
                    }
                    on_add_row: {
                        pce_add_row();
                    }
                    on_remove_row: {
                        pce_remove_row(key);
                    }
                    on_row_edited: {
                        pce_row_edited(key, row);
                    }
                }

                OptionPackageCard {
                    title: ".OPTIONS NONLIN package";
                    rows: nonlin_rows;
                    on_row_edited: {
                        option_row_edited(2, key, row);
                    }
                    on_choice_selected: {
                        option_choice_selected(2, key, index);
                    }
                }

                OptionPackageCard {
                    title: ".OPTIONS LOCA package";
                    rows: loca_rows;
                    on_row_edited: {
                        option_row_edited(6, key, row);
                    }
                    on_choice_selected: {
                        option_choice_selected(6, key, index);
                    }
                }
            }
        }
    }
}
