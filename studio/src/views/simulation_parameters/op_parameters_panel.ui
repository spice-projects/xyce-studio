// the operating point analysis panel, which edits one .OP directive

import simulation_ui;

import "form_label.ui";

import "ground_replace_row.ui";
import "ic_section.ui";
import "option_package_card.ui";
import "print_section.ui";

component OpParametersPanel {
    // the operating point state the dialog owns
    inout property<OpUi> state;
    // the print state the dialog owns
    in property<PrintUi> print;
    // the operating point state the user changed
    signal state_changed(OpUi value);
    // the print state the user changed
    signal print_changed(PrintUi value);
    // the NONLIN option rows the dialog owns
    in property<vector<OptionRow>> nonlin_rows: [];
    // the user changed an option row in its text editor
    signal option_row_edited(int package, string key, OptionRow row);
    // the user picked a combo entry for an option row
    signal option_choice_selected(int package, string key, int index);

    Column {
        spacing: 10px;

        Label {
            text: "Operating Point Analysis (.OP)";
            font_weight: Weight.semibold;
            font_size: 13px;
        }

        ScrollView {
            scrollbar: Scrollbar.as_needed;
            vertical_align: Align.stretch;

            Column {
                spacing: 10px;

                PrintSection {
                    level: 1;
                    state: print;
                    show_type: false;
                    on_state_changed: {
                        print_changed(value);
                    }
                }

                Panel {
                    vertical_align: Align.start;

                    Column {
                        spacing: 8px;

                        Row {
                            spacing: 6px;

                            CheckBox {
                                checked: state.save_enabled;
                                on_toggled: {
                                    state.save_enabled = checked;
                                    state_changed(state);
                                }
                            }

                            Label {
                                font_size: 13px;
                                text: "Enable .SAVE operating point";
                                font_weight: Weight.semibold;
                                vertical_align: Align.center;
                            }
                        }

                        if state.save_enabled {
                            Column {
                                spacing: 8px;
                                Row {
                                    spacing: 8px;
                                    vertical_align: Align.center;
                                    ComboBox {
                                        horizontal_align: Align.stretch;
                                        items: ["Save as .NODESET", "Save as .IC"];
                                        selected: state.save_type_index;
                                        on_selection_changed: {
                                            state.save_type_index = index;
                                            state_changed(state);
                                        }
                                    }
                                }
                                Row {
                                    spacing: 8px;
                                    vertical_align: Align.center;
                                    FormLabel {
                                        text: "Save file";
                                    }
                                    TextField {
                                        font_size: 13px;
                                        value: state.save_file;
                                        placeholder: "optional output file path";
                                        horizontal_align: Align.stretch;
                                        on_changed: {
                                            state.save_file = value;
                                            state_changed(state);
                                        }
                                    }
                                }
                                Row {
                                    spacing: 8px;
                                    vertical_align: Align.center;
                                    FormLabel {
                                        text: "Level";
                                    }
                                    ComboBox {
                                        horizontal_align: Align.stretch;
                                        items: ["(default)", "all", "none"];
                                        selected: state.save_level_index;
                                        on_selection_changed: {
                                            state.save_level_index = index;
                                            state_changed(state);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                Panel {
                    vertical_align: Align.start;

                    Column {
                        spacing: 6px;

                        Label {
                            font_size: 13px;
                            text: "Convergence Hints (.NODESET)";
                            font_weight: Weight.semibold;
                        }

                        Label {
                            text: "Initial voltage/current guesses to help DC convergence";
                            font_size: 12px;
                        }

                        TextField {
                            font_size: 13px;
                            id: simulation_op_nodeset;
                            value: state.nodeset;
                            placeholder: "e.g. V(1)=5.0 V(2)=3.3";
                            horizontal_align: Align.stretch;
                            on_changed: {
                                state.nodeset = value;
                                state_changed(state);
                            }
                        }
                    }
                }

                IcSection {
                    text: state.initial_conditions;
                    description: "Initial conditions for operating-point analysis";
                    on_text_changed: {
                        state.initial_conditions = value;
                        state_changed(state);
                    }
                }

                GroundReplaceRow {
                    id: simulation_op_replace_ground;
                    checked: state.replace_ground;
                    on_toggled: {
                        state.replace_ground = value;
                        state_changed(state);
                    }
                }

                OptionPackageCard {
                    title: ".OPTIONS NONLIN package";
                    rows: nonlin_rows;
                    on_row_edited: {
                        option_row_edited(2, key, row);
                    }
                    on_choice_selected: {
                        option_choice_selected(2, key, index);
                    }
                }
            }
        }
    }
}
