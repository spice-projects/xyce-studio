// the linear analysis panel, which edits one .LIN directive

import simulation_ui;

import "form_label.ui";

import "ground_replace_row.ui";
import "print_section.ui";
import "sweep_mode_row.ui";

component LinParametersPanel {
    // the linear analysis state the dialog owns
    inout property<LinUi> state;
    // the print state the dialog owns
    in property<PrintUi> print;
    // the linear analysis state the user changed
    signal state_changed(LinUi value);
    // the print state the user changed
    signal print_changed(PrintUi value);

    Column {
        spacing: 10px;

        Label {
            text: "Linear Analysis (.LIN)";
                font_weight: Weight.semibold;
            font_size: 13px;
        }

        PrintSection {
            state: print;
            type_items: ["AC"];
            show_power: false;
            show_bjt: false;
            show_fet: false;
            on_state_changed: {
                print_changed(value);
            }
        }

        Panel {
            padding: 10px;
            corner_radius: 6px;
            background: #00000010;
            border_width: 1px;
            vertical_align: Align.start;

            Column {
                spacing: 8px;

                Row {
                    spacing: 6px;

                    CheckBox {
                        checked: state.sparcalc;
                        on_toggled: {
                            state.sparcalc = checked;
                            state_changed(state);
                        }
                    }

                    Label {
                        text: "Enable SPARCALC";
                font_weight: Weight.semibold;
                        vertical_align: Align.center;
                    }
                }

                if state.sparcalc {
                    Column {
                        spacing: 8px;
                        Row {
                            spacing: 8px;
                            vertical_align: Align.center;
                        FormLabel {
                            text: "Format";
                        }
                        ComboBox {
                            id: simulation_lin_format;
                            items: ["TOUCHSTONE2", "TOUCHSTONE"];
                            selected: state.format_index;
                            on_selection_changed: {
                                state.format_index = index;
                                state_changed(state);
                            }
                        }
                        }
                        Row {
                            spacing: 8px;
                            vertical_align: Align.center;
                        FormLabel {
                            text: "Type";
                        }
                        ComboBox {
                            id: simulation_lin_type;
                            items: ["S", "Y", "Z"];
                            selected: state.lintype_index;
                            on_selection_changed: {
                                state.lintype_index = index;
                                state_changed(state);
                            }
                        }
                        }
                        Row {
                            spacing: 8px;
                            vertical_align: Align.center;
                        FormLabel {
                            text: "Data format";
                        }
                        ComboBox {
                            id: simulation_lin_dataformat;
                            items: ["RI", "MA", "DB"];
                            selected: state.dataformat_index;
                            on_selection_changed: {
                                state.dataformat_index = index;
                                state_changed(state);
                            }
                        }
                        }
                        Row {
                            spacing: 8px;
                            vertical_align: Align.center;
                        FormLabel {
                            text: "Output file";
                        }
                        TextField {
                            id: simulation_lin_file;
                            value: state.file;
                            placeholder: "touchstone output file path";
                            horizontal_align: Align.stretch;
                            on_changed: {
                                state.file = value;
                                state_changed(state);
                            }
                        }
                        }
                        Row {
                            spacing: 8px;
                            vertical_align: Align.center;
                        FormLabel {
                            text: "Width";
                        }
                        TextField {
                            id: simulation_lin_width;
                            value: state.output_width;
                            placeholder: "width in characters";
                            horizontal_align: Align.stretch;
                            on_changed: {
                                state.output_width = value;
                                state_changed(state);
                            }
                        }
                        }
                        Row {
                            spacing: 8px;
                            vertical_align: Align.center;
                        FormLabel {
                            text: "Precision";
                        }
                        TextField {
                            id: simulation_lin_precision;
                            value: state.precision;
                            placeholder: "decimal precision";
                            horizontal_align: Align.stretch;
                            on_changed: {
                                state.precision = value;
                                state_changed(state);
                            }
                        }
                        }
                    }
                }
            }
        }

        Panel {
            padding: 10px;
            corner_radius: 6px;
            background: #00000010;
            border_width: 1px;
            vertical_align: Align.start;

            Column {
                spacing: 8px;

                Label {
                    text: "AC Sweep";
                font_weight: Weight.semibold;
                    font_size: 13px;
                }

                SweepModeRow {
                    id: simulation_lin_mode;
                    items: ["LIN", "DEC", "OCT", "DATA"];
                    selected: state.sweep_mode_index;
                    on_selection_changed: {
                        state.sweep_mode_index = value;
                        state_changed(state);
                    }
                }

                if state.sweep_mode_index != 3 {
                    Column {
                        spacing: 8px;
                        Row {
                            spacing: 8px;
                            vertical_align: Align.center;
                        FormLabel {
                            text: "Points";
                        }
                        TextField {
                            id: simulation_lin_points;
                            value: state.points;
                            placeholder: "number of points per decade";
                            horizontal_align: Align.stretch;
                            on_changed: {
                                state.points = value;
                                state_changed(state);
                            }
                        }
                        }
                        Row {
                            spacing: 8px;
                            vertical_align: Align.center;
                        FormLabel {
                            text: "Start";
                        }
                        TextField {
                            id: simulation_lin_start;
                            value: state.start;
                            placeholder: "start frequency (e.g. 1k)";
                            horizontal_align: Align.stretch;
                            on_changed: {
                                state.start = value;
                                state_changed(state);
                            }
                        }
                        }
                        Row {
                            spacing: 8px;
                            vertical_align: Align.center;
                        FormLabel {
                            text: "End";
                        }
                        TextField {
                            id: simulation_lin_end;
                            value: state.end;
                            placeholder: "stop frequency (e.g. 100MEG)";
                            horizontal_align: Align.stretch;
                            on_changed: {
                                state.end = value;
                                state_changed(state);
                            }
                        }
                        }
                    }
                }

                if state.sweep_mode_index == 3 {
                    Column {
                        spacing: 8px;
                        Row {
                            spacing: 8px;
                            vertical_align: Align.center;
                        FormLabel {
                            text: "Data table";
                        }
                        TextField {
                            id: simulation_lin_table;
                            value: state.data_table;
                            placeholder: "name of the data block to sweep";
                            horizontal_align: Align.stretch;
                            on_changed: {
                                state.data_table = value;
                                state_changed(state);
                            }
                        }
                        }
                    }
                }
            }
        }

        GroundReplaceRow {
            id: simulation_lin_replace_ground;
            checked: state.replace_ground;
            on_toggled: {
                state.replace_ground = value;
                state_changed(state);
            }
        }
    }
}
