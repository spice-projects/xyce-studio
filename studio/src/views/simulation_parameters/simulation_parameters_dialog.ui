// the native simulation parameters dialog, which edits the analysis directives a run uses

import simulation_ui;

import "ac_parameters_panel.ui";
import "dc_parameters_panel.ui";
import "hb_parameters_panel.ui";
import "lin_parameters_panel.ui";
import "noise_parameters_panel.ui";
import "op_parameters_panel.ui";
import "transient_parameters_panel.ui";

component SimulationParametersDialog {
    // the selected analysis tab, in the order OP, DC, TRAN, AC, NOISE, HB, LIN
    inout property<int> selected_tab: 0;

    // the transient analysis state
    inout property<TranUi> tran;
    inout property<PrintUi> tran_print;

    // the DC sweep state and its nested sweep rows
    inout property<DcUi> dc;
    in property<vector<DcSweepRow>> dc_sweeps: [];
    inout property<PrintUi> dc_print;

    // the AC sweep state
    inout property<AcUi> ac;
    inout property<PrintUi> ac_print;

    // the operating point state
    inout property<OpUi> op;
    inout property<PrintUi> op_print;

    // the noise analysis state
    inout property<NoiseUi> noise;
    inout property<PrintUi> noise_print;

    // the harmonic balance state
    inout property<HbUi> hb;
    inout property<PrintUi> hb_print;

    // the linear analysis state
    inout property<LinUi> lin;
    inout property<PrintUi> lin_print;

    // the PCE state the transient and DC panels share
    inout property<PceUi> pce;
    in property<vector<PceRow>> pce_rows: [];
    // whether the PCE table has no row, which shows its hint
    in property<bool> pce_rows_empty: true;
    inout property<PrintUi> pce_print;

    // whether the DC sweep table has no row, which shows its hint
    in property<bool> dc_sweeps_empty: true;

    // the managed .OPTIONS package rows the analysis panels edit
    in property<vector<OptionRow>> timeint_rows: [];
    in property<vector<OptionRow>> nonlin_rows: [];
    in property<vector<OptionRow>> nonlin_tran_rows: [];
    in property<vector<OptionRow>> linsol_ac_rows: [];
    in property<vector<OptionRow>> loca_rows: [];
    in property<vector<OptionRow>> fft_rows: [];
    in property<vector<OptionRow>> output_rows: [];

    // the validation message, whose row keeps its place in the layout
    in property<string> error_message: "";

    signal accepted();
    signal dismissed();
    // the user asked for a new DC sweep row
    signal add_sweep();
    // the user asked to remove the DC sweep row with this key
    signal remove_sweep(string key);
    // the user changed the DC sweep row with this key
    signal sweep_edited(string key, DcSweepRow row);
    // the user asked for a new PCE parameter row
    signal pce_add_row();
    // the user asked to remove the PCE row with this key
    signal pce_remove_row(string key);
    // the user changed the PCE row with this key
    signal pce_row_edited(string key, PceRow row);
    // the user changed an option row of the package at this index in its text editor
    signal option_row_edited(int package, string key, OptionRow row);
    // the user picked a combo entry for an option row of the package at this index
    signal option_choice_selected(int package, string key, int index);

    Column {
        padding: 16px;
        spacing: 12px;

        Row {
            spacing: 8px;

            Label {
                text: "Xyce Simulation";
                font_weight: Weight.semibold;
                font_size: 13px;
                vertical_align: Align.center;
            }

            Label {
                font_size: 13px;
                horizontal_align: Align.stretch;
            }
        }

        Row {
            spacing: 0px;
            horizontal_align: Align.stretch;
            vertical_align: Align.stretch;

            Panel {
                padding: 0px;
                corner_radius: 0px;
                border_width: 0px;
                vertical_align: Align.start;

                Column {
                    spacing: 4px;

                    Label {
                        text: "DC";
                        font_size: 11px;
                        font_weight: Weight.semibold;
                        foreground: #888888;
                    }

                    if selected_tab == 0 {
                        Button {
                            id: simulation_tab_op;
                            text: ".OP";
                            text_align: Align.start;
                            horizontal_align: Align.stretch;
                            border_width: 0px;
                            background: #2F6FED33;
                            on_clicked: {
                                selected_tab = 0;
                            }
                        }
                    }

                    if selected_tab != 0 {
                        Button {
                            id: simulation_tab_op;
                            text: ".OP";
                            text_align: Align.start;
                            horizontal_align: Align.stretch;
                            border_width: 0px;
                            background: #00000000;
                            on_clicked: {
                                selected_tab = 0;
                            }
                        }
                    }

                    if selected_tab == 1 {
                        Button {
                            id: simulation_tab_dc;
                            text: ".DC";
                            text_align: Align.start;
                            horizontal_align: Align.stretch;
                            border_width: 0px;
                            background: #2F6FED33;
                            on_clicked: {
                                selected_tab = 1;
                            }
                        }
                    }

                    if selected_tab != 1 {
                        Button {
                            id: simulation_tab_dc;
                            text: ".DC";
                            text_align: Align.start;
                            horizontal_align: Align.stretch;
                            border_width: 0px;
                            background: #00000000;
                            on_clicked: {
                                selected_tab = 1;
                            }
                        }
                    }

                    Label {
                        text: "Time-domain";
                        font_size: 11px;
                        font_weight: Weight.semibold;
                        foreground: #888888;
                    }

                    if selected_tab == 2 {
                        Button {
                            id: simulation_tab_transient;
                            text: ".TRAN";
                            text_align: Align.start;
                            horizontal_align: Align.stretch;
                            border_width: 0px;
                            background: #2F6FED33;
                            on_clicked: {
                                selected_tab = 2;
                            }
                        }
                    }

                    if selected_tab != 2 {
                        Button {
                            id: simulation_tab_transient;
                            text: ".TRAN";
                            text_align: Align.start;
                            horizontal_align: Align.stretch;
                            border_width: 0px;
                            background: #00000000;
                            on_clicked: {
                                selected_tab = 2;
                            }
                        }
                    }

                    Label {
                        text: "Frequency-domain";
                        font_size: 11px;
                        font_weight: Weight.semibold;
                        foreground: #888888;
                    }

                    if selected_tab == 3 {
                        Button {
                            id: simulation_tab_ac;
                            text: ".AC";
                            text_align: Align.start;
                            horizontal_align: Align.stretch;
                            border_width: 0px;
                            background: #2F6FED33;
                            on_clicked: {
                                selected_tab = 3;
                            }
                        }
                    }

                    if selected_tab != 3 {
                        Button {
                            id: simulation_tab_ac;
                            text: ".AC";
                            text_align: Align.start;
                            horizontal_align: Align.stretch;
                            border_width: 0px;
                            background: #00000000;
                            on_clicked: {
                                selected_tab = 3;
                            }
                        }
                    }

                    if selected_tab == 4 {
                        Button {
                            id: simulation_tab_noise;
                            text: ".NOISE";
                            text_align: Align.start;
                            horizontal_align: Align.stretch;
                            border_width: 0px;
                            background: #2F6FED33;
                            on_clicked: {
                                selected_tab = 4;
                            }
                        }
                    }

                    if selected_tab != 4 {
                        Button {
                            id: simulation_tab_noise;
                            text: ".NOISE";
                            text_align: Align.start;
                            horizontal_align: Align.stretch;
                            border_width: 0px;
                            background: #00000000;
                            on_clicked: {
                                selected_tab = 4;
                            }
                        }
                    }

                    if selected_tab == 5 {
                        Button {
                            id: simulation_tab_hb;
                            text: ".HB";
                            text_align: Align.start;
                            horizontal_align: Align.stretch;
                            border_width: 0px;
                            background: #2F6FED33;
                            on_clicked: {
                                selected_tab = 5;
                            }
                        }
                    }

                    if selected_tab != 5 {
                        Button {
                            id: simulation_tab_hb;
                            text: ".HB";
                            text_align: Align.start;
                            horizontal_align: Align.stretch;
                            border_width: 0px;
                            background: #00000000;
                            on_clicked: {
                                selected_tab = 5;
                            }
                        }
                    }

                    if selected_tab == 6 {
                        Button {
                            id: simulation_tab_lin;
                            text: ".LIN";
                            text_align: Align.start;
                            horizontal_align: Align.stretch;
                            border_width: 0px;
                            background: #2F6FED33;
                            on_clicked: {
                                selected_tab = 6;
                            }
                        }
                    }

                    if selected_tab != 6 {
                        Button {
                            id: simulation_tab_lin;
                            text: ".LIN";
                            text_align: Align.start;
                            horizontal_align: Align.stretch;
                            border_width: 0px;
                            background: #00000000;
                            on_clicked: {
                                selected_tab = 6;
                            }
                        }
                    }

                    // the spacer holds the reference's 130px sidebar width
                    Canvas {
                        width: 130px;
                        height: 1px;
                    }
                }
            }

            Canvas {
                width: 1px;
                height: 420px;
                draw: {
                    fill_rect(0, 0, 1, canvas_height, #00000018);
                }
            }

            ScrollView {
                id: simulation_parameters_page;
                scrollbar: Scrollbar.on;
                horizontal_align: Align.stretch;
                vertical_align: Align.stretch;

                Row {
                    spacing: 0px;

                    Column {
                        spacing: 10px;
                        horizontal_align: Align.stretch;

                        Column {
                            visible: selected_tab == 0;

                            OpParametersPanel {
                                state: op;
                                print: op_print;
                                nonlin_rows: nonlin_rows;
                                on_state_changed: {
                                    op = value;
                                }
                                on_print_changed: {
                                    op_print = value;
                                }
                                on_option_row_edited: {
                                    option_row_edited(package, key, row);
                                }
                                on_option_choice_selected: {
                                    option_choice_selected(package, key, index);
                                }
                            }
                        }

                        Column {
                            visible: selected_tab == 1;

                            DcParametersPanel {
                                state: dc;
                                sweeps: dc_sweeps;
                                sweeps_empty: dc_sweeps_empty;
                                print: dc_print;
                                nonlin_rows: nonlin_rows;
                                pce: pce;
                                pce_print: pce_print;
                                pce_rows: pce_rows;
                                pce_rows_empty: pce_rows_empty;
                                on_state_changed: {
                                    dc = value;
                                }
                                on_print_changed: {
                                    dc_print = value;
                                }
                                on_add_sweep: {
                                    add_sweep();
                                }
                                on_remove_sweep: {
                                    remove_sweep(key);
                                }
                                on_sweep_edited: {
                                    sweep_edited(key, row);
                                }
                                on_option_row_edited: {
                                    option_row_edited(package, key, row);
                                }
                                on_option_choice_selected: {
                                    option_choice_selected(package, key, index);
                                }
                                on_pce_changed: {
                                    pce = value;
                                }
                                on_pce_print_changed: {
                                    pce_print = value;
                                }
                                on_pce_add_row: {
                                    pce_add_row();
                                }
                                on_pce_remove_row: {
                                    pce_remove_row(key);
                                }
                                on_pce_row_edited: {
                                    pce_row_edited(key, row);
                                }
                            }
                        }

                        Column {
                            visible: selected_tab == 2;

                            TransientParametersPanel {
                                state: tran;
                                print: tran_print;
                                timeint_rows: timeint_rows;
                                nonlin_tran_rows: nonlin_tran_rows;
                                loca_rows: loca_rows;
                                fft_rows: fft_rows;
                                output_rows: output_rows;
                                pce: pce;
                                pce_print: pce_print;
                                pce_rows: pce_rows;
                                pce_rows_empty: pce_rows_empty;
                                on_state_changed: {
                                    tran = value;
                                }
                                on_print_changed: {
                                    tran_print = value;
                                }
                                on_pce_changed: {
                                    pce = value;
                                }
                                on_pce_print_changed: {
                                    pce_print = value;
                                }
                                on_pce_add_row: {
                                    pce_add_row();
                                }
                                on_pce_remove_row: {
                                    pce_remove_row(key);
                                }
                                on_pce_row_edited: {
                                    pce_row_edited(key, row);
                                }
                                on_option_row_edited: {
                                    option_row_edited(package, key, row);
                                }
                                on_option_choice_selected: {
                                    option_choice_selected(package, key, index);
                                }
                            }
                        }

                        Column {
                            visible: selected_tab == 3;

                            AcParametersPanel {
                                state: ac;
                                print: ac_print;
                                linsol_ac_rows: linsol_ac_rows;
                                on_state_changed: {
                                    ac = value;
                                }
                                on_print_changed: {
                                    ac_print = value;
                                }
                                on_option_row_edited: {
                                    option_row_edited(package, key, row);
                                }
                                on_option_choice_selected: {
                                    option_choice_selected(package, key, index);
                                }
                            }
                        }

                        Column {
                            visible: selected_tab == 4;

                            NoiseParametersPanel {
                                state: noise;
                                print: noise_print;
                                on_state_changed: {
                                    noise = value;
                                }
                                on_print_changed: {
                                    noise_print = value;
                                }
                            }
                        }

                        Column {
                            visible: selected_tab == 5;

                            HbParametersPanel {
                                state: hb;
                                print: hb_print;
                                on_state_changed: {
                                    hb = value;
                                }
                                on_print_changed: {
                                    hb_print = value;
                                }
                            }
                        }

                        Column {
                            visible: selected_tab == 6;

                            LinParametersPanel {
                                state: lin;
                                print: lin_print;
                                on_state_changed: {
                                    lin = value;
                                }
                                on_print_changed: {
                                    lin_print = value;
                                }
                            }
                        }
                    }

                    // the gutter the page scrollbar rides in, so the bar never covers a card
                    Canvas {
                        width: 12px;
                        height: 1px;
                    }
                }
            }
        }

        // the error row keeps its reachable place in the tree, so the footer never moves when a message appears
        Label {
            font_size: 13px;
            id: simulation_parameters_error;
            text: error_message;
            foreground: #CC0000;
        }

        Row {
            spacing: 8px;
            horizontal_align: Align.end;

            Button {
                id: simulation_parameters_cancel;
                text: "Cancel";
                cancel: true;
                on_clicked: {
                    dismissed();
                }
            }

            Button {
                id: simulation_parameters_ok;
                text: "OK";
                default: true;
                on_clicked: {
                    accepted();
                }
            }
        }
    }
}
