// the native simulation parameters dialog, which edits the analysis directives a run uses

import simulation_ui;

import "ac_parameters_panel.ui";
import "dc_parameters_panel.ui";
import "hb_parameters_panel.ui";
import "lin_parameters_panel.ui";
import "noise_parameters_panel.ui";
import "op_parameters_panel.ui";
import "transient_parameters_panel.ui";

component SimulationParametersDialog {
    // the selected analysis tab, in the order OP, DC, TRAN, AC, NOISE, HB, LIN
    inout property<int> selected_tab: 0;

    // the transient analysis state
    inout property<TranUi> tran;
    inout property<PrintUi> tran_print;

    // the DC sweep state
    inout property<DcUi> dc;
    inout property<PrintUi> dc_print;

    // the AC sweep state
    inout property<AcUi> ac;
    inout property<PrintUi> ac_print;

    // the operating point state
    inout property<OpUi> op;
    inout property<PrintUi> op_print;

    // the noise analysis state
    inout property<NoiseUi> noise;
    inout property<PrintUi> noise_print;

    // the harmonic balance state
    inout property<HbUi> hb;
    inout property<PrintUi> hb_print;

    // the linear analysis state
    inout property<LinUi> lin;
    inout property<PrintUi> lin_print;

    // the PCE state the transient and DC panels share
    inout property<PceUi> pce;
    inout property<PrintUi> pce_print;

    // whether the validation message is part of the layout
    in property<bool> show_error: false;
    // the validation message shown while show_error holds
    in property<string> error_message: "";

    signal accepted();
    signal dismissed();

    Column {
        padding: 16px;
        spacing: 12px;

        Row {
            spacing: 8px;

            Label {
                text: "Xyce Simulation";
                font_weight: Weight.semibold;
                font_size: 18px;
                vertical_align: Align.center;
            }

            Label {
                horizontal_align: Align.stretch;
            }

            Button {
                id: simulation_parameters_close;
                tooltip: "Close";
                icon: @image("../main_window/icons/cancel_16.png");
                icon_size: 12px;
                on_clicked: {
                    dismissed();
                }
            }
        }

        Row {
            spacing: 0px;
            horizontal_align: Align.stretch;

            Panel {
                padding: 12px;
                corner_radius: 0px;
                border_width: 0px;
                vertical_align: Align.start;

                Column {
                    spacing: 4px;

                    Label {
                        text: "DC";
                        font_size: 11px;
                        font_weight: Weight.semibold;
                        foreground: #888888;
                    }

                    if selected_tab == 0 {
                        Button {
                            id: simulation_tab_op;
                            text: ".OP";
                            horizontal_align: Align.stretch;
                            border_width: 0px;
                            background: #2F6FED33;
                            on_clicked: {
                                selected_tab = 0;
                            }
                        }
                    }

                    if selected_tab != 0 {
                        Button {
                            id: simulation_tab_op;
                            text: ".OP";
                            horizontal_align: Align.stretch;
                            border_width: 0px;
                            background: #00000000;
                            on_clicked: {
                                selected_tab = 0;
                            }
                        }
                    }

                    if selected_tab == 1 {
                        Button {
                            id: simulation_tab_dc;
                            text: ".DC";
                            horizontal_align: Align.stretch;
                            border_width: 0px;
                            background: #2F6FED33;
                            on_clicked: {
                                selected_tab = 1;
                            }
                        }
                    }

                    if selected_tab != 1 {
                        Button {
                            id: simulation_tab_dc;
                            text: ".DC";
                            horizontal_align: Align.stretch;
                            border_width: 0px;
                            background: #00000000;
                            on_clicked: {
                                selected_tab = 1;
                            }
                        }
                    }

                    Label {
                        text: "Time-domain";
                        font_size: 11px;
                        font_weight: Weight.semibold;
                        foreground: #888888;
                    }

                    if selected_tab == 2 {
                        Button {
                            id: simulation_tab_transient;
                            text: ".TRAN";
                            horizontal_align: Align.stretch;
                            border_width: 0px;
                            background: #2F6FED33;
                            on_clicked: {
                                selected_tab = 2;
                            }
                        }
                    }

                    if selected_tab != 2 {
                        Button {
                            id: simulation_tab_transient;
                            text: ".TRAN";
                            horizontal_align: Align.stretch;
                            border_width: 0px;
                            background: #00000000;
                            on_clicked: {
                                selected_tab = 2;
                            }
                        }
                    }

                    Label {
                        text: "Frequency-domain";
                        font_size: 11px;
                        font_weight: Weight.semibold;
                        foreground: #888888;
                    }

                    if selected_tab == 3 {
                        Button {
                            id: simulation_tab_ac;
                            text: ".AC";
                            horizontal_align: Align.stretch;
                            border_width: 0px;
                            background: #2F6FED33;
                            on_clicked: {
                                selected_tab = 3;
                            }
                        }
                    }

                    if selected_tab != 3 {
                        Button {
                            id: simulation_tab_ac;
                            text: ".AC";
                            horizontal_align: Align.stretch;
                            border_width: 0px;
                            background: #00000000;
                            on_clicked: {
                                selected_tab = 3;
                            }
                        }
                    }

                    if selected_tab == 4 {
                        Button {
                            id: simulation_tab_noise;
                            text: ".NOISE";
                            horizontal_align: Align.stretch;
                            border_width: 0px;
                            background: #2F6FED33;
                            on_clicked: {
                                selected_tab = 4;
                            }
                        }
                    }

                    if selected_tab != 4 {
                        Button {
                            id: simulation_tab_noise;
                            text: ".NOISE";
                            horizontal_align: Align.stretch;
                            border_width: 0px;
                            background: #00000000;
                            on_clicked: {
                                selected_tab = 4;
                            }
                        }
                    }

                    if selected_tab == 5 {
                        Button {
                            id: simulation_tab_hb;
                            text: ".HB";
                            horizontal_align: Align.stretch;
                            border_width: 0px;
                            background: #2F6FED33;
                            on_clicked: {
                                selected_tab = 5;
                            }
                        }
                    }

                    if selected_tab != 5 {
                        Button {
                            id: simulation_tab_hb;
                            text: ".HB";
                            horizontal_align: Align.stretch;
                            border_width: 0px;
                            background: #00000000;
                            on_clicked: {
                                selected_tab = 5;
                            }
                        }
                    }

                    if selected_tab == 6 {
                        Button {
                            id: simulation_tab_lin;
                            text: ".LIN";
                            horizontal_align: Align.stretch;
                            border_width: 0px;
                            background: #2F6FED33;
                            on_clicked: {
                                selected_tab = 6;
                            }
                        }
                    }

                    if selected_tab != 6 {
                        Button {
                            id: simulation_tab_lin;
                            text: ".LIN";
                            horizontal_align: Align.stretch;
                            border_width: 0px;
                            background: #00000000;
                            on_clicked: {
                                selected_tab = 6;
                            }
                        }
                    }
                }
            }

            Canvas {
                width: 1px;
                height: 420px;
                draw: {
                    fill_rect(0, 0, 1, canvas_height, #00000018);
                }
            }

            ScrollView {
                viewport_width: 620px;
                viewport_height: 420px;
                scrollbar: Scrollbar.on;
                horizontal_align: Align.stretch;

                Column {
                    spacing: 10px;

                    Column {
                        visible: selected_tab == 0;

                        OpParametersPanel {
                        state: op;
                        print: op_print;
                        on_state_changed: {
                            op = value;
                        }
                        on_print_changed: {
                            op_print = value;
                        }
                        }
                    }

                    Column {
                        visible: selected_tab == 1;

                        DcParametersPanel {
                        state: dc;
                        print: dc_print;
                        pce: pce;
                        pce_print: pce_print;
                        on_state_changed: {
                            dc = value;
                        }
                        on_print_changed: {
                            dc_print = value;
                        }
                        on_pce_changed: {
                            pce = value;
                        }
                        on_pce_print_changed: {
                            pce_print = value;
                        }
                        }
                    }

                    Column {
                        visible: selected_tab == 2;

                        TransientParametersPanel {
                        state: tran;
                        print: tran_print;
                        pce: pce;
                        pce_print: pce_print;
                        on_state_changed: {
                            tran = value;
                        }
                        on_print_changed: {
                            tran_print = value;
                        }
                        on_pce_changed: {
                            pce = value;
                        }
                        on_pce_print_changed: {
                            pce_print = value;
                        }
                        }
                    }

                    Column {
                        visible: selected_tab == 3;

                        AcParametersPanel {
                        state: ac;
                        print: ac_print;
                        on_state_changed: {
                            ac = value;
                        }
                        on_print_changed: {
                            ac_print = value;
                        }
                        }
                    }

                    Column {
                        visible: selected_tab == 4;

                        NoiseParametersPanel {
                        state: noise;
                        print: noise_print;
                        on_state_changed: {
                            noise = value;
                        }
                        on_print_changed: {
                            noise_print = value;
                        }
                        }
                    }

                    Column {
                        visible: selected_tab == 5;

                        HbParametersPanel {
                        state: hb;
                        print: hb_print;
                        on_state_changed: {
                            hb = value;
                        }
                        on_print_changed: {
                            hb_print = value;
                        }
                        }
                    }

                    Column {
                        visible: selected_tab == 6;

                        LinParametersPanel {
                        state: lin;
                        print: lin_print;
                        on_state_changed: {
                            lin = value;
                        }
                        on_print_changed: {
                            lin_print = value;
                        }
                        }
                    }
                }
            }
        }

        // the error row keeps its place in the tree, so showing it never rebuilds a control
        Label {
            id: simulation_parameters_error;
            visible: show_error;
            text: error_message;
            foreground: #CC0000;
        }

        Row {
            spacing: 8px;
            horizontal_align: Align.end;

            Button {
                id: simulation_parameters_cancel;
                text: "Cancel";
                cancel: true;
                on_clicked: {
                    dismissed();
                }
            }

            Button {
                id: simulation_parameters_ok;
                text: "OK";
                default: true;
                on_clicked: {
                    accepted();
                }
            }
        }
    }
}
