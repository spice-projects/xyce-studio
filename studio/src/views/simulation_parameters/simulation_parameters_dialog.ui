// the native simulation parameters dialog, which edits the analysis directives a run uses

import simulation_ui;

import "ac_parameters_panel.ui";
import "dc_parameters_panel.ui";
import "hb_parameters_panel.ui";
import "lin_parameters_panel.ui";
import "noise_parameters_panel.ui";
import "op_parameters_panel.ui";
import "transient_parameters_panel.ui";

component SimulationParametersDialog {
    // the selected analysis tab, in the order OP, DC, TRAN, AC, NOISE, HB, LIN
    inout property<int> selected_tab: 0;

    // the transient analysis state
    inout property<TranUi> tran;
    inout property<PrintUi> tran_print;

    // the DC sweep state
    inout property<DcUi> dc;
    inout property<PrintUi> dc_print;

    // the AC sweep state
    inout property<AcUi> ac;
    inout property<PrintUi> ac_print;

    // the operating point state
    inout property<OpUi> op;
    inout property<PrintUi> op_print;

    // the noise analysis state
    inout property<NoiseUi> noise;
    inout property<PrintUi> noise_print;

    // the harmonic balance state
    inout property<HbUi> hb;
    inout property<PrintUi> hb_print;

    // the linear analysis state
    inout property<LinUi> lin;
    inout property<PrintUi> lin_print;

    // the PCE state the transient and DC panels share
    inout property<PceUi> pce;
    inout property<PrintUi> pce_print;

    // whether the validation message is part of the layout
    in property<bool> show_error: false;
    // the validation message shown while show_error holds
    in property<string> error_message: "";

    signal accepted();
    signal dismissed();

    Column {
        padding: 16px;
        spacing: 12px;

        Row {
            spacing: 8px;

            Label {
                text: "Xyce Simulation";
                font_size: 16px;
                vertical_align: Align.center;
            }

            Label {
                horizontal_align: Align.stretch;
            }

            Button {
                id: simulation_parameters_close;
                text: "X";
                on_clicked: {
                    dismissed();
                }
            }
        }

        TabView {
            id: simulation_parameters_tabs;
            selected: selected_tab;
            vertical: true;
            vertical_align: Align.start;
            horizontal_align: Align.stretch;
            on_selection_changed: {
                selected_tab = index;
            }

            Tab {
                id: simulation_tab_op;
                label: ".OP";

                ScrollView {
                    viewport_height: 420px;
                    scrollbar: Scrollbar.on;
                    horizontal_align: Align.stretch;

                    OpParametersPanel {
                        state: op;
                        print: op_print;
                        on_state_changed: {
                            op = value;
                        }
                        on_print_changed: {
                            op_print = value;
                        }
                    }
                }
            }

            Tab {
                id: simulation_tab_dc;
                label: ".DC";

                ScrollView {
                    viewport_height: 420px;
                    scrollbar: Scrollbar.on;
                    horizontal_align: Align.stretch;

                    DcParametersPanel {
                        state: dc;
                        print: dc_print;
                        pce: pce;
                        pce_print: pce_print;
                        on_state_changed: {
                            dc = value;
                        }
                        on_print_changed: {
                            dc_print = value;
                        }
                        on_pce_changed: {
                            pce = value;
                        }
                        on_pce_print_changed: {
                            pce_print = value;
                        }
                    }
                }
            }

            Tab {
                id: simulation_tab_transient;
                label: ".TRAN";

                ScrollView {
                    viewport_height: 420px;
                    scrollbar: Scrollbar.on;
                    horizontal_align: Align.stretch;

                    TransientParametersPanel {
                        state: tran;
                        print: tran_print;
                        pce: pce;
                        pce_print: pce_print;
                        on_state_changed: {
                            tran = value;
                        }
                        on_print_changed: {
                            tran_print = value;
                        }
                        on_pce_changed: {
                            pce = value;
                        }
                        on_pce_print_changed: {
                            pce_print = value;
                        }
                    }
                }
            }

            Tab {
                id: simulation_tab_ac;
                label: ".AC";

                ScrollView {
                    viewport_height: 420px;
                    scrollbar: Scrollbar.on;
                    horizontal_align: Align.stretch;

                    AcParametersPanel {
                        state: ac;
                        print: ac_print;
                        on_state_changed: {
                            ac = value;
                        }
                        on_print_changed: {
                            ac_print = value;
                        }
                    }
                }
            }

            Tab {
                id: simulation_tab_noise;
                label: ".NOISE";

                ScrollView {
                    viewport_height: 420px;
                    scrollbar: Scrollbar.on;
                    horizontal_align: Align.stretch;

                    NoiseParametersPanel {
                        state: noise;
                        print: noise_print;
                        on_state_changed: {
                            noise = value;
                        }
                        on_print_changed: {
                            noise_print = value;
                        }
                    }
                }
            }

            Tab {
                id: simulation_tab_hb;
                label: ".HB";

                ScrollView {
                    viewport_height: 420px;
                    scrollbar: Scrollbar.on;
                    horizontal_align: Align.stretch;

                    HbParametersPanel {
                        state: hb;
                        print: hb_print;
                        on_state_changed: {
                            hb = value;
                        }
                        on_print_changed: {
                            hb_print = value;
                        }
                    }
                }
            }

            Tab {
                id: simulation_tab_lin;
                label: ".LIN";

                ScrollView {
                    viewport_height: 420px;
                    scrollbar: Scrollbar.on;
                    horizontal_align: Align.stretch;

                    LinParametersPanel {
                        state: lin;
                        print: lin_print;
                        on_state_changed: {
                            lin = value;
                        }
                        on_print_changed: {
                            lin_print = value;
                        }
                    }
                }
            }
        }

        // the error row keeps its place in the tree, so showing it never rebuilds a control
        Label {
            id: simulation_parameters_error;
            visible: show_error;
            text: error_message;
            foreground: #CC0000;
        }

        Row {
            spacing: 8px;
            horizontal_align: Align.end;

            Button {
                id: simulation_parameters_cancel;
                text: "Cancel";
                cancel: true;
                on_clicked: {
                    dismissed();
                }
            }

            Button {
                id: simulation_parameters_ok;
                text: "OK";
                default: true;
                on_clicked: {
                    accepted();
                }
            }
        }
    }
}
