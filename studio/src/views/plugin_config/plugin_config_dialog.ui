// the plugin configuration dialog, seeded with the current Xyce path
component PluginConfigDialog {
    // the path the user is editing, fed back to the host on accept
    inout property<string> path: "";
    // whether the validation message is part of the layout
    in property<bool> show_error: false;
    // the validation message shown while show_error holds
    in property<string> error_message: "";

    signal browse_clicked();
    signal accepted();
    signal dismissed();

    // the column is the dialog body, which lets the footer stretch spacer pin
    // the actions to the bottom edge of the fixed size window
    Column {
        padding: 16px;
        spacing: 12px;

        Row {
            spacing: 10px;
            horizontal_align: Align.stretch;

            // the placeholder names the field because a caption label would take the initial focus (albor issue #176)
            TextField {
                id: plugin_config_path;
                value: path;
                placeholder: "Xyce executable path";
                horizontal_align: Align.stretch;
                on_changed: {
                    path = value;
                }
            }

            Button {
                id: plugin_config_browse;
                text: "Browse...";
                on_clicked: {
                    browse_clicked();
                }
            }
        }

        // the error row keeps its place in the tree, so showing it never rebuilds a control
        Label {
            id: plugin_config_error;
            visible: show_error;
            text: error_message;
            foreground: #CC0000;
        }

        // pushes the footer to the bottom of the fixed size dialog
        Label {
            vertical_align: Align.stretch;
        }

        Row {
            spacing: 8px;
            horizontal_align: Align.end;

            Button {
                id: plugin_config_cancel;
                text: "Cancel";
                cancel: true;
                on_clicked: {
                    dismissed();
                }
            }

            Button {
                id: plugin_config_ok;
                text: "OK";
                default: true;
                on_clicked: {
                    accepted();
                }
            }
        }
    }
}
