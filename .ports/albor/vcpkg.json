{
  "name": "albor",
  "version-semver": "0.3.0",
  "port-version": 1,
  "description": "Cross-platform declarative UI framework for C++",
  "homepage": "https://github.com/AlborCore/albor",
  "license": "Apache-2.0",
  "supports": "((osx | windows | linux) & !mingw & !uwp)",
  "dependencies": [
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    },
    {
      "name": "harfbuzz",
      "platform": "osx",
      "default-features": false,
      "features": [
        "freetype",
        "icu",
        "coretext"
      ]
    },
    {
      "name": "harfbuzz",
      "platform": "windows",
      "default-features": false,
      "features": [
        "freetype",
        "icu",
        "directwrite",
        "gdi"
      ]
    },
    {
      "name": "harfbuzz",
      "platform": "linux",
      "default-features": false,
      "features": [
        "freetype",
        "icu"
      ]
    },
    {
      "name": "blend2d",
      "version>=": "2025-03-08#1",
      "platform": "linux",
      "default-features": false,
      "features": [
        "jit"
      ]
    },
    {
      "name": "vulkan-headers",
      "platform": "linux",
      "default-features": false
    },
    {
      "name": "vulkan-loader",
      "platform": "linux",
      "default-features": false,
      "features": [
        "wayland",
        "xcb"
      ]
    },
    {
      "name": "bzip2",
      "default-features": false
    },
    {
      "name": "icu",
      "default-features": false
    },
    {
      "name": "libpng",
      "default-features": false
    },
    {
      "name": "zlib",
      "version>=": "1.3.2",
      "default-features": false
    }
  ],
  "features": {
    "blend2d": {
      "description": "The portable Blend2D CPU renderer with the albor-blend2d umbrella",
      "dependencies": [
        {
          "name": "blend2d",
          "version>=": "2025-03-08#1",
          "platform": "!linux",
          "default-features": false,
          "features": [
            "jit"
          ]
        }
      ]
    }
  }
}
