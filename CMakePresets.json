{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 28,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/.build-${presetName}",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_C_COMPILER_LAUNCHER": "ccache",
                "CMAKE_CXX_COMPILER_LAUNCHER": "ccache"
            }
        },
        {
            "name": "debug",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "XYCE_BUILD_STUDIO_FRONTEND": "OFF"
            }
        },
        {
            "name": "release",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "XYCE_BUILD_STUDIO_FRONTEND": "OFF"
            }
        },
        {
            "name": "coverage",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "XYCE_COVERAGE": "ON",
                "XYCE_BUILD_STUDIO_FRONTEND": "OFF"
            }
        },
        {
            "name": "asan",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "XYCE_ASAN": "ON",
                "XYCE_BUILD_STUDIO_FRONTEND": "OFF"
            }
        },
        {
            "name": "studio-debug",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "XYCE_BUILD_SLINT_FRONTEND": "OFF",
                "XYCE_BUILD_STUDIO_FRONTEND": "ON",
                "XYCE_BUILD_TESTS": "OFF",
                "XYCE_BUILD_STUDIO_TESTS": "ON",
                "ALBOR_LOCAL_SOURCE_DIR": "${sourceDir}/../albor"
            }
        },
        {
            "name": "studio-release",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "VCPKG_MANIFEST_FEATURES": "albor-package",
                "XYCE_BUILD_SLINT_FRONTEND": "OFF",
                "XYCE_BUILD_STUDIO_FRONTEND": "ON",
                "XYCE_BUILD_TESTS": "OFF",
                "XYCE_BUILD_STUDIO_TESTS": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "description": "",
            "displayName": "",
            "configurePreset": "debug",
            "targets": [
                "xyce-studio",
                "xyce-studio-tests"
            ],
            "configuration": "Debug",
            "inheritConfigureEnvironment": true,
            "environment": {
                "SLINT_LIVE_PREVIEW": "1",
                "SLINT_EMIT_DEBUG_INFO": "1"
            }
        },
        {
            "name": "release",
            "description": "",
            "displayName": "",
            "configurePreset": "release",
            "targets": [
                "xyce-studio",
                "xyce-studio-tests"
            ],
            "configuration": "Release",
            "inheritConfigureEnvironment": true
        },
        {
            "name": "coverage",
            "description": "",
            "displayName": "",
            "configurePreset": "coverage",
            "targets": [
                "xyce-studio",
                "xyce-studio-tests"
            ],
            "configuration": "Debug",
            "inheritConfigureEnvironment": true
        },
        {
            "name": "asan",
            "description": "",
            "displayName": "",
            "configurePreset": "asan",
            "targets": [
                "xyce-studio-tests"
            ],
            "configuration": "Debug",
            "inheritConfigureEnvironment": true
        },
        {
            "name": "studio-debug",
            "description": "",
            "displayName": "",
            "configurePreset": "studio-debug",
            "targets": [
                "xyce-studio-next",
                "studio-tests"
            ],
            "configuration": "Debug",
            "inheritConfigureEnvironment": true
        },
        {
            "name": "studio-release",
            "description": "",
            "displayName": "",
            "configurePreset": "studio-release",
            "targets": [
                "xyce-studio-next"
            ],
            "configuration": "Release",
            "inheritConfigureEnvironment": true
        }
    ]
}
