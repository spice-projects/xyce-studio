{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 28,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/.build-${presetName}",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_C_COMPILER_LAUNCHER": "ccache",
                "CMAKE_CXX_COMPILER_LAUNCHER": "ccache"
            }
        },
        {
            "name": "debug",
            "description": "Local development against the sibling Albor checkout",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "ALBOR_LOCAL_SOURCE_DIR": "${sourceDir}/../albor"
            }
        },
        {
            "name": "release",
            "description": "Clean-checkout release build using the vendored Albor port",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "VCPKG_MANIFEST_FEATURES": "albor-package",
                "XYCE_BUILD_TESTS": "ON",
                "XYCE_BUILD_STUDIO_TESTS": "OFF"
            }
        },
        {
            "name": "coverage",
            "description": "CI coverage build using the vendored Albor port",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "XYCE_COVERAGE": "ON",
                "VCPKG_MANIFEST_FEATURES": "albor-package"
            }
        },
        {
            "name": "asan",
            "description": "CI AddressSanitizer build using the vendored Albor port",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "XYCE_ASAN": "ON",
                "VCPKG_MANIFEST_FEATURES": "albor-package"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug",
            "targets": [
                "xyce-studio",
                "xyce-studio-tests",
                "studio-tests"
            ],
            "configuration": "Debug",
            "inheritConfigureEnvironment": true
        },
        {
            "name": "release",
            "configurePreset": "release",
            "targets": [
                "xyce-studio",
                "xyce-studio-tests"
            ],
            "configuration": "Release",
            "inheritConfigureEnvironment": true
        },
        {
            "name": "coverage",
            "configurePreset": "coverage",
            "targets": [
                "xyce-studio-tests",
                "studio-tests"
            ],
            "configuration": "Debug",
            "inheritConfigureEnvironment": true
        },
        {
            "name": "asan",
            "configurePreset": "asan",
            "targets": [
                "xyce-studio-tests",
                "studio-tests"
            ],
            "configuration": "Debug",
            "inheritConfigureEnvironment": true
        }
    ]
}
